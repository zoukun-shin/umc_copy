<mvc:View
    controllerName="mm.masspostofscrap.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:unified="sap.ui.unified"
    xmlns:upload="sap.m.upload"
    xmlns:table="sap.ui.table"
>
    <Page>
        <content>
            <Panel
                expandable="true"
                expanded="false"
                headerText="{i18n>templateText}"
                width="auto"
            >
                <upload:UploadSet
                    id="idTemplateCollection"
                    items="{ path : 'Attach>/Configuration', filters : { path : 'Object', operator : 'EQ', value1 : 'ZUPLOAD_MPOS' } }"
                    multiple="true"
                    uploadEnabled="false"
                    uploadButtonInvisible="true"
                    instantUpload="false"
                >
                    <upload:items>
                        <upload:UploadSetItem
                            fileName="{Attach>TemplateName}"
                            mediaType="{Attach>TemplateMimeType}"
                            url="{Attach>TemplateContent}"
                            visibleEdit="false"
                            visibleRemove="false"
                        />
                    </upload:items>
                </upload:UploadSet>
            </Panel>
            <Panel
                id="idFileUploadPanel"
                expandable="true"
                expanded="true"
                headerText="{i18n>uploadText}"
                width="auto"
            >
                <unified:FileUploader
                    id="idFileUploader"
                    sameFilenameAllowed="true"
                    fileType="xlsx,xls"
                    change="onFileUploaderChange"
                    width="40%"
                    class="sapUiSmallMargin"
                />
            </Panel>
            <Panel
                expandable="true"
                expanded="true"
                headerText="{i18n>result}"
                width="auto"
            >
                <table:Table
                    id="uploadTable"
                    rows="{local>/excelSet}"
                    selectionMode="Multi"
                    rowMode="Interactive"
                    class="sapUiSizeCompact"
                >
                    <table:extension>
                        <OverflowToolbar>
                            <Text text="{local>/logInfo}" />
                            <ToolbarSpacer />
                            <Button
                                id="idCheckButton"
                                icon="sap-icon://check-availability"
                                type="Transparent"
                                text="{i18n>checkBtn}"
                                press="onCheck"
                                visible="{= ${local>/excelSet}.length > 0}"
                                enabled="{= ${local>/authorityCheck/button/Check}}"
                            />
                            <Button
                                id="idExcuteButton"
                                icon="sap-icon://document"
                                type="Transparent"
                                text="{i18n>excuteBtn}"
                                press="onExcute"
                                visible="{= ${local>/excelSet}.length > 0}"
                                enabled="{= ${local>/authorityCheck/button/Excute} &amp;&amp; ${local>/recordCheckSuccessed}}"
                            />
                            <Button
                                id="idExportButton"
                                icon="sap-icon://excel-attachment"
                                type="Transparent"
                                text="{i18n>exportBtn}"
                                press="onExport"
                                visible="{= ${local>/excelSet}.length > 0}"
                                enabled="{= ${local>/authorityCheck/button/Export}}"
                            />
                        </OverflowToolbar>
                    </table:extension>
                    <table:columns>
                        <table:Column
                            autoResizable="true"
                            width="6rem"
                            label="{i18n>Status}"
                        >
                            <table:template>
                                <ObjectStatus
                                    state="{ path:'local>Type',formatter:'.formatter.setState' }"
                                    icon="{ path:'local>Type', formatter:'.formatter.setStateIcon'}"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="16rem"
                            label="{i18n>Message}"
                        >
                            <table:template>
                                <Text
                                    text="{local>Message}"
                                    tooltip="{local>Message}"
                                    wrapping="false"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="6rem"
                            label="{i18n>Plant}"
                        >
                            <table:template>
                                <Text
                                    text="{local>Plant}"
                                    wrapping="false"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="10rem"
                            label="{i18n>MovementType}"
                        >
                            <table:template>
                                <Text
                                    text="{local>MovementType}"
                                    wrapping="false"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="15rem"
                            label="{i18n>Material}"
                        >
                            <table:template>
                                <Text
                                    text="{local>Material}"
                                    tooltip="{local>Material}"
                                    wrapping="false"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="8rem"
                            label="{i18n>ScrapQuantity}"
                        >
                            <table:template>
                                <Text
                                    text="{local>ScrapQuantity}"
                                    wrapping="false"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="8rem"
                            label="{i18n>Unit}"
                        >
                            <table:template>
                                <Text
                                    text="{local>Unit}"
                                    wrapping="false"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="8rem"
                            label="{i18n>StorageLocation}"
                        >
                            <table:template>
                                <Text
                                    text="{local>StorageLocation}"
                                    wrapping="false"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="8rem"
                            label="{i18n>GLAccount}"
                        >
                            <table:template>
                                <Text
                                    text="{local>GLAccount}"
                                    wrapping="false"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="12rem"
                            label="{i18n>HeaderText}"
                        >
                            <table:template>
                                <Text
                                    text="{local>HeaderText}"
                                    tooltip="{local>HeaderText}"
                                    wrapping="false"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="8rem"
                            label="{i18n>Reason}"
                        >
                            <table:template>
                                <Text
                                    text="{local>Reason}"
                                    wrapping="false"
                                />
                            </table:template>
                        </table:Column>
                    </table:columns>
                </table:Table>
            </Panel>
        </content>
    </Page>
</mvc:View>
