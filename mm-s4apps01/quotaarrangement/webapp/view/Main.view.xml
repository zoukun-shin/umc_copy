<mvc:View controllerName="mm.quotaarrangement.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:unified="sap.ui.unified"
    xmlns:upload="sap.m.upload"
    xmlns:table="sap.ui.table"
    xmlns:rm="sap.ui.table.rowmodes"
>
    <VBox fitContainer="true">
            <Panel
                expandable="true"
                expanded="false"
                headerText="{i18n>templateText}"
                width="auto"
            >
                <upload:UploadSet
                    id="idTemplateCollection"
                    items="{ path : 'Attach>/Configuration' }"
                    multiple="true"
                    uploadEnabled="false"
                    uploadButtonInvisible="true"
                    instantUpload="false"
                >
                    <upload:items>
                        <upload:UploadSetItem
                            fileName="{Attach>TemplateName}"
                            mediaType="{Attach>TemplateMimeType}"
                            url="{Attach>TemplateContent}"
                            visibleEdit="false"
                            visibleRemove="false"
                        />
                    </upload:items>
                </upload:UploadSet>
            </Panel>
            <Panel
                id="idFileUploadPanel"
                expandable="true"
                expanded="true"
                headerText="{i18n>uploadText}"
                width="auto"
            >
                <unified:FileUploader
                    id="idFileUploader"
                    sameFilenameAllowed="true"
                    fileType="xlsx,xls"
                    change="onFileUploaderChange"
                    width="40%"
                    class="sapUiSmallMargin"
                    enabled="{= ${local>/authorityCheck/button/Upload}}"
                />
            </Panel>
            <Panel
                expandable="true"
                expanded="true"
                headerText="{i18n>result}"
                width="auto"
                height="100%"
            >
                <layoutData>
                    <FlexItemData
                        id="idFlexItemData"
                        maxHeight="100%"
                        maxWidth="100%"
                        growFactor="1"
                    />
                </layoutData>
                <table:Table
                    id="uploadTable"
                    rows="{local>/excelSet}"
                    selectionMode="Multi"
                    class="sapUiSizeCompact"
                >
                     <table:rowMode>
                        <rm:Auto id="idAuto" />
                    </table:rowMode>
                    <table:extension>
                        <OverflowToolbar>
                            <Text text="{local>/logInfo}" />
                            <ToolbarSpacer />
                            <Button
                                id="idCheckButton"
                                icon="sap-icon://check-availability"
                                type="Transparent"
                                text="{i18n>checkBtn}"
                                press="onCheck"
                                visible="{= ${local>/excelSet}.length > 0}"
                                enabled="{= ${local>/authorityCheck/button/Check}}"
                            />
                            <Button
                                id="idExcuteButton"
                                icon="sap-icon://document"
                                type="Transparent"
                                text="{i18n>excuteBtn}"
                                press="onExcute"
                                visible="{= ${local>/excelSet}.length > 0}"
                                enabled="{= ${local>/authorityCheck/button/Execute} &amp;&amp; ${local>/recordCheckSuccessed}}"
                            />
                            <Button
                                id="idExportButton"
                                icon="sap-icon://excel-attachment"
                                type="Transparent"
                                text="{i18n>exportBtn}"
                                press="onExport"
                                visible="{= ${local>/excelSet}.length > 0}"
                                enabled="{= ${local>/authorityCheck/button/Export}}"
                            />
                        </OverflowToolbar>
                    </table:extension>
                    <table:columns>
                        <table:Column
                            autoResizable="true"
                            width="6rem"
                            label="{i18n>Status}"
                        >
                            <table:template>
                                <ObjectStatus
                                    state="{ path:'local>Type',formatter:'.formatter.setState' }"
                                    icon="{ path:'local>Type', formatter:'.formatter.setStateIcon'}"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="16rem"
                            label="{i18n>Message}"
                        >
                            <table:template>
                                <Text
                                    text="{local>Message}"
                                    tooltip="{local>Message}"
                                    wrapping="false"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="6rem"
                            label="{i18n>Usage}"
                        >
                            <table:template>
                                <Text
                                    text="{local>Usage}"
                                    wrapping="false"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="10rem"
                            label="{i18n>Material}"
                        >
                            <table:template>
                                <Text
                                    text="{local>Material}"
                                    wrapping="false"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="15rem"
                            label="{i18n>Plant}"
                        >
                            <table:template>
                                <Text
                                    text="{local>Plant}"
                                    tooltip="{local>Plant}"
                                    wrapping="false"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="8rem"
                            label="{i18n>QuotaArrangement}"
                        >
                            <table:template>
                                <Text
                                    text="{local>QuotaArrangement}"
                                    wrapping="false"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="8rem"
                            label="{i18n>ValidityStartDate}"
                        >
                            <table:template>
                                <Text
                                    text="{path:'local>ValidityStartDate', type:'sap.ui.model.type.Date'}"
                                    wrapping="false"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="8rem"
                            label="{i18n>ValidityEndDate}"
                        >
                            <table:template>
                                <Text
                                    text="{path:'local>ValidityEndDate', type:'sap.ui.model.type.Date'}"
                                    wrapping="false"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="10rem"
                            label="{i18n>QuotaArrangementItem}"
                        >
                            <table:template>
                                <Text
                                    text="{local>QuotaArrangementItem}"
                                    tooltip="{local>QuotaArrangementItem}"
                                    wrapping="false"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="8rem"
                            label="{i18n>MaterialProcurementCategory}"
                        >
                            <table:template>
                                <Text
                                    text="{local>MaterialProcurementCategory}"
                                    wrapping="false"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="8rem"
                            label="{i18n>MaterialProcurementType}"
                        >
                            <table:template>
                                <Text
                                    text="{local>MaterialProcurementType}"
                                    wrapping="false"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="8rem"
                            label="{i18n>Supplier}"
                        >
                            <table:template>
                                <Text
                                    text="{local>Supplier}"
                                    wrapping="false"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="8rem"
                            label="{i18n>PurchasingSourceQuota}"
                        >
                            <table:template>
                                <Text
                                    text="{local>PurchasingSourceQuota}"
                                    wrapping="false"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="10rem"
                            label="{i18n>ManufacturerMaterial}"
                        >
                            <table:template>
                                <Text
                                    text="{local>ManufacturerMaterial}"
                                    wrapping="false"
                                />
                            </table:template>
                        </table:Column>
                    </table:columns>
                </table:Table>
            </Panel>
    </VBox>
</mvc:View>

