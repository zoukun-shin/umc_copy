        "type": "ODataAnnotation",
        "settings": {
          "localUri": "localService/mainService/ZUI_PURGQUOTAARRGMT_O2_VAN.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata/sap/ZUI_PURGQUOTAARRGMT_O2/",
        "type": "OData",
        "settings": {
          "annotations": [
            "ZUI_PURGQUOTAARRGMT_O2_VAN"
