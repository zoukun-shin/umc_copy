          ]
        }
      ],
      "targets": {
        "TargetMain": {
          "id": "Main",
          "name": "Main"
        }
      }
    },
    "rootView": {
      "viewName": "mm.quotaarrangement.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "mm-s4apps01"
  },
  "sap.platform.cf": {
      "ui5VersionNumber": "1.120.38"
  }
  
