                            </t:template>
                         </t:Column>
                         <t:Column id="colProcurementType" width="8rem">
                            <t:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey": "ProcurementType", "leadingProperty": "ProcurementType", "sortProperty": "ProcurementType", "filterProperty": "ProcurementType", "columnIndex": "9"\}'/>
                            </t:customData>
                            <Label id="labelProcurementType" labelFor="textProcurementType" text="{i18n>ProcurementType}"></Label>
                            <t:template>
                                <Text id="textProcurementType" text="{ProcurementType}"></Text>
                            </t:template>
                         </t:Column>
                         <t:Column id="colMatlWrhsStkQtyInMatlBaseUnit" width="8rem">
                            <t:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey": "MatlWrhsStkQtyInMatlBaseUnit", "leadingProperty": "MatlWrhsStkQtyInMatlBaseUnit", "sortProperty": "MatlWrhsStkQtyInMatlBaseUnit", "filterProperty": "MatlWrhsStkQtyInMatlBaseUnit", "columnIndex": "10"\}'/>
                            </t:customData>
                            <Label id="labelMatlWrhsStkQtyInMatlBaseUnit" labelFor="textMatlWrhsStkQtyInMatlBaseUnit" text="{i18n>MatlWrhsStkQtyInMatlBaseUnit}"></Label>
                            <t:template>
                                <Text id="textMatlWrhsStkQtyInMatlBaseUnit" text="{path: 'MatlWrhsStkQtyInMatlBaseUnit', type: 'sap.ui.model.odata.type.Decimal', constraints: {precision: 13, scale: 3}}"></Text>                            </t:template>
                         </t:Column>
                         <t:Column id="colMaterialBaseUnit" width="8rem">
                            <t:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey": "MaterialBaseUnit", "leadingProperty": "MaterialBaseUnit", "sortProperty": "MaterialBaseUnit", "filterProperty": "MaterialBaseUnit", "columnIndex": "11"\}'/>
                            </t:customData>
                            <Label id="labelMaterialBaseUnit" labelFor="textMaterialBaseUnit" text="{i18n>MaterialBaseUnit}"></Label>
                            <t:template>
