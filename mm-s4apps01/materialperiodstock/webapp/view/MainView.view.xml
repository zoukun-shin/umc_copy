<mvc:View controllerName="mm.materialperiodstock.controller.MainView" displayBlock="true"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:unified="sap.ui.unified"
    xmlns:t="sap.ui.table"
    xmlns:rm="sap.ui.table.rowmodes"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:sv="sap.ui.comp.smartvariants" height="100%" busyIndicatorDelay="0">
    <f:DynamicPage id="idDynamicPage" fitContent="true" class="sapUiNoContentPadding">
        <f:title>
            <f:DynamicPageTitle id="idDynamicPageTitle">
                <f:heading>
                    <sv:SmartVariantManagement id="idSmartVariantManagement" showShare="true" persistencyKey="pkMaterialPeriodStock" showExecuteOnSelection="true" entitySet="ZC_MATERIALPERIODSTOCK" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader id="idDynamicPageHeader">
                <f:content>
                    <!--数据查询-->
                    <smartFilterBar:SmartFilterBar id="idSmartFilterBar" smartVariant="idSmartVariantManagement" persistencyKey="pkCustMatPL" entitySet="ZC_MATERIALPERIODSTOCK" useToolbar="false">
                        <smartFilterBar:controlConfiguration>
                            <smartFilterBar:ControlConfiguration id="sfPlant" index="1" key="Plant" visibleInAdvancedArea="true" mandatory="mandatory" label="{i18n>Plant}"/>
                            <smartFilterBar:ControlConfiguration id="sfStorageLocation" index="2" key="StorageLocation" visibleInAdvancedArea="true" label="{i18n>StorageLocation}"/>
                            <smartFilterBar:ControlConfiguration id="sfMaterial" index="3" key="Material" visibleInAdvancedArea="true" label="{i18n>Material}"/>
                            <smartFilterBar:ControlConfiguration id="sfSupplier" index="4" key="Supplier" visibleInAdvancedArea="true" label="{i18n>Supplier}"/>
                            <smartFilterBar:ControlConfiguration id="sfMaterialType" index="5" key="MaterialType" visibleInAdvancedArea="true" label="{i18n>MaterialType}"/>
                            <smartFilterBar:ControlConfiguration id="sfProductionSupervisor" index="6" key="ProductionSupervisor" visibleInAdvancedArea="true" label="{i18n>ProductionSupervisor}"/>
                            <smartFilterBar:ControlConfiguration id="sfMRPResponsible" index="7" key="MRPResponsible" visibleInAdvancedArea="true" label="{i18n>MRPResponsible}"/>
                            <smartFilterBar:ControlConfiguration id="sfYearMonth" index="8" key="YearMonth" visibleInAdvancedArea="true" mandatory="mandatory" label="{i18n>YearMonth}">
                                <smartFilterBar:customControl>
                                    <DatePicker
                                        id="monthPicker"
                                        displayFormat="yyyyMM"
                                        valueFormat="yyyyMM"/>
                                </smartFilterBar:customControl>
                            </smartFilterBar:ControlConfiguration>
                           <smartFilterBar:ControlConfiguration id="idBomExplosion" index="9" key="BomExplosion" visibleInAdvancedArea="true" label="{i18n>BomExplosion}" >
                                <smartFilterBar:customControl>
                                    <CheckBox id="chkBomExplosion" ></CheckBox>
                                </smartFilterBar:customControl> 
                            </smartFilterBar:ControlConfiguration>
                        </smartFilterBar:controlConfiguration>
                    </smartFilterBar:SmartFilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <smartTable:SmartTable id="idSmartTable" entitySet="ZC_MATERIALPERIODSTOCK" 
            smartFilterId="idSmartFilterBar" smartVariant="idSmartVariantManagement"
            persistencyKey="pkPLTable" header="{i18n>title}" placeToolbarInTable="true" beforeRebindTable="onBeforeRebindTable">
                <smartTable:customToolbar>
                </smartTable:customToolbar>
                <t:Table id="idPlTable" selectionMode="None">
                     <t:rowMode>
                        <rm:Auto id="rowMode" minRowCount="5"/>
                    </t:rowMode>
                    <t:columns> 
                         <t:Column id="colPlant" width="8rem">
                            <t:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey": "Plant", "leadingProperty": "Plant", "sortProperty": "Plant", "filterProperty": "Plant", "columnIndex": "0"\}'/>
                            </t:customData>
                            <Label id="labelPlant" labelFor="textPlant" text="{i18n>Plant}"></Label>
                            <t:template>
                                <Text id="textPlant" text="{Plant}"></Text>
                            </t:template>
                         </t:Column>
                         <t:Column id="colStorageLocation" width="8rem">
                            <t:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey": "StorageLocation", "leadingProperty": "StorageLocation", "sortProperty": "StorageLocation", "filterProperty": "StorageLocation", "columnIndex": "1"\}'/>
                            </t:customData>
                            <Label id="labelStorageLocation" labelFor="textStorageLocation" text="{i18n>StorageLocation}"></Label>
                            <t:template>
                                <Text id="textStorageLocation" text="{StorageLocation}"></Text>
                            </t:template>
                         </t:Column>
                         <t:Column id="colMaterial" width="15rem">
                            <t:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey": "Material", "leadingProperty": "Material", "sortProperty": "Material", "filterProperty": "Material", "columnIndex": "2"\}'/>
                            </t:customData>
                            <Label id="labelMaterial" labelFor="textMaterial" text="{i18n>Material}"></Label>
                            <t:template>
                                <Text id="textMaterial" text="{Material}"></Text>
                            </t:template>
                         </t:Column>
                         <t:Column id="colSupplier" width="8rem">
                            <t:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey": "Supplier", "leadingProperty": "Supplier", "sortProperty": "Supplier", "filterProperty": "Supplier", "columnIndex": "3"\}'/>
                            </t:customData>
                            <Label id="labelSupplier" labelFor="textSupplier" text="{i18n>Supplier}"></Label>
                            <t:template>
                                <Text id="textSupplier" text="{Supplier}"></Text>
                            </t:template>
                         </t:Column>
                         <t:Column id="colMaterialType" width="8rem">
                            <t:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey": "MaterialType", "leadingProperty": "MaterialType", "sortProperty": "MaterialType", "filterProperty": "MaterialType", "columnIndex": "4"\}'/>
                            </t:customData>
                            <Label id="labelMaterialType" labelFor="textMaterialType" text="{i18n>MaterialType}"></Label>
                            <t:template>
                                <Text id="textMaterialType" text="{MaterialType}"></Text>
                            </t:template>
                         </t:Column>
                         <t:Column id="colProductionSupervisor" width="8rem">
                            <t:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey": "ProductionSupervisor", "leadingProperty": "ProductionSupervisor", "sortProperty": "ProductionSupervisor", "filterProperty": "ProductionSupervisor", "columnIndex": "5"\}'/>
                            </t:customData>
                            <Label id="labelProductionSupervisor" labelFor="textProductionSupervisor" text="{i18n>ProductionSupervisor}"></Label>
                            <t:template>
                                <Text id="textProductionSupervisor" text="{ProductionSupervisor}"></Text>
                            </t:template>
                         </t:Column>
                         <t:Column id="colMRPResponsible" width="8rem">
                            <t:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey": "MRPResponsible", "leadingProperty": "MRPResponsible", "sortProperty": "MRPResponsible", "filterProperty": "MRPResponsible", "columnIndex": "6"\}'/>
                            </t:customData>
                            <Label id="labelMRPResponsible" labelFor="textMRPResponsible" text="{i18n>MRPResponsible}"></Label>
                            <t:template>
                                <Text id="textMRPResponsible" text="{MRPResponsible}"></Text>
                            </t:template>
                         </t:Column>
                         <t:Column id="colYearMonth" width="8rem">
                            <t:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey": "YearMonth", "leadingProperty": "YearMonth", "sortProperty": "YearMonth", "filterProperty": "YearMonth", "columnIndex": "7"\}'/>
                            </t:customData>
                            <Label id="labelYearMonth" labelFor="textYearMonth" text="{i18n>YearMonth}"></Label>
                            <t:template>
                                <Text id="textYearMonth" text="{YearMonth}"></Text>
                            </t:template>
                         </t:Column>
                         <t:Column id="colBomExplosion" width="8rem">
                            <t:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey": "BomExplosion", "leadingProperty": "BomExplosion", "sortProperty": "BomExplosion", "filterProperty": "BomExplosion", "columnIndex": "8"\}'/>
                            </t:customData>
                            <Label id="labelBomExplosion" labelFor="textBomExplosion" text="{i18n>BomExplosion}"></Label>
                            <t:template>
