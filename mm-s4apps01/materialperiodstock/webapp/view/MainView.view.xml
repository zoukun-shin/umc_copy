                            </t:customData>
                            <Label id="labelUnitPrice" labelFor="textUnitPrice" text="{i18n>UnitPrice}"></Label>
                            <t:template>
                                <Text id="textUnitPrice" text="{path: 'UnitPrice', type: 'sap.ui.model.odata.type.Decimal', constraints: {precision: 23, scale: 6}, formatOptions: {groupingEnabled: true, groupingSeparator: ',', decimalSeparator: '.'}}"></Text>
                            </t:template>
                         </t:Column>
                         <t:Column id="colTotalAmountCNY" width="15rem">
                            <t:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey": "TotalAmountCNY", "leadingProperty": "TotalAmountCNY", "sortProperty": "TotalAmountCNY", "filterProperty": "TotalAmountCNY", "columnIndex": "13"\}'/>
                            </t:customData>
                            <Label id="labelTotalAmountCNY" labelFor="textTotalAmountCNY" text="{i18n>TotalAmountCNY}"></Label>
                            <t:template>
                                <Text id="textTotalAmountCNY" text="{path: 'TotalAmountCNY', type: 'sap.ui.model.odata.type.Decimal', constraints: {precision: 23, scale: 6}, formatOptions: {groupingEnabled: true, groupingSeparator: ',', decimalSeparator: '.'}}"></Text>                            </t:template>
                         </t:Column>
                         <t:Column id="colProductDescription" width="15rem">
                            <t:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey": "ProductDescription", "leadingProperty": "ProductDescription", "sortProperty": "ProductDescription", "filterProperty": "ProductDescription", "columnIndex": "14"\}'/>
                            </t:customData>
                            <Label id="labelProductDescription" labelFor="textProductDescription" text="{i18n>ProductDescription}"></Label>
                            <t:template>
                                <Text id="textProductDescription" text="{ProductDescription}"></Text>
                            </t:template>
                         </t:Column>
                         <t:Column id="colTotalAmountUSD" width="15rem">
                            <t:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey": "TotalAmountUSD", "leadingProperty": "TotalAmountUSD", "sortProperty": "TotalAmountUSD", "filterProperty": "TotalAmountUSD", "columnIndex": "15"\}'/>
                            </t:customData>
                            <Label id="labelTotalAmountUSD" labelFor="textTotalAmountUSD" text="{i18n>TotalAmountUSD}"></Label>
                            <t:template>
                                <Text id="textTotalAmountUSD" text="{path: 'TotalAmountUSD', type: 'sap.ui.model.odata.type.Decimal', constraints: {precision: 23, scale: 6}, formatOptions: {groupingEnabled: true, groupingSeparator: ',', decimalSeparator: '.'}}"></Text>
                            </t:template>
                         </t:Column>
                         <t:Column id="colABC" width="8rem">
                            <t:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey": "ABC", "leadingProperty": "ABC", "sortProperty": "ABC", "filterProperty": "ABC", "columnIndex": "17"\}'/>
                            </t:customData>
                            <Label id="labelABC" labelFor="textABC" text="{i18n>ABC}"></Label>
                            <t:template>
                                <Text id="textABC" text="{ABC}"></Text>
                            </t:template>
                         </t:Column>
                         <t:Column id="colHsCodeName" width="8rem">
                            <t:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey": "HsCodeName", "leadingProperty": "HsCodeName", "sortProperty": "HsCodeName", "filterProperty": "HsCodeName", "columnIndex": "18"\}'/>
                            </t:customData>
                            <Label id="labelHsCodeName" labelFor="textHsCodeName" text="{i18n>HsCodeName}"></Label>
                            <t:template>
                                <Text id="textHsCodeName" text="{HsCodeName}"></Text>
                            </t:template>
                         </t:Column>
                         <t:Column id="colNetWeight" width="8rem">
                            <t:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey": "NetWeight", "leadingProperty": "NetWeight", "sortProperty": "NetWeight", "filterProperty": "NetWeight", "columnIndex": "19"\}'/>
                            </t:customData>
                            <Label id="labelNetWeight" labelFor="textNetWeight" text="{i18n>NetWeight}"></Label>
                            <t:template>
                                <Text id="textNetWeight" text="{path: 'NetWeight', type: 'sap.ui.model.odata.type.Decimal', constraints: {precision: 13, scale: 3}}"></Text>                            </t:template>
                         </t:Column>
                         <t:Column id="colWeightUnit" width="8rem">
                            <t:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey": "WeightUnit", "leadingProperty": "WeightUnit", "sortProperty": "WeightUnit", "filterProperty": "WeightUnit", "columnIndex": "20"\}'/>
                            </t:customData>
                            <Label id="labelWeightUnit" labelFor="textWeightUnit" text="{i18n>WeightUnit}"></Label>
                            <t:template>
