<mvc:View xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.uxap"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:m="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:smartForm="sap.ui.comp.smartform"
    xmlns:smartField="sap.ui.comp.smartfield" controllerName="mm.parkedinvoice.controller.Detail" height="100%" >
    <ObjectPageLayout id="ObjectPageLayout" enableLazyLoading="true" showFooter="true" showTitleInHeaderContent="true" upperCaseAnchorBar="false">
        <headerTitle>
            <ObjectPageDynamicHeaderTitle>
                <expandedHeading>
                    <m:Title text="{local>/JOB_Header/job_name}" wrapping="true"/>
                </expandedHeading>
                <snappedHeading>
                    <m:FlexBox fitContainer="true" alignItems="Center">
                        <m:Title text="{local>/uuid}" wrapping="true" />
                    </m:FlexBox>
                </snappedHeading>
            </ObjectPageDynamicHeaderTitle>
        </headerTitle>
        <sections>
            <ObjectPageSection id="idNG_Header" titleUppercase="false" title="{i18n>Header}">
                <ObjectPageSubSection id="idNG_Header_SS" title="{i18n>Header}" titleUppercase="false">
                    <blocks>
                        <f:SimpleForm id="idNG_Header_SF" editable="true" layout="ColumnLayout" columnsM="2" columnsL="3" columnsXL="4">
                            <f:content>
                                <m:Label text="{i18n>job_name}" />
                                <m:Text text="{ path: 'local>/JOB_Header/job_name' }"/>
                            </f:content>
                            <f:content>
                                <m:Label text="{i18n>schedule_begin}" />
                                <m:Text text="{ path: 'local>/JOB_Header/schedule_end' }"/>
                            </f:content>
                            <f:content>
                                <m:Label text="{i18n>schedule_end}" />
                                <m:Text text="{ path: 'local>/JOB_Header/schedule_end' }"/>
                            </f:content>
                            <f:content>
                                <m:Label text="{i18n>schedule_user}" />
                                <m:Text text="{ path: 'local>/JOB_Header/schedule_user' }"/>
                            </f:content>
                        </f:SimpleForm>
                    </blocks>
                </ObjectPageSubSection>
            </ObjectPageSection>
            <ObjectPageSection id="idDetail_Item" titleUppercase="false" title="{i18n>Item}">
                <ObjectPageSubSection id="idDetail_Item_SS" title="{i18n>Item}" titleUppercase="false">
                    <blocks>
                        <core:Fragment fragmentName="mm.parkedinvoice.fragments.Detail_Item" type="XML"/>
                    </blocks>
                </ObjectPageSubSection>
            </ObjectPageSection>
        </sections>
    </ObjectPageLayout>
</mvc:View>

