<mvc:View controllerName="mm.parkedinvoice.controller.Result" displayBlock="true"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:unified="sap.ui.unified"
    xmlns:t="sap.ui.table"
    xmlns:rm="sap.ui.table.rowmodes"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:sv="sap.ui.comp.smartvariants" height="100%" busyIndicatorDelay="0">
    <f:DynamicPage id="idDynamicPage">
        <f:title>
            <f:DynamicPageTitle id="idDynamicPageTitle">
                <f:heading>
                    <sv:SmartVariantManagement id="idSmartVariantManagement" showShare="true" persistencyKey="deliveryDocumentFilter" showExecuteOnSelection="true" entitySet="JobResult" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader id="idDynamicPageHeader">
                <f:content>
                    <!--数据查询-->
                    <smartFilterBar:SmartFilterBar id="idSmartFilterBar" smartVariant="idSmartVariantManagement" persistencyKey="deliveryDocument" entitySet="JobResult" useToolbar="false" class="sapUiResponsiveMargin">
                        <smartFilterBar:controlConfiguration>
                            <smartFilterBar:ControlConfiguration id="idControlConfiguration" key="job_status" visibleInAdvancedArea="true" label="{i18n>job_status}" mandatory="notMandatory" index="1" />
                            <smartFilterBar:ControlConfiguration id="id0ControlConfiguration" key="job_name" controlType="dropDownList" visibleInAdvancedArea="true" label="{i18n>job_name}" mandatory="notMandatory" index="5" />
                            <smartFilterBar:ControlConfiguration id="id1ControlConfiguration" key="schedule_begin" controlType="dropDownList" visibleInAdvancedArea="true" label="{i18n>schedule_begin}" mandatory="notMandatory" index="10" />
                            <smartFilterBar:ControlConfiguration id="id2ControlConfiguration" key="schedule_end" controlType="dropDownList" visibleInAdvancedArea="true" label="{i18n>schedule_end}" mandatory="notMandatory" index="15" />
                            <smartFilterBar:ControlConfiguration id="id3ControlConfiguration" key="schedule_user" controlType="dropDownList" visibleInAdvancedArea="true" label="{i18n>schedule_user}" mandatory="notMandatory" index="20" />
                            <smartFilterBar:ControlConfiguration id="id4ControlConfiguration" key="invno" visibleInAdvancedArea="true" label="{i18n>invno}" mandatory="notMandatory" index="25" />
                        </smartFilterBar:controlConfiguration>
                    </smartFilterBar:SmartFilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <smartTable:SmartTable id="idSmartTable" entitySet="JobResult" smartFilterId="idSmartFilterBar" smartVariant="idSmartVariantManagement" persistencyKey="deliveryDocumentTable" header="{local>/disInfo}" placeToolbarInTable="true" beforeRebindTable="onBeforeRebindTable" showRowCount="false" requestAtLeastFields="" ignoredFields="">
                <smartTable:customToolbar>
                    <OverflowToolbar >
                        <ToolbarSpacer />
                        <Button type="Transparent" text="{i18n>downloadBtn}" press="onExport" visible="{local>/onExportvisible}" enabled="true" />
                    </OverflowToolbar>
                </smartTable:customToolbar>
                <t:Table id="idDeliveryDocumentTable" rowActionCount="1" rowsUpdated="onUITableRowsUpdated">
                    <t:columns>
                        <t:Column width="10rem" label="{i18n>job_status}" sortProperty="job_status" filterProperty="job_status">
                            <t:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"job_status", "leadingProperty":"job_status", "sortProperty":"job_status", "filterProperty": "job_status"}'/>
                            </t:customData>
                            <t:template>
                                <Text text="{job_status}" wrapping="false" />
                            </t:template>
                        </t:Column>
                        <t:Column width="10rem" label="{i18n>job_name}" sortProperty="job_name" filterProperty="job_name">
                            <t:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"job_name", "leadingProperty":"job_name", "sortProperty":"job_name", "filterProperty": "job_name"}'/>
                            </t:customData>    
                        <t:template>
                                <Text text="{job_name}" wrapping="false" />
                            </t:template>
                        </t:Column>
                        <t:Column width="10rem" label="{i18n>schedule_begin}" sortProperty="schedule_begin" filterProperty="schedule_begin">
                            <t:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"schedule_begin", "leadingProperty":"schedule_begin", "sortProperty":"schedule_begin", "filterProperty": "schedule_begin"}'/>
                            </t:customData>    
                        <t:template>
                                <Text text="{schedule_begin}" wrapping="false" />
                            </t:template>
                        </t:Column>
                        <t:Column width="10rem" label="{i18n>schedule_end}" sortProperty="schedule_end" filterProperty="schedule_end">
                            <t:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"schedule_end", "leadingProperty":"schedule_end", "sortProperty":"schedule_end", "filterProperty": "schedule_end"}'/>
                            </t:customData>    
                        <t:template>
                                <Text text="{schedule_end}" wrapping="false" />
                            </t:template>
                        </t:Column>
                        <t:Column width="10rem" label="{i18n>schedule_user}" sortProperty="schedule_user" filterProperty="schedule_user">
                            <t:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"schedule_user", "leadingProperty":"schedule_user", "sortProperty":"schedule_user", "filterProperty": "schedule_user"}'/>
                            </t:customData>    
                        <t:template>
                                <Text text="{schedule_user}" wrapping="false" />
                            </t:template>
                        </t:Column>
                        <t:Column width="10rem" label="{i18n>job_result}" sortProperty="job_result" filterProperty="job_result">
                            <t:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"job_result", "leadingProperty":"job_result", "sortProperty":"job_result", "filterProperty": "job_result"}'/>
                            </t:customData>    
                        <t:template>
                                <Text text="{job_result}" wrapping="false" />
                            </t:template>
                        </t:Column>
                        <t:Column width="10rem" label="{i18n>job_text}" sortProperty="job_text" filterProperty="job_text">
                            <t:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"job_text", "leadingProperty":"job_text", "sortProperty":"job_text", "filterProperty": "job_text"}'/>
                            </t:customData>    
                        <t:template>
                                <Text text="{job_text}" wrapping="false" />
                            </t:template>
                        </t:Column>
                        <t:Column width="10rem" label="{i18n>invno}" sortProperty="invno" filterProperty="invno">
                            <t:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"invno", "leadingProperty":"invno", "sortProperty":"invno", "filterProperty": "invno"}'/>
                            </t:customData>    
                        <t:template>
                                <Text text="{invno}" wrapping="false" />
                            </t:template>
                        </t:Column>
                        <t:Column width="10rem" label="{i18n>posting_date}" sortProperty="posting_date" filterProperty="posting_date">
                            <t:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"posting_date", "leadingProperty":"posting_date", "sortProperty":"posting_date", "filterProperty": "posting_date"}'/>
                            </t:customData>    
                        <t:template>
                                <Text text="{posting_date}" wrapping="false" />
                            </t:template>
                        </t:Column>
                    </t:columns>
                </t:Table>
            </smartTable:SmartTable>
        </f:content>
    </f:DynamicPage>
</mvc:View>