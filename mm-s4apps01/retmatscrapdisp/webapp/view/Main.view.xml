<mvc:View controllerName="mm.retmatscrapdisp.controller.Main" displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:sv="sap.ui.comp.smartvariants"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:table="sap.ui.table">
    <f:DynamicPage headerExpanded="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <sv:SmartVariantManagement id="__SVM01" persistencyKey="RetMatScrapDispSVM" showShare="true" showExecuteOnSelection="true" entitySet="RetMatScrapDisp"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <f:content>
                    <FlexBox fitContainer="true">
                    <smartFilterBar:SmartFilterBar id="idSmartFilterBar" entitySet="RetMatScrapDisp" useToolbar="false" smartVariant="__SVM01" persistencyKey="RetMatScrapDispSFB" initialized="onSmartFilterBarInitialized" search="onSearch">
                            <smartFilterBar:controlConfiguration>
                                <smartFilterBar:ControlConfiguration index='10' key="CompanyCode" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>CompanyCode}"/>
                                <smartFilterBar:ControlConfiguration index='20' key="PurchasingHistoryDocumentYear" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>PurchasingHistoryDocumentYear}"/>
                                <smartFilterBar:ControlConfiguration index='30' key="PurchaseOrder" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>PurchaseOrder}"/>
                                <smartFilterBar:ControlConfiguration index='40' key="PurchasingHistoryDocument" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>PurchasingHistoryDocument}"/>
                                <smartFilterBar:ControlConfiguration index='50' key="Material"  displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>Material}"/>
                                <smartFilterBar:ControlConfiguration index='60' key="PostingDate" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>PostingDate}"/>
                                <smartFilterBar:ControlConfiguration index='70' key="Scrapped" visibleInAdvancedArea="true" label="{i18n>Scrapped}">
                                    <smartFilterBar:customControl>
                                        <Select id="idScrapped" change="onSelectModeChange" selectedKey="{local>/Scrapped}">
                                            <core:Item key="N" text="{i18n>No}"/>
                                            <core:Item key="Y" text="{i18n>Yes}"/>
                                            <core:Item key="A"  text="{i18n>All}"/>
                                        </Select>
                                    </smartFilterBar:customControl>
                                <!-- 除上述字段外，全部隐藏 -->
                                </smartFilterBar:ControlConfiguration>
                                <smartFilterBar:ControlConfiguration index='999' key="PurchaseOrderItem" visible="false"/>   
                                <smartFilterBar:ControlConfiguration index='999' key="Status" visible="false"/>   
                                <smartFilterBar:ControlConfiguration index='999' key="Message" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="Supplier" visible="false"/>   
                                <smartFilterBar:ControlConfiguration index='999' key="PurchaseOrderType" visible="false"/>   
                                <smartFilterBar:ControlConfiguration index='999' key="GoodsMovementType" visible="false"/>   
                                <smartFilterBar:ControlConfiguration index='999' key="PurchasingHistoryDocumentItem" visible="false"/>   
                                <smartFilterBar:ControlConfiguration index='999' key="DocumentDate" visible="false"/>   
                                <smartFilterBar:ControlConfiguration index='999' key="BaseUnit" visible="false"/>   
                                <smartFilterBar:ControlConfiguration index='999' key="QuantityinBaseUnit" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="PurchaseOrderAmount" visible="false"/>   
                                <smartFilterBar:ControlConfiguration index='999' key="Currency" visible="false"/>   
                                <smartFilterBar:ControlConfiguration index='999' key="HKAutoInbStatus" visible="false"/>   
                                <smartFilterBar:ControlConfiguration index='999' key="Document551" visible="false"/>   
                                <smartFilterBar:ControlConfiguration index='999' key="DocumentItem551" visible="false"/>   
                                <smartFilterBar:ControlConfiguration index='999' key="DocumentYear551" visible="false"/>   
                                <smartFilterBar:ControlConfiguration index='999' key="DocumentDate551" visible="false"/>
                            </smartFilterBar:controlConfiguration>
                        </smartFilterBar:SmartFilterBar>
                    </FlexBox>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <FlexBox fitContainer="true">
                <core:Fragment fragmentName="mm.retmatscrapdisp.fragments.RetMatScrapDisp" type="XML"/>
            </FlexBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
