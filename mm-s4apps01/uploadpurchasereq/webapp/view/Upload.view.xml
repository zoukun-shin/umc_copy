<mvc:View controllerName="mm.uploadpurchasereq.controller.Upload"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns="sap.m"
    xmlns:unified="sap.ui.unified"
    xmlns:upload="sap.m.upload"
    xmlns:t="sap.ui.table"
    xmlns:rm="sap.ui.table.rowmodes"
    xmlns:layout="sap.ui.layout">
    <VBox id="idVBox" fitContainer="true">
        <Panel id="idPanel" expandable="true" headerText="{i18n>templateText}" width="auto">
            <!-- <upload:UploadSet id="idUploadSet" items="{ path : 'Template>/Configuration', filters : { path : 'Object', operator : 'EQ', value1 : 'ZUPLOAD_PURCHASEREQ' } }" multiple="false" mode="None" uploadEnabled="false" uploadButtonInvisible="true" instantUpload="false"> -->
            <upload:UploadSet id="idUploadSet" items="{ path : 'Template>/Configuration' }" multiple="false" mode="None" uploadEnabled="false" uploadButtonInvisible="true" instantUpload="false">
                <upload:items>
                    <upload:UploadSetItem id="idUploadSetItem" fileName="{Template>TemplateName}" mediaType="{Template>TemplateMimeType}" url="{Template>TemplateContent}" visibleEdit="false" visibleRemove="false" />
                </upload:items>
            </upload:UploadSet>
        </Panel>
        <Panel id="idFileUploadPanel" expandable="true" expanded="true" headerText="{i18n>uploadText}" width="auto">
            <unified:FileUploader id="idFileUploader" fileType="xlsx,xls" change="onFileUploaderChange" width="40%" class="sapUiSmallMargin" sameFilenameAllowed="true" />
        </Panel>
        <Panel id="id0Panel" expandable="true" expanded="true" headerText="{i18n>result}" width="auto" height="100%">
            <layoutData>
                <FlexItemData id="idFlexItemData" maxHeight="100%" maxWidth="100%" growFactor="1" />
            </layoutData>
            <t:Table id="idTable" rows="{local>/excelSet}" selectionMode="Multi" class="sapUiSizeCompact">
                <t:rowMode>
                    <rm:Auto id="idAuto" />
                </t:rowMode>
                <t:extension>
                    <OverflowToolbar id="idOverflowToolbar">
                        <Text id="idLogInfoText" text="{local>/logInfo}" />
                        <ToolbarSpacer id="idToolbarSpacer" />
                        <Button id="idCheckButton" icon="sap-icon://check-availability" type="Transparent" text="{i18n>UploadView.checkBtn}" press=".onButtonPress($event, 'check')" visible="{= ${local>/excelSet}.length > 0}" />
                        <Button id="idSaveButton" icon="sap-icon://document" type="Transparent" text="{i18n>UploadView.saveBtn}" press=".onButtonPress($event, 'save')" visible="{= ${local>/excelSet}.length > 0}" enabled="{= ${local>/recordCheckSuccessed} &amp;&amp; ${local>/authorityCheck/button/Excute}}" />
                        <Button id="idDownloadButton" icon="sap-icon://excel-attachment" type="Transparent" text="{i18n>UploadView.DownloadBtn}" press="onExport" enabled="{= ${local>/excelSet}.length > 0 &amp;&amp; ${local>/authorityCheck/button/Export}}" />
                    </OverflowToolbar>
                </t:extension>
                <t:columns>
                    <t:Column id="id36Column" width="6rem" sortProperty="Type" label="{i18n>Status}">
                        <t:template>
                            <ObjectStatus id="idObjectStatus" state="{
                                    path: 'local>Type',
                                    formatter: '.formatter.setState'
                                }" icon="{
                                    path: 'local>Type',
                                    formatter: '.formatter.setStateIcon'
                                }" />
                        </t:template>
                    </t:Column>
                    <t:Column id="id37Column" width="5rem" sortProperty="Result" label="{i18n>Result}">
                        <t:template>
                            <Text id="idTypeText" text="{
                                    path: 'local>Type',
                                    formatter: '.formatter.setResult'
                                }" />
                        </t:template>
                    </t:Column>
                    <t:Column id="id38Column" width="14rem" sortProperty="Message" label="{i18n>Message}">
                        <t:template>
                            <Text id="idMessageText" text="{local>Message}" tooltip="{local>Message}" wrapping="false" />
                        </t:template>
                    </t:Column>
                    <t:Column id="id35Column" width="12rem" label="{i18n>ApplyDepart}">
                        <t:template>
                            <Text id="idApplyDepartText" text="{local>ApplyDepart}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="idColumn" width="10rem" label="{i18n>PrNo}">
                        <t:template>
                            <Text id="idPrNoText" text="{local>PrNo}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id42Column" width="12rem" label="{i18n>PrItem}">
                        <t:template>
                            <Text id="idPrItemText" text="{local>PrItem}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id0Column" width="12rem" label="{i18n>PrType}">
                        <t:template>
                            <Text id="idPrTypeText" text="{local>PrType}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id1Column" width="10rem" label="{i18n>OrderType}">
                        <t:template>
                            <Text id="idOrderTypeText" text="{local>OrderType}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id41Column" width="6rem" label="{i18n>Kyoten}">
                        <t:template>
                            <Text id="idKyotenText" text="{local>Kyoten}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id34Column" width="10rem" label="{i18n>IsLink}">
                        <t:template>
                            <Text id="idIsLinkText" text="{local>IsLink}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column width="10rem" label="{i18n>IsApprove}">
                        <t:template>
                            <Text text="{local>IsApprove}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id2Column" width="10rem" label="{i18n>Supplier}">
                        <t:template>
                            <Text id="idSupplierText" text="{local>Supplier}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id3Column" width="10rem" label="{i18n>CompanyCode}">
                        <t:template>
                            <Text id="idCompanyCodeText" text="{local>CompanyCode}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id4Column" width="12rem" label="{i18n>PurchaseOrg}">
                        <t:template>
                            <Text id="idPurchaseOrgText" text="{local>PurchaseOrg}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id5Column" width="10rem" label="{i18n>PurchaseGrp}">
                        <t:template>
                            <Text id="idPurchaseGrpText" text="{local>PurchaseGrp}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id6Column" width="10rem" label="{i18n>Plant}">
                        <t:template>
                            <Text id="idPlantText" text="{local>Plant}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id7Column" width="10rem" label="{i18n>Currency}">
                        <t:template>
                            <Text id="idCurrencyText" text="{local>Currency}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id8Column" width="10rem" label="{i18n>ItemCategory}">
                        <t:template>
                            <Text id="idItemCategoryText" text="{local>ItemCategory}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id9Column" width="14rem" label="{i18n>AccountType}">
                        <t:template>
                            <Text id="idAccountTypeText" text="{local>AccountType}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id10Column" width="10rem" label="{i18n>MatID}">
                        <t:template>
                            <Text id="idMatIDText" text="{local>MatID}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id11Column" width="10rem" label="{i18n>MatDesc}">
                        <t:template>
                            <Text id="idMatDescText" text="{local>MatDesc}" tooltip="{local>MatDesc}" wrapping="false" />
                        </t:template>
                    </t:Column>
                    <t:Column id="id12Column" width="10rem" label="{i18n>MaterialGroup}">
                        <t:template>
                            <Text id="idMaterialGroupText" text="{local>MaterialGroup}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id13Column" width="12rem" label="{i18n>Quantity}" hAlign="End">
                        <t:template>
                            <Text id="idQuantityText" text="{local>Quantity}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id14Column" width="10rem" label="{i18n>Unit}">
                        <t:template>
                            <Text id="idUnitText" text="{local>Unit}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id15Column" width="10rem" label="{i18n>Price}" hAlign="End">
                        <t:template>
                            <Text id="idPriceText" text="{local>Price}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id16Column" width="10rem" label="{i18n>UnitPrice}">
                        <t:template>
                            <Text id="idUnitPriceText" text="{local>UnitPrice}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id17Column" width="10rem" label="{i18n>DeliveryDate}">
                        <t:template>
                            <Text id="idDeliveryDateText" text="{path:'local>DeliveryDate', formatter:'.formatter.formatDate'}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id18Column" width="10rem" label="{i18n>Location}">
                        <t:template>
                            <Text id="idLocationText" text="{local>Location}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id19Column" width="10rem" label="{i18n>ReturnItem}">
                        <t:template>
                            <Text id="idReturnItemText" text="{local>ReturnItem}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id20Column" width="10rem" label="{i18n>Free}">
                        <t:template>
                            <Text id="idFreeText" text="{local>Free}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id21Column" width="10rem" label="{i18n>GlAccount}">
                        <t:template>
                            <Text id="idGlAccountText" text="{local>GlAccount}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id22Column" width="10rem" label="{i18n>CostCenter}">
                        <t:template>
                            <Text id="idCostCenterText" text="{local>CostCenter}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id23Column" width="10rem" label="{i18n>WbsElemnt}">
                        <t:template>
                            <Text id="idWbsElemntText" text="{local>WbsElemnt}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column width="10rem" label="{i18n>OrderId}">
                        <t:template>
                            <Text text="{local>OrderID}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id24Column" width="10rem" label="{i18n>AssetNo}">
                        <t:template>
                            <Text id="idAssetNoText" text="{local>AssetNo}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id25Column" width="10rem" label="{i18n>Tax}">
                        <t:template>
                            <Text id="idTaxText" text="{local>Tax}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id26Column" width="10rem" label="{i18n>ItemText}">
                        <t:template>
                            <Text id="idItemTextText" text="{local>ItemText}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id27Column" width="10rem" label="{i18n>PrBy}">
                        <t:template>
                            <Text id="idPrByText" text="{local>PrBy}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id28Column" width="14rem" label="{i18n>TrackNo}">
                        <t:template>
                            <Text id="idTrackNoText" text="{local>TrackNo}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id29Column" width="10rem" label="{i18n>Ean}">
                        <t:template>
                            <Text id="idEanText" text="{local>Ean}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id30Column" width="10rem" label="{i18n>CustomerRec}">
                        <t:template>
                            <Text id="idCustomerRecText" text="{local>CustomerRec}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id31Column" width="10rem" label="{i18n>AssetOri}">
                        <t:template>
                            <Text id="idAssetOriText" text="{local>AssetOri}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id32Column" width="16rem" label="{i18n>MemoText}">
                        <t:template>
                            <Text id="idMemoTextText" text="{local>MemoText}" tooltip="{local>MemoText}" wrapping="false" />
                        </t:template>
                    </t:Column>
                    <t:Column id="id33Column" width="10rem" label="{i18n>BuyPurpoose}">
                        <t:template>
                            <Text id="idBuyPurpooseText" text="{local>BuyPurpoose}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column width="12rem" label="{i18n>SupplierMat}">
                        <t:template>
                            <Text text="{local>SupplierMat}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column width="14rem" label="{i18n>PolinkBy}">
                        <t:template>
                            <Text text="{local>PolinkBy}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id39Column" width="10rem" label="{i18n>PurchaseOrder}">
                        <t:template>
                            <Text id="idPurchaseOrderText" text="{local>PurchaseOrder}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <t:Column id="id40Column" width="12rem" label="{i18n>PurchaseOrderItem}">
                        <t:template>
                            <Text id="idPurchaseOrderItemText" text="{local>PurchaseOrderItem}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <!-- ADD BEGIN BY XINLEI XU 2025/11/27 TH/VN CR#5481 -->
                    <t:Column width="15rem" label="{i18n>POHeaderText}">
                        <t:template>
                            <Text text="{local>POHeaderText}" wrapping="false"/>
                        </t:template>
                    </t:Column>
                    <!-- ADD END BY XINLEI XU 2025/11/27 TH/VN CR#5481 -->
                </t:columns>
            </t:Table>
        </Panel>
    </VBox>
</mvc:View>
