<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:smartForm="sap.ui.comp.smartform"
	xmlns:smartField="sap.ui.comp.smartfield"
	xmlns:layout="sap.ui.layout"
	xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
	<Dialog id="AnswerDialog" title="{i18n>DialogTitle}" contentWidth="18rem" type="Message" draggable="true">
		<VBox >
			<DatePicker id="idDatePickerPostingDate" valueFormat="yyyy/MM/dd" displayFormat="yyyy/MM/dd" />
		</VBox>
		<beginButton>
			<Button text="{i18n>bConfirm}" press="onDialogConfirm" />
		</beginButton>
		<endButton>
			<Button text="{i18n>bClose}" press="onDialogClose" />
		</endButton>
	</Dialog>
</core:FragmentDefinition>