        showFooter="false"
    >
        <f:title>
            <f:DynamicPageTitle id="idDynamicPageTitle">
                <f:heading>
                    <sv:SmartVariantManagement
                        id="idSmartVariantManagement"
                        showShare="true"
                        persistencyKey="salesBillingFilter"
                        showExecuteOnSelection="true"
                        entitySet="SalesBilling"
                    />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader id="idDynamicPageHeader">
                <f:content>
                    <smartFilterBar:SmartFilterBar
                        id="idSmartFilterBar"
                        smartVariant="idSmartVariantManagement"
                        persistencyKey="salesBillingSmartFilter"
                        entitySet="SalesBilling"
                        useToolbar="false"
                        class="sapUiResponsiveMargin"
                    >
                        <smartFilterBar:controlConfiguration>
                            <smartFilterBar:ControlConfiguration
                                key="CompanyCode"
                                visibleInAdvancedArea="true"
                                label="{/#SalesBillingType/CompanyCode/@sap:label}"
                                index="1"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="PayerParty"
                                visibleInAdvancedArea="true"
                                label="{/#SalesBillingType/PayerParty/@sap:label}"
                                index="2"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="BillingDocumentType"
                                visibleInAdvancedArea="true"
                                label="{/#SalesBillingType/BillingDocumentType/@sap:label}"
                                index="3"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="BillingDocument"
                                visibleInAdvancedArea="true"
                                label="{/#SalesBillingType/BillingDocument/@sap:label}"
                                index="4"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="BillingDocumentDate"
                                visibleInAdvancedArea="true"
                                label="{/#SalesBillingType/BillingDocumentDate/@sap:label}"
                                index="8"
                            >
                                <smartFilterBar:customControl>
                                    <DateRangeSelection id="idDatePickerBillingDocumentDate" valueFormat="yyyy/MM/dd" displayFormat="yyyy/MM/dd" />
                                </smartFilterBar:customControl>
                            </smartFilterBar:ControlConfiguration>
                            <smartFilterBar:ControlConfiguration
                                key="AccountingPostingStatus"
                                visibleInAdvancedArea="true"
                                label="{/#SalesBillingType/AccountingPostingStatus/@sap:label}"
                                index="9"
                            >
                                <smartFilterBar:customControl>
                                    <Select
                                        id="idAccountingPostingStatusSelect"
                                    >
                                        <items>
                                            <core:Item
                                                key="NotPosted"
                                                text="{i18n>NotPosted}"
                                            />
                                            <core:Item
                                                key="Posted"
                                                text="{i18n>Posted}"
                                            />
                                            <core:Item
                                                key="All"
                                                text="{i18n>All}"
                                            />
                                        </items>
                                    </Select>
                                </smartFilterBar:customControl>
                            </smartFilterBar:ControlConfiguration>
                            <smartFilterBar:ControlConfiguration
                                key="CancellationStatus"
                                visibleInAdvancedArea="true"
                                label="{/#SalesBillingType/CancellationStatus/@sap:label}"
                                index="10"
                            >
                                <smartFilterBar:customControl>
                                    <Select
                                        id="idCancellationStatusSelect"
                                    >
                                        <items>
                                            <core:Item
                                                key="ExcludeCancelled"
                                                text="{i18n>ExcludeCancelled}"
                                            />
                                            <core:Item
                                                key="IncludeCancelled"
                                                text="{i18n>IncludeCancelled}"
                                            />
                                        </items>
                                    </Select>
                                </smartFilterBar:customControl>
                            </smartFilterBar:ControlConfiguration>
                        </smartFilterBar:controlConfiguration>
                    </smartFilterBar:SmartFilterBar>
                </f:content>
            </f:DynamicPageHeader>
