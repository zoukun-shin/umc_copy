<core:FragmentDefinition xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:unified="sap.ui.unified"
    xmlns:layout="sap.ui.layout"
    xmlns:table="sap.ui.table"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:smartTable="sap.ui.comp.smarttable">
    <smartTable:SmartTable entitySet="BalanceSheet" smartFilterId="idSmartFilterBar" tableType="Table" width="100%" 
        showRowCount="true" smartVariant="__SVM01" useVariantManagement="true" useTablePersonalisation="true" 
        persistencyKey="BalanceSheetST" header='{i18n>Results}' enableAutoBinding="false" 
        placeToolbarInTable="true" beforeRebindTable="onBeforeRebindTable" 
        beforeExport="onBeforeExport" showFullScreenButton="true" ignoredFields="FiscalPeriodFr,FiscalPeriodTo,Language,Currency">
        <smartTable:customToolbar>
            <OverflowToolbar design="Transparent">
                <ToolbarSpacer/>
                <Button icon="sap-icon://print" text="{i18n>Print}" type="Transparent" press="onPressBtn('Print')" enabled="{= ${local>/authorityCheck/button/Print}}"/>
            </OverflowToolbar>
        </smartTable:customToolbar>
        <table:Table id="idTable" selectionMode="None" fixedColumnCount="0" rowMode="Auto">
            <table:columns>
                <table:Column width="8rem" label="{i18n>CompanyCode}" sortProperty="CompanyCode" filterProperty="CompanyCode">
                    <table:customData>
                        <core:CustomData key="p13nData" value='\{"columnKey":"CompanyCode", "leadingProperty":"CompanyCode"}'/>
                    </table:customData>
                    <table:template>
                        <Text text="{CompanyCode}" />
                    </table:template>
                </table:Column>
                <table:Column width="8rem" label="{i18n>FiscalYear}" sortProperty="FiscalYear" filterProperty="FiscalYear">
                    <table:customData>
                        <core:CustomData key="p13nData" value='\{"columnKey":"FiscalYear", "leadingProperty":"FiscalYear"}'/>
                    </table:customData>
                    <table:template>
                        <Text text="{FiscalYear}" wrapping="false" />
                    </table:template>
                </table:Column>
                <table:Column width="10rem" label="{i18n>Code}" sortProperty="Code" filterProperty="Code">
                    <table:customData>
                        <core:CustomData key="p13nData" value='\{"columnKey":"Code", "leadingProperty":"Code"}'/>
                    </table:customData>
                    <table:template>
                        <Text text="{Code}" wrapping="false" />
                    </table:template>
                </table:Column>
                <table:Column width="15rem" label="{i18n>OpeningBalAmt}" sortProperty="OpeningBalAmt" filterProperty="OpeningBalAmt" hAlign="End">
                    <table:customData>
                        <core:CustomData key="p13nData" value='\{"columnKey":"OpeningBalAmt", "leadingProperty":"OpeningBalAmt"}'/>
                    </table:customData>
                    <table:template>
                        <Text text="{path:'OpeningBalAmt', formatter:'.formatter.formatNumber'}" wrapping="false" />
                    </table:template>
                </table:Column>
                <table:Column width="15rem" label="{i18n>ClosingBalAmt}" sortProperty="ClosingBalAmt" filterProperty="ClosingBalAmt" hAlign="End">
                    <table:customData>
                        <core:CustomData key="p13nData" value='\{"columnKey":"ClosingBalAmt", "leadingProperty":"ClosingBalAmt"}'/>
                    </table:customData>
                    <table:template>
                        <Text text="{path:'ClosingBalAmt', formatter:'.formatter.formatNumber'}" wrapping="false" />
                    </table:template>
                </table:Column>
            </table:columns>
        </table:Table>
    </smartTable:SmartTable>
</core:FragmentDefinition>