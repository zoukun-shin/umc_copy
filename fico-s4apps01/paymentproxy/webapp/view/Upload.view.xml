<mvc:View controllerName="fico.paymentproxy.controller.Upload"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:unified="sap.ui.unified"
    xmlns:upload="sap.m.upload"
    xmlns:table="sap.ui.table">
    <Page>
        <content>
            <Panel expandable="true" expanded="false" headerText="{i18n>templateText}" width="auto">
                <upload:UploadSet
                    id="idTemplateCollection"
                    items="{ path : 'Attach>/Configuration' }"
                    multiple="true"
                    uploadEnabled="false"
                    uploadButtonInvisible="true"
                    instantUpload="false">
                    <upload:items>
                        <upload:UploadSetItem
                            fileName="{Attach>TemplateName}"
                            mediaType="{Attach>TemplateMimeType}"
                            url="{Attach>TemplateContent}"
                            visibleEdit="false"
                            visibleRemove="false"/>
                    </upload:items>
                </upload:UploadSet>
            </Panel>
            <Panel id="idFileUploadPanel" expandable="true" expanded="true" headerText="{i18n>uploadText}" width="auto">
                <unified:FileUploader
                    id="idFileUploader"
                    sameFilenameAllowed="true"
                    fileType="xlsx,xls"
                    change="onFileUploaderChange"
                    width="40%"
                    class="sapUiSmallMargin"
                    enabled="{= ${local>/authorityCheck/button/Upload}}"/>
            </Panel>
            <Panel expandable="true" expanded="true" headerText="{i18n>result}" width="auto">
                <table:Table
                    id="uploadTable"
                    rows="{local>/excelSet}"
                    selectionMode="Multi"
                    rowMode="Interactive"
                    class="sapUiSizeCompact">
                    <table:extension>
                        <OverflowToolbar>
                            <Text text="{local>/logInfo}"/>
                            <ToolbarSpacer/>
                            <Button id="idCheckButton"
                                icon="sap-icon://check-availability"
                                type="Transparent"
                                text="{i18n>checkBtn}"
                                press="onCheck"
                                visible="{= ${local>/excelSet}.length > 0}"
                                enabled="{= ${local>/authorityCheck/button/Check}}"/>
                            <Button id="idSaveButton"
                                icon="sap-icon://save"
                                type="Transparent"
                                text="{i18n>saveBtn}"
                                press="onSave"
                                visible="{= ${local>/excelSet}.length > 0}"
                                enabled="{= ${local>/authorityCheck/button/Save} &amp;&amp; ${local>/recordCheckSuccessed}}"/>
                            <Button id="idExportButton"
                                icon="sap-icon://excel-attachment"
                                type="Transparent"
                                text="{i18n>exportBtn}"
                                press="onExport"
                                visible="{= ${local>/excelSet}.length > 0}"
                                enabled="{= ${local>/authorityCheck/button/Export}}"/>
                        </OverflowToolbar>
                    </table:extension>
                    <table:columns>
                        <table:Column autoResizable="true" width="5rem" label="{i18n>Status}">
                            <table:template>
                                <ObjectStatus state="{ path:'local>Type', formatter:'.formatter.setState' }"
                                    icon="{ path:'local>Type', formatter:'.formatter.setStateIcon' }"/>
                            </table:template>
                        </table:Column>
                        <table:Column width="18rem" label="{i18n>Message}">
                            <table:template>
                                <Text text="{local>Message}" tooltip="{local>Message}" wrapping="false"/>
                            </table:template>
                        </table:Column>
                        <table:Column width="7rem" label="{i18n>CompanyCode}">
                            <table:template>
                                <Text text="{local>CompanyCode}" wrapping="false"/>
                            </table:template>
                        </table:Column>
                        <table:Column width="9rem" label="{i18n>Supplier}">
                            <table:template>
                                <Text text="{local>Supplier}" wrapping="false"/>
                            </table:template>
                        </table:Column>
                        <table:Column width="14rem" label="{i18n>SupplierName}">
                            <table:template>
                                <Text text="{local>SupplierName}" tooltip="{local>SupplierName}" wrapping="false"/>
                            </table:template>
                        </table:Column>
                        <table:Column width="9rem" label="{i18n>PaymentDate}">
                            <table:template>
                                <Text text="{path:'local>PaymentDate',type:'sap.ui.model.type.Date',formatOptions:{UTC: true}}" wrapping="false"/>
                            </table:template>
                        </table:Column>
                        <table:Column width="6rem" label="{i18n>PaymentMethod}">
                            <table:template>
                                <Text text="{local>PaymentMethod}" wrapping="false"/>
                            </table:template>
                        </table:Column>
                        <table:Column width="12rem" label="{i18n>BankName}">
                            <table:template>
                                <Text text="{local>BankName}" tooltip="{local>BankName}" wrapping="false"/>
                            </table:template>
                        </table:Column>
                        <table:Column width="9rem" label="{i18n>TransactionAmount}">
                            <table:template>
                                <Text text="{local>TransactionAmount}" wrapping="false"/>
                            </table:template>
                        </table:Column>
                        <table:Column width="7rem" label="{i18n>FeeAmount}">
                            <table:template>
                                <Text text="{local>FeeAmount}" wrapping="false"/>
                            </table:template>
                        </table:Column>
                        <table:Column width="9rem" label="{i18n>PaymentAmount}">
                            <table:template>
                                <Text text="{local>PaymentAmount}" wrapping="false"/>
                            </table:template>
                        </table:Column>
                        <table:Column width="6rem" label="{i18n>Currency}">
                            <table:template>
                                <Text text="{local>Currency}" wrapping="false"/>
                            </table:template>
                        </table:Column>
                        <table:Column width="6rem" label="{i18n>Responsible}">
                            <table:template>
                                <Text text="{local>Responsible}" wrapping="false"/>
                            </table:template>
                        </table:Column>
                        <table:Column width="7rem" label="{i18n>BankCountryKey}">
                            <table:template>
                                <Text text="{local>BankCountryKey}" wrapping="false"/>
                            </table:template>
                        </table:Column>
                        <table:Column width="12rem" label="{i18n>BankAccountHolderName}">
                            <table:template>
                                <Text text="{local>BankAccountHolderName}" tooltip="{local>BankAccountHolderName}" wrapping="false"/>
                            </table:template>
                        </table:Column>
                        <table:Column width="12rem" label="{i18n>BankAccount}">
                            <table:template>
                                <Text text="{local>BankAccount}" wrapping="false"/>
                            </table:template>
                        </table:Column>
                        <table:Column width="16rem" label="{i18n>BankAddress}">
                            <table:template>
                                <Text text="{local>BankAddress}" tooltip="{local>BankAddress}" wrapping="false"/>
                            </table:template>
                        </table:Column>
                    </table:columns>
                </table:Table>
            </Panel>
        </content>
    </Page>
</mvc:View>
