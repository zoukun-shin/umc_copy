                                </t:columns>
                            </t:Table>
                        </smartTable:SmartTable>
                    </IconTabFilter>
                    <!-- 页签2:支付计划书汇总(调整付款日可编辑 + 保存) -->
                    <IconTabFilter text="{i18n>tabSummary}" key="Summary">
                        <smartTable:SmartTable
                            id="idSumTable"
                            entitySet="PaySchdSum"
                            smartFilterId="idFilterBar"
                            persistencyKey="payschdSumTable"
                            header="{i18n>tableHeaderSum}"
                            showRowCount="true"
                            useExportToExcel="true"
                            useVariantManagement="false"
                            useTablePersonalisation="true"
                            enableAutoBinding="false"
                            beforeRebindTable="onBeforeRebindSum"
                            requestAtLeastFields="CompanyCode,Supplier,Paymentterms,NetDueDate,TransactionCurrency">
                            <smartTable:customToolbar>
                                <OverflowToolbar>
                                    <ToolbarSpacer/>
                                    <Button
                                        id="idBtnEdit"
                                        text="{i18n>btnEdit}"
                                        icon="sap-icon://edit"
                                        enabled="{local>/authorityCheck/button/Save}"
                                        visible="{= !${local>/editMode}}"
                                        press="onEdit"/>
                                    <Button
                                        id="idBtnSave"
                                        text="{i18n>btnSave}"
                                        icon="sap-icon://save"
                                        type="Emphasized"
                                        visible="{local>/editMode}"
                                        press="onSave"/>
                                    <Button
                                        id="idBtnCancel"
                                        text="{i18n>btnCancel}"
                                        visible="{local>/editMode}"
                                        press="onCancelEdit"/>
                                </OverflowToolbar>
                            </smartTable:customToolbar>
                            <t:Table
                                selectionMode="None"
                                visibleRowCountMode="Auto"
                                minAutoRowCount="10">
                                <t:columns>
                                    <t:Column width="7rem" sortProperty="CompanyCode" filterProperty="CompanyCode">
                                        <Label text="{i18n>colCompanyCode}"/>
                                        <t:customData>
                                            <core:CustomData key="p13nData" value='\{"columnKey":"CompanyCode","leadingProperty":"CompanyCode","sortProperty":"CompanyCode","filterProperty":"CompanyCode"}'/>
                                        </t:customData>
                                        <t:template>
                                            <Text text="{CompanyCode}" wrapping="false"/>
                                        </t:template>
                                    </t:Column>
                                    <t:Column width="10rem" sortProperty="CompanyCodeText" filterProperty="CompanyCodeText">
                                        <Label text="{i18n>colCompanyCodeText}"/>
                                        <t:customData>
                                            <core:CustomData key="p13nData" value='\{"columnKey":"CompanyCodeText","leadingProperty":"CompanyCodeText","sortProperty":"CompanyCodeText","filterProperty":"CompanyCodeText"}'/>
                                        </t:customData>
                                        <t:template>
                                            <Text text="{CompanyCodeText}" wrapping="false" tooltip="{CompanyCodeText}"/>
                                        </t:template>
                                    </t:Column>
                                    <t:Column width="8rem" sortProperty="Supplier" filterProperty="Supplier">
                                        <Label text="{i18n>colSupplier}"/>
                                        <t:customData>
                                            <core:CustomData key="p13nData" value='\{"columnKey":"Supplier","leadingProperty":"Supplier","sortProperty":"Supplier","filterProperty":"Supplier"}'/>
                                        </t:customData>
                                        <t:template>
                                            <Text text="{Supplier}" wrapping="false"/>
                                        </t:template>
                                    </t:Column>
                                    <t:Column width="14rem" sortProperty="SupplierText" filterProperty="SupplierText">
                                        <Label text="{i18n>colSupplierText}"/>
                                        <t:customData>
                                            <core:CustomData key="p13nData" value='\{"columnKey":"SupplierText","leadingProperty":"SupplierText","sortProperty":"SupplierText","filterProperty":"SupplierText"}'/>
                                        </t:customData>
                                        <t:template>
                                            <Text text="{SupplierText}" wrapping="false" tooltip="{SupplierText}"/>
                                        </t:template>
                                    </t:Column>
                                    <t:Column width="10rem" hAlign="Right" sortProperty="AmountInTransactionCurrency" filterProperty="AmountInTransactionCurrency">
                                        <Label text="{i18n>colAmountInTransactionCurrency}"/>
                                        <t:customData>
                                            <core:CustomData key="p13nData" value='\{"columnKey":"AmountInTransactionCurrency","leadingProperty":"AmountInTransactionCurrency","sortProperty":"AmountInTransactionCurrency","filterProperty":"AmountInTransactionCurrency","type":"numeric"}'/>
                                        </t:customData>
                                        <t:template>
                                            <Text text="{path:'AmountInTransactionCurrency', type:'sap.ui.model.odata.type.Decimal'}" wrapping="false"/>
                                        </t:template>
                                    </t:Column>
                                    <t:Column width="6rem" sortProperty="TransactionCurrency" filterProperty="TransactionCurrency">
