            <f:DynamicPageTitle id="idDynamicPageTitle">
                <f:heading>
                    <sv:SmartVariantManagement id="idSmartVariantManagement" showShare="true" persistencyKey="DocumentFilter" showExecuteOnSelection="true" entitySet="GeneralLedger" />
