                <f:content>
                    <!--数据查询-->
                    <smartFilterBar:SmartFilterBar id="idSmartFilterBar" smartVariant="idSmartVariantManagement" persistencyKey="Document" entitySet="GeneralLedger" useToolbar="false" class="sapUiResponsiveMargin">
                        <smartFilterBar:controlConfiguration>
                            <smartFilterBar:ControlConfiguration id="idControlConfiguration"  key="SourceLedger" filterType="single" visibleInAdvancedArea="true" label="{i18n>SourceLedger}" mandatory="notMandatory" index="1" />
                            <smartFilterBar:ControlConfiguration id="id0ControlConfiguration" key="CompanyCode"  filterType="single" visibleInAdvancedArea="true" label="{i18n>CompanyCode}" mandatory="notMandatory" index="5" />
                            <smartFilterBar:ControlConfiguration id="id1ControlConfiguration" key="ChartOfAccounts"  visibleInAdvancedArea="true" label="{i18n>ChartOfAccounts}" mandatory="notMandatory" index="10" />
                            <smartFilterBar:ControlConfiguration id="id2ControlConfiguration" key="Status" filterType="single" visibleInAdvancedArea="true" label="{i18n>Status}" mandatory="notMandatory" index="15" />
                            <smartFilterBar:ControlConfiguration id="id3ControlConfiguration" key="FiscalPeriod"  visibleInAdvancedArea="true" label="{i18n>FiscalPeriod}" mandatory="notMandatory" index="20" />
                            <smartFilterBar:ControlConfiguration id="id4ControlConfiguration" key="AlternativeGLAccount" visibleInAdvancedArea="true" label="{i18n>AlternativeGLAccount}" mandatory="notMandatory" index="25" />
                        </smartFilterBar:controlConfiguration>
                    </smartFilterBar:SmartFilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <smartTable:SmartTable id="idSmartTable" entitySet="GeneralLedger" smartFilterId="idSmartFilterBar" smartVariant="idSmartVariantManagement" persistencyKey="DocumentTable" header="{local>/disInfo}" placeToolbarInTable="true" beforeRebindTable="onBeforeRebindTable" showRowCount="false" requestAtLeastFields="" ignoredFields="">
                <smartTable:customToolbar>
                    <!-- <OverflowToolbar >
                        <ToolbarSpacer />
                        <Button type="Transparent" text="{i18n>downloadBtn}" press="onExport" visible="{local>/onExportvisible}" enabled="true" />
                    </OverflowToolbar> -->
                </smartTable:customToolbar>
