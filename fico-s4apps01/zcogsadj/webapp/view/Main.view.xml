                persistencyKey="cogsAdjTable" header="{i18n>Result}" enableAutoBinding="false"
                placeToolbarInTable="true" beforeRebindTable="onBeforeRebindTable"
                fitContainer="true" height="100%">

                <smartTable:customToolbar>
                    <OverflowToolbar id="toolbar" width="100%">
                        <ToolbarSpacer/>
                        <!-- 执行功能=1更新: 营业确认/营业取消确认/财务过账; =2查询: 财务冲销 -->
                        <Button id="btnConfirm" icon="sap-icon://accept" text="{i18n>ConfirmBtn}" tooltip="{i18n>ConfirmBtn}" press="onConfirm" visible="{local>/showUpdate}" enabled="{= ${local>/authorityCheck/button/Confirm} !== false}"/>
                        <Button id="btnUnconfirm" icon="sap-icon://decline" text="{i18n>UnconfirmBtn}" tooltip="{i18n>UnconfirmBtn}" press="onUnconfirm" visible="{local>/showUpdate}" enabled="{= ${local>/authorityCheck/button/Unconfirm} !== false}"/>
                        <Button id="btnPost" icon="sap-icon://add-calendar" text="{i18n>PostBtn}" tooltip="{i18n>PostBtn}" press="onPost" visible="{local>/showUpdate}" enabled="{= ${local>/authorityCheck/button/Post} !== false}"/>
                        <Button id="btnCancel" icon="sap-icon://add-calendar" text="{i18n>CancelBtn}" tooltip="{i18n>CancelBtn}" press="onCancel" visible="{local>/showCancel}" enabled="{= ${local>/authorityCheck/button/Cancel} !== false}"/>
                    </OverflowToolbar>
                </smartTable:customToolbar>

