                        <t:customData><core:CustomData key="p13nData" value='\{"columnKey":"Status","leadingProperty":"Status","sortProperty":"Status","filterProperty":"Status"}'/></t:customData>
                        <t:template><ObjectStatus state="{path:'Status', formatter:'.formatter.setState'}" icon="{path:'Status', formatter:'.formatter.setStateIcon'}"/></t:template>
                    </t:Column>
                    <t:Column id="Message" label="{i18n>Message}" width="20rem" sortProperty="Message"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"Message","leadingProperty":"Message","sortProperty":"Message"}'/></t:customData><t:template><Text text="{Message}" tooltip="{Message}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="CompanyCode" label="{i18n>CompanyCode}" width="7rem" sortProperty="CompanyCode" filterProperty="CompanyCode"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"CompanyCode","leadingProperty":"CompanyCode","sortProperty":"CompanyCode","filterProperty":"CompanyCode"}'/></t:customData><t:template><Text text="{CompanyCode}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="FiscalYear" label="{i18n>FiscalYear}" width="6rem" sortProperty="FiscalYear" filterProperty="FiscalYear"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"FiscalYear","leadingProperty":"FiscalYear","sortProperty":"FiscalYear","filterProperty":"FiscalYear"}'/></t:customData><t:template><Text text="{FiscalYear}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="FiscalMonth" label="{i18n>FiscalMonth}" width="6rem" sortProperty="FiscalMonth" filterProperty="FiscalMonth"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"FiscalMonth","leadingProperty":"FiscalMonth","sortProperty":"FiscalMonth","filterProperty":"FiscalMonth"}'/></t:customData><t:template><Text text="{FiscalMonth}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="OutboundDelivery" label="{i18n>OutboundDelivery}" width="9rem" sortProperty="OutboundDelivery" filterProperty="OutboundDelivery"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"OutboundDelivery","leadingProperty":"OutboundDelivery","sortProperty":"OutboundDelivery","filterProperty":"OutboundDelivery"}'/></t:customData><t:template><Text text="{OutboundDelivery}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="OutboundDeliveryItem" label="{i18n>OutboundDeliveryItem}" width="7rem" sortProperty="OutboundDeliveryItem" filterProperty="OutboundDeliveryItem"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"OutboundDeliveryItem","leadingProperty":"OutboundDeliveryItem","sortProperty":"OutboundDeliveryItem","filterProperty":"OutboundDeliveryItem"}'/></t:customData><t:template><Text text="{OutboundDeliveryItem}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="DNCreationDate" label="{i18n>DNCreationDate}" width="8rem" sortProperty="DNCreationDate" filterProperty="DNCreationDate"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"DNCreationDate","leadingProperty":"DNCreationDate","sortProperty":"DNCreationDate","filterProperty":"DNCreationDate"}'/></t:customData><t:template><Text text="{path:'DNCreationDate', formatter:'.formatter.date'}" wrapping="false"/></t:template></t:Column>
