<mvc:View controllerName="fico.zcogsadj.controller.Main" displayBlock="true"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:sv="sap.ui.comp.smartvariants"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:t="sap.ui.table" height="100%">

    <f:DynamicPage id="dynamicPageId" headerExpanded="true" showFooter="true" busy="{local>/busy}" fitContent="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <sv:SmartVariantManagement id="cogsAdjVariant" persistencyKey="cogsAdjVariant" showShare="true" showExecuteOnSelection="true" entitySet="CogsAdj"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <f:content>
                    <smartFilterBar:SmartFilterBar id="cogsAdjFilterBar" useToolbar="false" entitySet="CogsAdj" smartVariant="cogsAdjVariant" persistencyKey="cogsAdjFilterBar" search="onSearch">
                        <smartFilterBar:controlConfiguration>
                            <smartFilterBar:ControlConfiguration index="1" key="SalesOrganization" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>SalesOrganization}" filterType="single" mandatory="mandatory"/>
                            <smartFilterBar:ControlConfiguration index="2" key="Plant" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>Plant}" filterType="multiple" mandatory="mandatory"/>
                            <smartFilterBar:ControlConfiguration index="3" key="FiscalYear" visibleInAdvancedArea="true" filterType="single" label="{i18n>FiscalYear}" mandatory="mandatory">
                                <smartFilterBar:customControl>
                                    <DatePicker id="idGjahr" displayFormat="yyyy"/>
                                </smartFilterBar:customControl>
                            </smartFilterBar:ControlConfiguration>
                            <smartFilterBar:ControlConfiguration index="4" key="FiscalMonth" visibleInAdvancedArea="true" filterType="single" label="{i18n>FiscalMonth}" mandatory="mandatory">
                                <smartFilterBar:customControl>
                                    <Select id="idMonat">
                                        <core:Item id="M01" key="01" text="01"/>
                                        <core:Item id="M02" key="02" text="02"/>
                                        <core:Item id="M03" key="03" text="03"/>
                                        <core:Item id="M04" key="04" text="04"/>
                                        <core:Item id="M05" key="05" text="05"/>
                                        <core:Item id="M06" key="06" text="06"/>
                                        <core:Item id="M07" key="07" text="07"/>
                                        <core:Item id="M08" key="08" text="08"/>
                                        <core:Item id="M09" key="09" text="09"/>
                                        <core:Item id="M10" key="10" text="10"/>
                                        <core:Item id="M11" key="11" text="11"/>
                                        <core:Item id="M12" key="12" text="12"/>
                                    </Select>
                                </smartFilterBar:customControl>
                            </smartFilterBar:ControlConfiguration>
                            <smartFilterBar:ControlConfiguration index="5" key="ExecFunction" visibleInAdvancedArea="true" filterType="single" label="{i18n>ExecFunction}" mandatory="mandatory">
                                <smartFilterBar:customControl>
                                    <Select id="idExecFunction" selectedKey="1" change="onExecFunctionChange">
                                        <core:Item key="1" text="1 - {i18n>ExecUpdate}"/>
                                        <core:Item key="2" text="2 - {i18n>ExecQuery}"/>
                                    </Select>
                                </smartFilterBar:customControl>
                            </smartFilterBar:ControlConfiguration>
                        </smartFilterBar:controlConfiguration>
                    </smartFilterBar:SmartFilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <smartTable:SmartTable id="cogsAdjTable" entitySet="CogsAdj" smartVariant="cogsAdjVariant" smartFilterId="cogsAdjFilterBar"
