                    <t:Column id="AdjQtyMonth" label="{i18n>AdjQtyMonth}" width="10rem" hAlign="End" sortProperty="AdjQtyMonth" filterProperty="AdjQtyMonth"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"AdjQtyMonth","leadingProperty":"AdjQtyMonth","sortProperty":"AdjQtyMonth","filterProperty":"AdjQtyMonth"}'/></t:customData><t:template><Text text="{AdjQtyMonth}" wrapping="false"/></t:template></t:Column>
