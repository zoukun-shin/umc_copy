                    <t:Column id="DNTransferYearMonth" label="{i18n>DNTransferYearMonth}" width="9rem" sortProperty="DNTransferYearMonth" filterProperty="DNTransferYearMonth"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"DNTransferYearMonth","leadingProperty":"DNTransferYearMonth","sortProperty":"DNTransferYearMonth","filterProperty":"DNTransferYearMonth"}'/></t:customData><t:template><Text text="{path:'DNTransferYearMonth', formatter:'.formatter.allZeroToBlank'}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="SalesOrganization" label="{i18n>SalesOrganization}" width="7rem" sortProperty="SalesOrganization" filterProperty="SalesOrganization"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"SalesOrganization","leadingProperty":"SalesOrganization","sortProperty":"SalesOrganization","filterProperty":"SalesOrganization"}'/></t:customData><t:template><Text text="{SalesOrganization}" wrapping="false"/></t:template></t:Column>
