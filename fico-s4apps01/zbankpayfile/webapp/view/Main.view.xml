<mvc:View controllerName="fico.zbankpayfile.controller.Main" displayBlock="true"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:sv="sap.ui.comp.smartvariants"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:t="sap.ui.table" height="100%">

    <f:DynamicPage id="dynamicPageId" headerExpanded="true" showFooter="true" busy="{localModel>/busy}" fitContent="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <sv:SmartVariantManagement id="__SVM01" persistencyKey="SVM_BankPayFile" showShare="true" showExecuteOnSelection="true" entitySet="BankPayFile"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <f:content>
                    <smartFilterBar:SmartFilterBar id="SFBBankPayFile" useToolbar="false" entitySet="BankPayFile" smartVariant="__SVM01" persistencyKey="BankPayFileBar" search="onSearch" initialise="onSFBInitialise">
                        <smartFilterBar:controlConfiguration>
                            <smartFilterBar:ControlConfiguration index="1" key="CompanyCode" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>CompanyCode}" filterType="single" mandatory="mandatory"/>
                            <smartFilterBar:ControlConfiguration index="2" key="PostingDate" visibleInAdvancedArea="true" label="{i18n>PostingDate}" filterType="interval">
                                <smartFilterBar:customControl>
                                    <DateRangeSelection id="idPostingDate"/>
                                </smartFilterBar:customControl>
                            </smartFilterBar:ControlConfiguration>
                            <smartFilterBar:ControlConfiguration index="3" key="AccountingDocument" visibleInAdvancedArea="true" label="{i18n>AccountingDocument}"/>
                            <smartFilterBar:ControlConfiguration index="4" key="Supplier" visibleInAdvancedArea="true" label="{i18n>Supplier}" filterType="multiple"/>
                            <smartFilterBar:ControlConfiguration index="5" key="NetDueDate" visibleInAdvancedArea="true" label="{i18n>NetDueDate}" filterType="single">
                                <smartFilterBar:customControl>
                                    <DatePicker id="idNetDueDate"/>
                                </smartFilterBar:customControl>
                            </smartFilterBar:ControlConfiguration>
                            <smartFilterBar:ControlConfiguration index="6" key="PaymentRunDate" visibleInAdvancedArea="true" label="{i18n>PaymentRunDate}" filterType="single">
                                <smartFilterBar:customControl>
                                    <DatePicker id="idPaymentRunDate"/>
                                </smartFilterBar:customControl>
                            </smartFilterBar:ControlConfiguration>
                            <smartFilterBar:ControlConfiguration index="7" key="PaymentRunID" visibleInAdvancedArea="true" label="{i18n>PaymentRunID}" filterType="multiple"/>
                            <smartFilterBar:ControlConfiguration index="8" key="HouseBank" visibleInAdvancedArea="true" label="{i18n>HouseBank}" filterType="single"/>
                            <smartFilterBar:ControlConfiguration index="9" key="PaymentDate" visibleInAdvancedArea="true" label="{i18n>PaymentDate}" filterType="single">
                                <smartFilterBar:customControl>
                                    <DatePicker id="idPaymentDate"/>
                                </smartFilterBar:customControl>
                            </smartFilterBar:ControlConfiguration>
                            <smartFilterBar:ControlConfiguration index="10" key="DataSource" visibleInAdvancedArea="true" label="{i18n>DataSource}">
                                <smartFilterBar:customControl>
                                    <Select id="DataSourceSelect" selectedKey="1" change="onDataSourceChange" width="14rem">
                                        <core:Item key="1" text="1 - {i18n>DataSourceAP}"/>
                                        <core:Item key="2" text="2 - {i18n>DataSourceProposal}"/>
                                    </Select>
                                </smartFilterBar:customControl>
                            </smartFilterBar:ControlConfiguration>
                        </smartFilterBar:controlConfiguration>
                    </smartFilterBar:SmartFilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <smartTable:SmartTable id="smartTable_BankPayFile" entitySet="BankPayFile" smartVariant="__SVM01" smartFilterId="SFBBankPayFile"
                tableType="Table" showRowCount="true" useVariantManagement="true" useTablePersonalisation="true"
                persistencyKey="BankPayFileTable" header="{i18n>Result}" enableAutoBinding="false"
                placeToolbarInTable="true" beforeRebindTable="onBeforeRebindTable"
                fitContainer="true" height="100%">

                <smartTable:customToolbar>
                    <OverflowToolbar id="toolbar" width="100%">
                        <ToolbarSpacer/>
                        <Label id="lblBankFormat" text="{i18n>BankFormat}" labelFor="BankFormatSelect" required="true"/>
                        <Select id="BankFormatSelect" selectedKey="1" width="10rem">
                            <core:Item key="1" text="1 - {i18n>BankGF}"/>
                            <core:Item key="2" text="2 - {i18n>BankBOC}"/>
                            <core:Item key="3" text="3 - {i18n>BankICBC}"/>
                            <core:Item key="4" text="4 - {i18n>BankMizuho}"/>
                        </Select>
                        <Button id="btnDownload" icon="sap-icon://download" text="{i18n>Download}" tooltip="{i18n>Download}" press="onDownload" enabled="{= ${local>/authorityCheck/button/Download} !== false}"/>
                    </OverflowToolbar>
                </smartTable:customToolbar>

                <t:Table id="Table_BankPayFile" selectionMode="MultiToggle" rowMode="Auto">
                    <t:Column id="CompanyCode" label="{i18n>CompanyCode}" width="6rem" sortProperty="CompanyCode" filterProperty="CompanyCode"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"CompanyCode","leadingProperty":"CompanyCode","sortProperty":"CompanyCode","filterProperty":"CompanyCode"}'/></t:customData><t:template><Text text="{CompanyCode}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="FiscalYear" label="{i18n>FiscalYear}" width="5rem" sortProperty="FiscalYear" filterProperty="FiscalYear"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"FiscalYear","leadingProperty":"FiscalYear","sortProperty":"FiscalYear","filterProperty":"FiscalYear"}'/></t:customData><t:template><Text text="{FiscalYear}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="PostingDate" label="{i18n>PostingDate}" width="8rem" sortProperty="PostingDate"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"PostingDate","leadingProperty":"PostingDate","sortProperty":"PostingDate"}'/></t:customData><t:template><Text text="{path:'PostingDate', formatter:'.formatter.date'}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="AccountingDocument" label="{i18n>AccountingDocument}" width="8rem" sortProperty="AccountingDocument" filterProperty="AccountingDocument"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"AccountingDocument","leadingProperty":"AccountingDocument","sortProperty":"AccountingDocument","filterProperty":"AccountingDocument"}'/></t:customData><t:template><Text text="{AccountingDocument}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="AccountingDocumentItem" label="{i18n>AccountingDocumentItem}" width="6rem" sortProperty="AccountingDocumentItem"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"AccountingDocumentItem","leadingProperty":"AccountingDocumentItem","sortProperty":"AccountingDocumentItem"}'/></t:customData><t:template><Text text="{AccountingDocumentItem}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="Supplier" label="{i18n>Supplier}" width="8rem" sortProperty="Supplier" filterProperty="Supplier"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"Supplier","leadingProperty":"Supplier","sortProperty":"Supplier","filterProperty":"Supplier"}'/></t:customData><t:template><Text text="{Supplier}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="PaymentRunDate" label="{i18n>PaymentRunDate}" width="8rem" sortProperty="PaymentRunDate"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"PaymentRunDate","leadingProperty":"PaymentRunDate","sortProperty":"PaymentRunDate"}'/></t:customData><t:template><Text text="{path:'PaymentRunDate', formatter:'.formatter.date'}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="PaymentRunID" label="{i18n>PaymentRunID}" width="7rem" sortProperty="PaymentRunID"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"PaymentRunID","leadingProperty":"PaymentRunID","sortProperty":"PaymentRunID"}'/></t:customData><t:template><Text text="{PaymentRunID}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="TransactionCurrency" label="{i18n>TransactionCurrency}" width="5rem" sortProperty="TransactionCurrency"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"TransactionCurrency","leadingProperty":"TransactionCurrency","sortProperty":"TransactionCurrency"}'/></t:customData><t:template><Text text="{TransactionCurrency}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="Amount" label="{i18n>Amount}" width="9rem" hAlign="End" sortProperty="Amount"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"Amount","leadingProperty":"Amount","sortProperty":"Amount"}'/></t:customData><t:template><Text text="{path:'Amount', formatter:'.formatter.amount'}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="PaymentMethod" label="{i18n>PaymentMethod}" width="6rem" sortProperty="PaymentMethod"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"PaymentMethod","leadingProperty":"PaymentMethod","sortProperty":"PaymentMethod"}'/></t:customData><t:template><Text text="{PaymentMethod}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="BaselineDate" label="{i18n>BaselineDate}" width="8rem" sortProperty="BaselineDate"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"BaselineDate","leadingProperty":"BaselineDate","sortProperty":"BaselineDate"}'/></t:customData><t:template><Text text="{path:'BaselineDate', formatter:'.formatter.date'}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="PaymentTerms" label="{i18n>PaymentTerms}" width="6rem" sortProperty="PaymentTerms"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"PaymentTerms","leadingProperty":"PaymentTerms","sortProperty":"PaymentTerms"}'/></t:customData><t:template><Text text="{PaymentTerms}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="NetDueDate" label="{i18n>NetDueDate}" width="8rem" sortProperty="NetDueDate"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"NetDueDate","leadingProperty":"NetDueDate","sortProperty":"NetDueDate"}'/></t:customData><t:template><Text text="{path:'NetDueDate', formatter:'.formatter.date'}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="HouseBank" label="{i18n>HouseBank}" width="6rem" sortProperty="HouseBank" filterProperty="HouseBank"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"HouseBank","leadingProperty":"HouseBank","sortProperty":"HouseBank","filterProperty":"HouseBank"}'/></t:customData><t:template><Text text="{HouseBank}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="HouseBankAccount" label="{i18n>HouseBankAccount}" width="7rem" sortProperty="HouseBankAccount"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"HouseBankAccount","leadingProperty":"HouseBankAccount","sortProperty":"HouseBankAccount"}'/></t:customData><t:template><Text text="{HouseBankAccount}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="HouseBankName" label="{i18n>HouseBankName}" width="12rem" sortProperty="HouseBankName"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"HouseBankName","leadingProperty":"HouseBankName","sortProperty":"HouseBankName"}'/></t:customData><t:template><Text text="{HouseBankName}" tooltip="{HouseBankName}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="HouseBankNumber" label="{i18n>HouseBankNumber}" width="9rem" sortProperty="HouseBankNumber"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"HouseBankNumber","leadingProperty":"HouseBankNumber","sortProperty":"HouseBankNumber"}'/></t:customData><t:template><Text text="{HouseBankNumber}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="PayerAccountNumber" label="{i18n>PayerAccountNumber}" width="11rem" sortProperty="PayerAccountNumber"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"PayerAccountNumber","leadingProperty":"PayerAccountNumber","sortProperty":"PayerAccountNumber"}'/></t:customData><t:template><Text text="{PayerAccountNumber}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="PayerAccountHolder" label="{i18n>PayerAccountHolder}" width="12rem" sortProperty="PayerAccountHolder"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"PayerAccountHolder","leadingProperty":"PayerAccountHolder","sortProperty":"PayerAccountHolder"}'/></t:customData><t:template><Text text="{PayerAccountHolder}" tooltip="{PayerAccountHolder}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="VendorBankAccount" label="{i18n>VendorBankAccount}" width="11rem" sortProperty="VendorBankAccount"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"VendorBankAccount","leadingProperty":"VendorBankAccount","sortProperty":"VendorBankAccount"}'/></t:customData><t:template><Text text="{VendorBankAccount}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="VendorBankAccountHolder" label="{i18n>VendorBankAccountHolder}" width="12rem" sortProperty="VendorBankAccountHolder"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"VendorBankAccountHolder","leadingProperty":"VendorBankAccountHolder","sortProperty":"VendorBankAccountHolder"}'/></t:customData><t:template><Text text="{VendorBankAccountHolder}" tooltip="{VendorBankAccountHolder}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="VendorBankName" label="{i18n>VendorBankName}" width="12rem" sortProperty="VendorBankName"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"VendorBankName","leadingProperty":"VendorBankName","sortProperty":"VendorBankName"}'/></t:customData><t:template><Text text="{VendorBankName}" tooltip="{VendorBankName}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="VendorBankInternalID" label="{i18n>VendorBankInternalID}" width="10rem" sortProperty="VendorBankInternalID"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"VendorBankInternalID","leadingProperty":"VendorBankInternalID","sortProperty":"VendorBankInternalID"}'/></t:customData><t:template><Text text="{VendorBankInternalID}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="VendorBankNumber" label="{i18n>VendorBankNumber}" width="9rem" sortProperty="VendorBankNumber"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"VendorBankNumber","leadingProperty":"VendorBankNumber","sortProperty":"VendorBankNumber"}'/></t:customData><t:template><Text text="{VendorBankNumber}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="TransferType" label="{i18n>TransferType}" width="6rem" sortProperty="TransferType"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"TransferType","leadingProperty":"TransferType","sortProperty":"TransferType"}'/></t:customData><t:template><Text text="{TransferType}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="ReceivingAccountType" label="{i18n>ReceivingAccountType}" width="7rem" sortProperty="ReceivingAccountType"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"ReceivingAccountType","leadingProperty":"ReceivingAccountType","sortProperty":"ReceivingAccountType"}'/></t:customData><t:template><Text text="{ReceivingAccountType}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="BankProvince" label="{i18n>BankProvince}" width="7rem" sortProperty="BankProvince"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"BankProvince","leadingProperty":"BankProvince","sortProperty":"BankProvince"}'/></t:customData><t:template><Text text="{BankProvince}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="BankCity" label="{i18n>BankCity}" width="8rem" sortProperty="BankCity"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"BankCity","leadingProperty":"BankCity","sortProperty":"BankCity"}'/></t:customData><t:template><Text text="{BankCity}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="PaymentDateYmd" label="{i18n>PaymentDateYmd}" width="10rem" sortProperty="PaymentDate"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"PaymentDateYmd","leadingProperty":"PaymentDate","sortProperty":"PaymentDate"}'/></t:customData><t:template><Text text="{path:'PaymentDate', formatter:'.formatter.dateYmd'}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="PaymentDateIso" label="{i18n>PaymentDateIso}" width="10rem" sortProperty="PaymentDate"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"PaymentDateIso","leadingProperty":"PaymentDate","sortProperty":"PaymentDate"}'/></t:customData><t:template><Text text="{path:'PaymentDate', formatter:'.formatter.dateIso'}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="Remarks" label="{i18n>Remarks}" width="7rem" sortProperty="Remarks"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"Remarks","leadingProperty":"Remarks","sortProperty":"Remarks"}'/></t:customData><t:template><Text text="{Remarks}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="DataSource" label="{i18n>DataSource}" width="6rem" visible="false"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"DataSource","leadingProperty":"DataSource"}'/></t:customData><t:template><Text text="{DataSource}" wrapping="false"/></t:template></t:Column>
                    <t:Column id="PaymentDate" label="{i18n>PaymentDate}" width="8rem" visible="false"><t:customData><core:CustomData key="p13nData" value='\{"columnKey":"PaymentDate","leadingProperty":"PaymentDate"}'/></t:customData><t:template><Text text="{path:'PaymentDate', formatter:'.formatter.date'}" wrapping="false"/></t:template></t:Column>
                </t:Table>
            </smartTable:SmartTable>
        </f:content>
    </f:DynamicPage>
</mvc:View>