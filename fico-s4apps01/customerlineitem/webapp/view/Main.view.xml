<mvc:View controllerName="fico.customerlineitem.controller.Main" displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified"
    xmlns:layout="sap.ui.layout"
    xmlns:table="sap.ui.table"
    xmlns:rm="sap.ui.table.rowmodes"
    xmlns:plugins="sap.ui.table.plugins"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:sv="sap.ui.comp.smartvariants"
    xmlns:smartTable="sap.ui.comp.smarttable" height="100%">
    <f:DynamicPage>
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <sv:SmartVariantManagement id="__SVM01" persistencyKey="CustomerLineItemSVM" showShare="true" showExecuteOnSelection="true" entitySet="CustomerLineItem"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader>
                <f:content>
                    <smartFilterBar:SmartFilterBar id="idSmartFilterBar" entitySet="CustomerLineItem" useToolbar="false" liveMode="false" smartVariant="__SVM01" persistencyKey="HeaderSFB" search="onSearch">
                        <smartFilterBar:controlConfiguration>
                            <smartFilterBar:ControlConfiguration index='10' key="Customer" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>Customer}"/>
                            <smartFilterBar:ControlConfiguration index='20' key="CompanyCode" mandatory="mandatory" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>CompanyCode}"/>
                            <smartFilterBar:ControlConfiguration index="30" key="Status" visibleInAdvancedArea="true" label="{i18n>Status}">
                                <smartFilterBar:customControl>
                                    <Select id="idStatus" selectedKey="{local>/Status}" change="onSelectModeChange">
                                        <core:Item key="01" text="{i18n>Status01}"/>
                                        <core:Item key="02" text="{i18n>Status02}"/>
                                        <core:Item key="02" text="{i18n>Status03}"/>
                                    </Select>
                                </smartFilterBar:customControl>
                            </smartFilterBar:ControlConfiguration>
                            <smartFilterBar:ControlConfiguration index='40' key="ClearingDate" label="{i18n>ClearingDate}" visibleInAdvancedArea="true">
                                <smartFilterBar:customControl>
                                    <DatePicker id="idClearDate" 
                                                valueFormat="yyyy-MM-dd" 
                                                displayFormat="yyyy/MM/dd" 
                                                value="{
                                                    path:'local>/ClearingDate',
                                                    type: 'sap.ui.model.type.Date', formatOptions: {UTC: true}
                                    }"/>
                                </smartFilterBar:customControl>
                            </smartFilterBar:ControlConfiguration>
                            <smartFilterBar:ControlConfiguration index='50' key="OpenDate" label="{i18n>OpenDate}" visibleInAdvancedArea="true">
                                <smartFilterBar:customControl>
                                    <DynamicDateRange id="idOpenDate" value="{local>/OpenDate}" 
                                        standardOptions="DATE,TODAY,YESTERDAY,TOMORROW,FIRSTDAYWEEK,LASTDAYWEEK,FIRSTDAYMONTH,LASTDAYMONTH,FIRSTDAYQUARTER,LASTDAYQUARTER,FIRSTDAYYEAR,LASTDAYYEAR"
                                    />
                                </smartFilterBar:customControl>
                            </smartFilterBar:ControlConfiguration>
                            <!-- visible -->
                            <smartFilterBar:ControlConfiguration index='999' key="FiscalYear" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="AccountingDocument" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="LedgerGLLineItem" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="FiscalPeriod" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="PostingDate" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="NetDueDate" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="ChartOfAccounts" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="AlternativeGLAccount" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="OffsettingAcct" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="AccountingDocumentType" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="DebitCreditCode" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="TransactionCurrency" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="DebitAmount" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="CreditAmount" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="AmountInFunctionalCurrency" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="FunctionalCurrency" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="AmountInCompanyCodeCurrency" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="CompanyCodeCurrency" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="DocumentItemText" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="AssignmentReference" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="ProfitCenter" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="ClearingAccountingDocument" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="ClearingDate" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="Type" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="UserEmail" visible="false"/>
                        </smartFilterBar:controlConfiguration>
                    </smartFilterBar:SmartFilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <smartTable:SmartTable id="idsmartTable" entitySet="CustomerLineItem" smartFilterId="idSmartFilterBar" smartVariant="__SVM01" tableType="Table" persistencyKey="smartTable" header="{i18n>Results}" 
                        placeToolbarInTable="true" showRowCount="true" beforeRebindTable="onBeforeRebindTable" beforeExport="onBeforeExport" ignoredFields="Status,OpenDate,UserEmail">
