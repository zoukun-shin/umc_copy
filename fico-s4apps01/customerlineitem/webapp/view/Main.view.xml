                    <table:Column  label="{i18n>Type}" width="4rem" sortProperty="Type" filterProperty="Type" >
                            <table:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"Type", "leadingProperty":"Type"}'/>
                            </table:customData>
                            <table:template>
                                <ObjectStatus state="{ path:'Type',formatter:'.formatter.formatState' }" icon="{ path:'Type', formatter:'.formatter.formatStateIcon'}"/>
                            </table:template>
                        </table:Column>
                    <table:Column width="8rem" label="{i18n>CompanyCode}" sortProperty="CompanyCode" filterProperty="CompanyCode">
                        <table:customData>
                            <core:CustomData key="p13nData" value='\{"columnKey":"CompanyCode", "leadingProperty":"CompanyCode"}'/>
                        </table:customData>
                        <table:template>
                            <Text text="{CompanyCode}" wrapping="false" tooltip="{CompanyCode}" />
                        </table:template>
                    </table:Column>
