<mvc:View controllerName="fico.aplist.controller.Main"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page showHeader="false" showFooter="false">
        <content>
            <IconTabBar
                id="idIconTabBar"
                expanded="{device>/isNoPhone}"
                stretchContentHeight="true"
                backgroundDesign="Transparent"
                applyContentPadding="false"
                class="sapUiNoContentPadding">
                <items>
                    <IconTabFilter text="{i18n>tabOpenAp}" key="OpenAp">
                        <mvc:XMLView viewName="fico.aplist.view.OpenAp" height="100%"/>
                    </IconTabFilter>
                    <IconTabFilter text="{i18n>tabAutoPay}" key="AutoPay">
                        <mvc:XMLView viewName="fico.aplist.view.AutoPay" height="100%"/>
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </content>
    </Page>
</mvc:View>
