<core:FragmentDefinition xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
    xmlns:table="sap.ui.table">
    <Dialog title="{i18n>Maintain}" draggable="true" stretch="true" class="sapUiSizeCompact">
        <Bar>
            <contentRight>
                <Button type="Ghost" icon="sap-icon://synchronize" text="{i18n>LoadDelivery}" press="onPressAction('LoadDelivery')" enabled="{= ${local>/authorityCheck/button/LoadDelivery} &amp;&amp; ${local>/Header/IsApproved} === false}"/>
                <Button type="Emphasized" icon="sap-icon://write-new-document" text="{i18n>WritePackageStructure}" press="onPressAction('WritePackageStructure')" enabled="{= ${local>/authorityCheck/button/WritePackageStructure} &amp;&amp; ${local>/Header/IsApproved} === false}"/>
                <Button type="Ghost" icon="sap-icon://simulate" text="{i18n>Recalculate}" press="onPressAction('Recalculate')" enabled="{= ${local>/authorityCheck/button/Recalculate} &amp;&amp; ${local>/Header/IsApproved} === false}"/>
                <Button type="Success" text="{i18n>Approve}" press="onPressAction('Approve')" enabled="{= ${local>/authorityCheck/button/Approve} &amp;&amp; ${local>/Header/IsExists} === true &amp;&amp; ${local>/Header/IsApproved} === false}"/>
                <Button type="Negative" text="{i18n>CancelApproval}" press="onPressAction('CancelApproval')" enabled="{= ${local>/authorityCheck/button/CancelApproval} &amp;&amp; ${local>/Header/IsApproved} === true}"/>
            </contentRight>
        </Bar>
        <Panel expandable="true" expanded="true" width="auto" headerText="{i18n>PanelTitle1}">
            <HBox>
                <VBox class="sapUiSmallMarginEnd">
                    <Label text="{i18n>SalesOrganization}:"/>
                    <Input value="{local>/Header/SalesOrganization} {local>/Header/SalesOrganizationName}" editable="false" width="20rem"/>
                    <Label text="{i18n>SoldToParty}:"/>
                    <Input value="{local>/Header/SoldToParty} {local>/Header/SoldToPartyName}" editable="false" width="20rem"/>
                    <Label text="{i18n>ShipToParty}:"/>
                    <Input value="{local>/Header/ShipToParty} {local>/Header/ShipToPartyName}" editable="false" width="20rem"/>
                </VBox>
                <VBox class="sapUiSmallMarginEnd">
                    <Label text="{i18n>ShippingType}:"/>
                    <ComboBox items="{ path: '/ZC_ShippingTypeVH' }" selectedKey="{local>/Header/ShippingType}" filterSecondaryValues= "true" required="true" width="13rem" editable="{local>/MaintainEditable}">
                        <core:ListItem key="{ShippingType}" text="{ShippingType}({ShippingTypeDesc})" additionalText="{ShippingType}"/>
                    </ComboBox>
                    <Label text="{i18n>StartBoxNumber}:" />
                    <Input value="{local>/Header/StartBoxNumber}" width="13rem" maxLength="6" liveChange="onLiveChangePositiveInteger" change="onPressAction('Recalculate')" editable="{local>/MaintainEditable}"/>
                    <Label text="{i18n>ContainerNumber}:" />
                    <Input value="{local>/Header/ContainerNumber}" width="13rem" maxLength="20" editable="{local>/MaintainEditable}"/>
                </VBox>
                <VBox class="sapUiSmallMarginEnd">
                    <Label text="{i18n>RequestedDeliveryDate}:"/>
                    <DatePicker width="12rem" editable="false" value="{
						'path':'local>/Header/RequestedDeliveryDate',
						'type':'sap.ui.model.type.Date',
						'formatOptions': {
							'pattern': 'yyyy/MM/dd',
                            'UTC':true
						} 
                    }"/>
                    <Label text="{i18n>PlannedGoodsMovementDate}:"/>
                    <DatePicker width="12rem" editable="{local>/MaintainEditable}" value="{
						'path':'local>/Header/PlannedGoodsMovementDate',
						'type':'sap.ui.model.type.Date',
						'formatOptions': {
							'pattern': 'yyyy/MM/dd',
                            'UTC':true
						} 
                    }"/>
                    <Label text="{i18n>TruckNumber}:"/>
                    <Input value="{local>/Header/TruckNumber}" width="12rem" maxLength="20" editable="{local>/MaintainEditable}"/>
                </VBox>
                <VBox class="sapUiSmallMarginEnd">
                    <Label text="{i18n>PlannedGoodsIssueDate}:"/>
                    <DatePicker width="12rem" editable="{local>/MaintainEditable}" value="{
						'path':'local>/Header/PlannedGoodsIssueDate',
						'type':'sap.ui.model.type.Date',
						'formatOptions': {
							'pattern': 'yyyy/MM/dd',
                            'UTC':true
						}
                    }"/>
                    <Label text="{i18n>PlannedCustomsDeclarationDate}:"/>
                    <DatePicker width="12rem" editable="{local>/MaintainEditable}" value="{
						'path':'local>/Header/PlannedCustomsDeclarationDate',
						'type':'sap.ui.model.type.Date',
						'formatOptions': {
							'pattern': 'yyyy/MM/dd',
                            'UTC':true
						} 
                    }"/>
                    <Label text="{i18n>Driver}:"/>
                    <Input value="{local>/Header/Driver}" width="12rem" maxLength="20" editable="{local>/MaintainEditable}"/>
                </VBox>
                <VBox class="sapUiSmallMarginEnd">
                    <HBox>
                        <VBox class="sapUiSmallMarginEnd">
                            <Label text="{i18n>IsApproved}:" width="5rem"/>
                            <CheckBox selected="{local>/Header/IsApproved}" editable="false"/>
                        </VBox>
                        <VBox>
                            <Label text="{i18n>ApproverName}:"/>
                            <Input value="{local>/Header/ApproverName}" width="15rem" editable="false"/>
                        </VBox>
                    </HBox>
                    <HBox>
                        <VBox class="sapUiSmallMarginEnd">
                            <Label text="{i18n>IncotermsClassification}:" />
                            <Input value="{local>/Header/IncotermsClassification}" editable="false" width="5rem"/>
                        </VBox>
                        <VBox>
                            <Label text="{i18n>IncotermsTransferLocation}:"/>
                            <Input value="{local>/Header/IncotermsTransferLocation}" editable="{local>/MaintainEditable}" maxLength="28" width="15rem"/>
                        </VBox>
                    </HBox>
                    <HBox>
                        <VBox class="sapUiSmallMarginEnd">
                            <Label text="{i18n>Remarks}:"/>
                            <TextArea value="{local>/Header/Remarks}" width="21rem" maxLength="100" rows="2" editable="{local>/MaintainEditable}"/>
                        </VBox>
                    </HBox>
                </VBox>
            </HBox>
        </Panel>
