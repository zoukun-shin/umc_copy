<mvc:View controllerName="sd.deliverynoteprint.controller.Main" displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified"
    xmlns:layout="sap.ui.layout"
    xmlns:table="sap.ui.table"
    xmlns:rm="sap.ui.table.rowmodes"
    xmlns:plugins="sap.ui.table.plugins"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:sv="sap.ui.comp.smartvariants"
    xmlns:smartTable="sap.ui.comp.smarttable" height="100%" busyIndicatorDelay="0">
    <f:DynamicPage >
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <sv:SmartVariantManagement id="__SVM01" persistencyKey="DeliverynoteprintSVM" showShare="true" showExecuteOnSelection="true" entitySet="FGLabel"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader>
                <f:content>
                    <smartFilterBar:SmartFilterBar id="idSmartFilterBar" entitySet="DeliveryNote" useToolbar="false" liveMode="false" smartVariant="__SVM01" persistencyKey="ListSFB" search="onSearch">
                        <smartFilterBar:controlConfiguration>
                            <smartFilterBar:ControlConfiguration index='10' key="Plant" mandatory="mandatory" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>Plant}" controlType="dropDownList"/>
                            <smartFilterBar:ControlConfiguration index='20' key="BillingDocument" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>BillingDocument}"/>
                            <smartFilterBar:ControlConfiguration index='30' key="FileNo" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>FileNo}"/>                        
                            <!-- check box -->
                            <smartFilterBar:ControlConfiguration index='40' key="PartsShipping"   visible="false"/>
                            <!-- visible -->
                            <smartFilterBar:ControlConfiguration index='999' key="PurchaseOrderByCustomer" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="SalesDocument" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="OutboundDelivery" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="Material" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="SalesDocumentItemText" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="PerBoxTargetQty" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="BoxQty" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="ActualDeliveryQuantity" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="OrderQuantity" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="SalesDocumentItem" visible="false"/>
                        </smartFilterBar:controlConfiguration>
                    </smartFilterBar:SmartFilterBar>
                </f:content>
                <f:content>
                    <CheckBox id='idCB1' text="{i18n>PartsShipping}" width="11rem" select="onSelect"/>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <smartTable:SmartTable id="idsmartTable" entitySet="DeliveryNote" smartFilterId="idSmartFilterBar" smartVariant="__SVM01" tableType="Table" persistencyKey="smartTable" header="{i18n>Results}" 
                        placeToolbarInTable="true" showRowCount="true" beforeRebindTable="onBeforeRebindTable" beforeExport="onBeforeExport" requestAtLeastFields="PartsShipping"  ignoredFields="">
                <smartTable:customToolbar>
                    <OverflowToolbar design="Transparent">
                    <ToolbarSpacer/>
                    <Button id="idPrintNMBtn" icon="sap-icon://print" type="Transparent" text="{i18n>PrtNMBtn}" press=".onPrintNM" enabled="{= ${local>/authorityCheck/button/PrintNM}}"/>
                    <Button id="idPrintFJBtn" icon="sap-icon://print" type="Transparent" text="{i18n>PrtFJBtn}" press=".onPrintFJ" enabled="{= ${local>/authorityCheck/button/PrintFJ}}"/>
                    <Button id="idPrintQTBtn" icon="sap-icon://print" type="Transparent" text="{i18n>PrtQTBtn}" press=".onPrintQT" enabled="{= ${local>/authorityCheck/button/PrintQT}}"/>
                    </OverflowToolbar>
                </smartTable:customToolbar>
                <table:Table id="ReportTable" columnResize="onAfterRendering" columnMove="onAfterRendering">
                    <table:dependents>
						<plugins:MultiSelectionPlugin
							id="idMultiSelectionPlugin"
							limit="0"
							enableNotification="true"
							showHeaderSelector="true"
							selectionMode="Single"
						/>
					</table:dependents>
                    <table:rowMode>
                        <rm:Auto id="idAuto" />
                    </table:rowMode>
                    <table:columns>
                        <table:Column width="6rem" label="{i18n>Plant}" sortProperty="Plant" filterProperty="Plant">
                            <table:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"Plant", "leadingProperty":"Plant"}'/>
                            </table:customData>
                            <table:template>
                                <Text text="{Plant}" wrapping="false" />
                            </table:template>
                        </table:Column>
                        <table:Column width="10rem" label="{i18n>BillingDocument}" sortProperty="BillingDocument" filterProperty="BillingDocument">
                            <table:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"BillingDocument", "leadingProperty":"BillingDocument"}'/>
                            </table:customData>
                            <table:template>
                                <Text text="{BillingDocument}" wrapping="false" />
                            </table:template>
                        </table:Column>
                        <table:Column width="10rem" label="{i18n>FileNo}" sortProperty="FileNo" filterProperty="FileNo">
                            <table:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"FileNo", "leadingProperty":"FileNo"}'/>
                            </table:customData>
                            <table:template>
                                <Text text="{FileNo}" wrapping="false" />
                            </table:template>
                        </table:Column>
                        <table:Column width="10rem" label="{i18n>PurchaseOrderByCustomer}" sortProperty="PurchaseOrderByCustomer" filterProperty="PurchaseOrderByCustomer">
                            <table:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"PurchaseOrderByCustomer", "leadingProperty":"PurchaseOrderByCustomer"}'/>
                            </table:customData>
                            <table:template>
                                <Text text="{PurchaseOrderByCustomer}" wrapping="false" />
                            </table:template>
                        </table:Column>
                        <table:Column width="14rem" label="{i18n>SalesDocument}" sortProperty="SalesDocument" filterProperty="SalesDocument">
                            <table:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"SalesDocument", "leadingProperty":"SalesDocument"}'/>
                            </table:customData>
                            <table:template>
                                <Text text="{SalesDocument}" wrapping="false" tooltip="{SalesDocument}"/>
                            </table:template>
                        </table:Column>
                        <table:Column width="10rem" label="{i18n>OutboundDelivery}" sortProperty="OutboundDelivery" filterProperty="OutboundDelivery">
                            <table:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"OutboundDelivery", "leadingProperty":"OutboundDelivery"}'/>
                            </table:customData>
                            <table:template>
                                <Text text="{OutboundDelivery}" wrapping="false" tooltip="{OutboundDelivery}"/>
                            </table:template>
                        </table:Column>
                        <table:Column width="10rem" label="{i18n>Material}" sortProperty="Material" filterProperty="Material">
                            <table:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"Material", "leadingProperty":"Material"}'/>
                            </table:customData>
                            <table:template>
                                <Text text="{Material}" wrapping="false" tooltip="{Material}"/>
                            </table:template>
                        </table:Column>
                        <table:Column width="10rem" label="{i18n>SalesDocumentItemText}" sortProperty="SalesDocumentItemText" filterProperty="SalesDocumentItemText">
                            <table:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"SalesDocumentItemText", "leadingProperty":"SalesDocumentItemText"}'/>
                            </table:customData>
                            <table:template>
                                <Text text="{SalesDocumentItemText}" wrapping="false" tooltip="{SalesDocumentItemText}"/>
                            </table:template>
                        </table:Column>
                        <table:Column width="10rem" label="{i18n>PerBoxTargetQty}" sortProperty="PerBoxTargetQty" filterProperty="PerBoxTargetQty">
                            <table:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"PerBoxTargetQty", "leadingProperty":"PerBoxTargetQty"}'/>
                            </table:customData>
                            <table:template>
                                <Text text="{PerBoxTargetQty}" wrapping="false" tooltip="{PerBoxTargetQty}"/>
                            </table:template>
                        </table:Column>
                        <table:Column width="10rem" label="{i18n>BoxQty}" sortProperty="BoxQty" filterProperty="BoxQty">
                            <table:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"BoxQty", "leadingProperty":"BoxQty"}'/>
                            </table:customData>
                            <table:template>
                                <Text text="{BoxQty}" wrapping="false" tooltip="{BoxQty}"/>
                            </table:template>
                        </table:Column>
                        <table:Column width="10rem" label="{i18n>ActualDeliveryQuantity}" sortProperty="ActualDeliveryQuantity" filterProperty="ActualDeliveryQuantity">
                            <table:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"ActualDeliveryQuantity", "leadingProperty":"ActualDeliveryQuantity"}'/>
                            </table:customData>
                            <table:template>
                                <Text text="{ActualDeliveryQuantity}" wrapping="false" tooltip="{ActualDeliveryQuantity}"/>
                            </table:template>
                        </table:Column>
                        <table:Column width="10rem" label="{i18n>OrderQuantity}" sortProperty="OrderQuantity" filterProperty="OrderQuantity">
                            <table:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"OrderQuantity", "leadingProperty":"OrderQuantity"}'/>
                            </table:customData>
                            <table:template>
                                <Text text="{OrderQuantity}" wrapping="false" tooltip="{OrderQuantity}"/>
                            </table:template>
                        </table:Column>
                        <table:Column width="10rem" label="{i18n>SalesDocumentItem}" sortProperty="SalesDocumentItem" filterProperty="SalesDocumentItem">
                            <table:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"SalesDocumentItem", "leadingProperty":"SalesDocumentItem"}'/>
                            </table:customData>
                            <table:template>
                                <Text text="{SalesDocumentItem}" wrapping="false" tooltip="{SalesDocumentItem}"/>
                            </table:template>
                        </table:Column>
                        <table:Column width="10rem" label="{i18n>PartsShipping}" sortProperty="PartsShipping" filterProperty="PartsShipping" visible="false">
                            <table:customData>
                                <core:CustomData key="p13nData" value='\{"columnKey":"PartsShipping", "leadingProperty":"PartsShipping"}'/>
                            </table:customData>
                            <table:template>
                                <Text text="{PartsShipping}" wrapping="false"/>
                            </table:template>
                        </table:Column>
                    </table:columns>
                </table:Table>
            </smartTable:SmartTable>
        </f:content>
    </f:DynamicPage>
</mvc:View>