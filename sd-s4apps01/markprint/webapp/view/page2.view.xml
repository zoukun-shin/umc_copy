<mvc:View controllerName="sd.markprint.controller.page2"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns="sap.m"
    xmlns:unified="sap.ui.unified"
    xmlns:upload="sap.m.upload"
    xmlns:table="sap.ui.table">
    <Page >
        <content>
            <Panel expandable="true" expanded="false" headerText="{i18n>templateText}" width="auto">
                <upload:UploadSet id="idTemplateCollection" items="{ path : 'Attach>/Configuration' }" multiple="true" uploadEnabled="false" uploadButtonInvisible="true" instantUpload="false">
                    <upload:items>
                        <upload:UploadSetItem fileName="{Attach>TemplateName}" mediaType="{Attach>TemplateMimeType}" url="{Attach>TemplateContent}" visibleEdit="false" visibleRemove="false"/>
                    </upload:items>
                </upload:UploadSet>
            </Panel>
            <Panel id="idFileUploadPanel" expandable="true" expanded="true" headerText="{i18n>uploadText}" width="auto">
                <unified:FileUploader id="idFileUploader" fileType="xlsx,xls" change="onFileChange" width="40%" class="sapUiSmallMargin"/>
            </Panel>
            <Panel expandable="true" expanded="true" headerText="{i18n>result}" width="auto">
                <table:Table rows="{local>/excelSet}" selectionMode="Multi" fixedColumnCount="2" rowMode="Interactive" class="sapUiSizeCompact">
                    <table:extension>
                        <OverflowToolbar>
                            <Text text="{local>/logInfo}"/>
                            <ToolbarSpacer/>
                            <Button id="idClearButton" icon="sap-icon://clear-all" type="Transparent" text="{i18n>clearBtn}" press="onClear" visible="{= ${local>/excelSet}.length > 0}" enabled="{= ${local>/authorityCheck/button/Clear}}"/>
                            <Button id="idCheckButton" icon="sap-icon://check-availability" type="Transparent" text="{i18n>checkBtn}" press="onCheck" visible="{= ${local>/excelSet}.length > 0}" enabled="{= ${local>/authorityCheck/button/Check}}"/>
                            <Button id="idExcuteButton" icon="sap-icon://document" type="Transparent" text="{i18n>excuteBtn}" press="onExcute" visible="{= ${local>/excelSet}.length > 0}" enabled="{= ${local>/authorityCheck/button/Execute}}"/>
                            <Button id="idExportButton" icon="sap-icon://excel-attachment" type="Transparent" text="{i18n>exportBtn}" press="onExport" visible="{= ${local>/excelSet}.length > 0}" enabled="{= ${local>/authorityCheck/button/Export}}"/>
                        </OverflowToolbar>
                    </table:extension>
                    <table:columns>
                        <table:Column autoResizable="true" width="6rem" label="{i18n>Status}">
                            <table:template>
                                <ObjectStatus state="{ path:'local>Status',formatter:'.formatter.formatState' }" icon="{ path:'local>Status', formatter:'.formatter.formatStateIcon'}"/>
                            </table:template>
                        </table:Column>
                        <table:Column width="15rem" label="{i18n>Message}">
                            <table:template>
                                <Text text="{local>Message}" wrapping="false"/>
                            </table:template>
                        </table:Column>
                        
                        <table:Column width="10rem" label="{i18n>SALESORGANIZATION}">
                            <table:template>
                                <Text text="{local>SALESORGANIZATION}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <table:Column width="10rem" label="{i18n>DISTRIBUTIONCHANNEL}">
                            <table:template>
                                <Text text="{local>DISTRIBUTIONCHANNEL}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <table:Column width="10rem" label="{i18n>Customer}">
                            <table:template>
                                <Text text="{local>Customer}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <table:Column width="10rem" label="{i18n>Product}">
                            <table:template>
                                <Text text="{local>Product}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <table:Column width="10rem" label="{i18n>MATERIALBYCUSTOMER}">
                            <table:template>
                                <Text text="{local>MATERIALBYCUSTOMER}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <table:Column width="10rem" label="{i18n>AdditionalCustomerMaterial}">
                            <table:template>
                                <Text text="{local>AdditionalCustomerMaterial}" wrapping="false"/>
                            </table:template>
                        </table:Column>

                        <table:Column width="10rem" label="{i18n>AdditionalCustomerMaterialText}">
                            <table:template>
                                <Text text="{local>AdditionalCustomerMaterialText}" wrapping="false"/>
                            </table:template>
                        </table:Column>
                    </table:columns>
                </table:Table>
            </Panel>
        </content>
    </Page>
</mvc:View>
