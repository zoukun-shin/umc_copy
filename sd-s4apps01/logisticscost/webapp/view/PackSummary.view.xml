                        id="idSFBPackSummary"
                        smartVariant="idSVMPackSummary"
                        persistencyKey="packSummaryFilter"
                        entitySet="PackSummary"
                        useToolbar="false"
                        class="sapUiResponsiveMargin"
                    >
                        <smartFilterBar:controlConfiguration>
                            <smartFilterBar:ControlConfiguration
                                key="BillingDocument"
                                visibleInAdvancedArea="true"
                                label="{/#PackSummaryType/BillingDocument/@sap:label}"
                                mandatory="notMandatory"
                                index="1"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="SoldToParty"
                                visibleInAdvancedArea="true"
                                label="{/#PackSummaryType/SoldToParty/@sap:label}"
                                mandatory="notMandatory"
                                index="3"
                            />
