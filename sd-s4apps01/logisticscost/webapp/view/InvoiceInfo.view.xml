<mvc:View
    controllerName="sd.logisticscost.controller.InvoiceInfo"
    displayBlock="true"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:t="sap.ui.table"
    xmlns:rm="sap.ui.table.rowmodes"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:sv="sap.ui.comp.smartvariants"
    height="100%"
    busyIndicatorDelay="0"
>
    <f:DynamicPage
        id="idDPInvoiceInfo"
        showFooter="true"
    >
        <f:title>
            <f:DynamicPageTitle id="idDPTInvoiceInfo">
                <f:heading>
                    <sv:SmartVariantManagement
                        id="idSVMInvoiceInfo"
                        showShare="true"
                        persistencyKey="invoiceInfoVariant"
                        showExecuteOnSelection="true"
                        entitySet="InvoiceInfo"
                    />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader id="idDPHInvoiceInfo">
                <f:content>
                    <smartFilterBar:SmartFilterBar
                        id="idSFBInvoiceInfo"
                        smartVariant="idSVMInvoiceInfo"
                        persistencyKey="invoiceInfoFilter"
                        entitySet="InvoiceInfo"
                        useToolbar="false"
                        class="sapUiResponsiveMargin"
                    >
                        <smartFilterBar:controlConfiguration>
                            <smartFilterBar:ControlConfiguration
                                key="BillingDocument"
                                visibleInAdvancedArea="true"
                                label="{/#InvoiceInfoType/BillingDocument/@sap:label}"
                                mandatory="notMandatory"
                                index="1"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="SoldToParty"
                                visibleInAdvancedArea="true"
                                label="{/#InvoiceInfoType/SoldToParty/@sap:label}"
                                mandatory="notMandatory"
                                index="3"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="PlannedGoodsIssueDate"
                                visibleInAdvancedArea="true"
                                label="{/#InvoiceInfoType/PlannedGoodsIssueDate/@sap:label}"
                                mandatory="notMandatory"
                                index="5"
                            >
                                <smartFilterBar:customControl>
                                    <DateRangeSelection
                                        id="idDRPlannedGoodsIssueDate"
                                        valueFormat="yyyy/MM/dd"
                                        displayFormat="yyyy/MM/dd"
                                    />
                                </smartFilterBar:customControl>
                            </smartFilterBar:ControlConfiguration>
                            <smartFilterBar:ControlConfiguration
                                key="InvoiceNo"
                                visibleInAdvancedArea="true"
                                label="{/#InvoiceInfoType/InvoiceNo/@sap:label}"
                                mandatory="notMandatory"
                                index="7"
                            />
                        </smartFilterBar:controlConfiguration>
                    </smartFilterBar:SmartFilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <smartTable:SmartTable
                id="idSmartTableInvoiceInfo"
                entitySet="InvoiceInfo"
                smartFilterId="idSFBInvoiceInfo"
                smartVariant="idSVMInvoiceInfo"
                persistencyKey="invoiceInfoSmartTable"
                placeToolbarInTable="true"
                beforeRebindTable="onBeforeRebindTable"
                header="{i18n>tableHeaderInvoiceInfo}"
                ignoredFields=""
                requestAtLeastFields="BillingDocument,InvoiceNo"
            >
                <t:Table
                    id="reportTableInvoiceInfo"
                    selectionMode="Multi"
                    class="sapUiSizeCompact"
                >
                    <t:rowMode>
                        <rm:Auto id="idAutoInvoiceInfo" />
                    </t:rowMode>
                    <t:columns>
                        <t:Column
                            width="8rem"
                            label="{/#InvoiceInfoType/BillingDocument/@sap:label}"
                            sortProperty="BillingDocument"
                            filterProperty="BillingDocument"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"BillingDocument","leadingProperty":"BillingDocument","sortProperty":"BillingDocument","filterProperty":"BillingDocument"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text text="{BillingDocument}" wrapping="false" />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="8rem"
                            label="{/#InvoiceInfoType/InvoiceNo/@sap:label}"
                            sortProperty="InvoiceNo"
                            filterProperty="InvoiceNo"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"InvoiceNo","leadingProperty":"InvoiceNo","sortProperty":"InvoiceNo","filterProperty":"InvoiceNo"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text text="{InvoiceNo}" wrapping="false" />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="10rem"
                            label="{/#InvoiceInfoType/PlannedGoodsIssueDate/@sap:label}"
                            sortProperty="PlannedGoodsIssueDate"
                            filterProperty="PlannedGoodsIssueDate"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"PlannedGoodsIssueDate","leadingProperty":"PlannedGoodsIssueDate","sortProperty":"PlannedGoodsIssueDate","filterProperty":"PlannedGoodsIssueDate","type":"date"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text text="{path:'PlannedGoodsIssueDate', type:'sap.ui.model.type.Date'}" />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="10rem"
                            label="{/#InvoiceInfoType/PlannedCustomsDeclDate/@sap:label}"
                            sortProperty="PlannedCustomsDeclDate"
                            filterProperty="PlannedCustomsDeclDate"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"PlannedCustomsDeclDate","leadingProperty":"PlannedCustomsDeclDate","sortProperty":"PlannedCustomsDeclDate","filterProperty":"PlannedCustomsDeclDate","type":"date"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text text="{path:'PlannedCustomsDeclDate', type:'sap.ui.model.type.Date'}" />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="10rem"
                            label="{/#InvoiceInfoType/PlannedGoodsMovementDate/@sap:label}"
                            sortProperty="PlannedGoodsMovementDate"
                            filterProperty="PlannedGoodsMovementDate"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"PlannedGoodsMovementDate","leadingProperty":"PlannedGoodsMovementDate","sortProperty":"PlannedGoodsMovementDate","filterProperty":"PlannedGoodsMovementDate","type":"date"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text text="{path:'PlannedGoodsMovementDate', type:'sap.ui.model.type.Date'}" />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="8rem"
                            label="{/#InvoiceInfoType/OutboundDelivery/@sap:label}"
                            sortProperty="OutboundDelivery"
                            filterProperty="OutboundDelivery"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"OutboundDelivery","leadingProperty":"OutboundDelivery","sortProperty":"OutboundDelivery","filterProperty":"OutboundDelivery"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text text="{OutboundDelivery}" wrapping="false" />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="8rem"
                            label="{/#InvoiceInfoType/InvoiceNumber/@sap:label}"
                            sortProperty="InvoiceNumber"
                            filterProperty="InvoiceNumber"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"InvoiceNumber","leadingProperty":"InvoiceNumber","sortProperty":"InvoiceNumber","filterProperty":"InvoiceNumber"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text text="{InvoiceNumber}" wrapping="false" />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="8rem"
                            label="{/#InvoiceInfoType/DNStatus/@sap:label}"
                            sortProperty="DNStatus"
                            filterProperty="DNStatus"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"DNStatus","leadingProperty":"DNStatus","sortProperty":"DNStatus","filterProperty":"DNStatus"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text text="{DNStatus}" wrapping="false" />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="8rem"
                            label="{/#InvoiceInfoType/BillToParty/@sap:label}"
                            sortProperty="BillToParty"
                            filterProperty="BillToParty"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"BillToParty","leadingProperty":"BillToParty","sortProperty":"BillToParty","filterProperty":"BillToParty"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text text="{BillToParty}" wrapping="false" />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="14rem"
                            label="{/#InvoiceInfoType/DNStatusDesc/@sap:label}"
                            sortProperty="DNStatusDesc"
                            filterProperty="DNStatusDesc"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"DNStatusDesc","leadingProperty":"DNStatusDesc","sortProperty":"DNStatusDesc","filterProperty":"DNStatusDesc"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text text="{DNStatusDesc}" wrapping="false" tooltip="{DNStatusDesc}" />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="6rem"
                            label="{/#InvoiceInfoType/Plant/@sap:label}"
                            sortProperty="Plant"
                            filterProperty="Plant"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"Plant","leadingProperty":"Plant","sortProperty":"Plant","filterProperty":"Plant"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text text="{Plant}" wrapping="false" />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="8rem"
                            label="{/#InvoiceInfoType/SalesDocumentType/@sap:label}"
                            sortProperty="SalesDocumentType"
                            filterProperty="SalesDocumentType"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"SalesDocumentType","leadingProperty":"SalesDocumentType","sortProperty":"SalesDocumentType","filterProperty":"SalesDocumentType"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text text="{SalesDocumentType}" wrapping="false" />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="14rem"
                            label="{/#InvoiceInfoType/PlantName/@sap:label}"
                            sortProperty="PlantName"
                            filterProperty="PlantName"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"PlantName","leadingProperty":"PlantName","sortProperty":"PlantName","filterProperty":"PlantName"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text text="{PlantName}" wrapping="false" tooltip="{PlantName}" />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="14rem"
                            label="{/#InvoiceInfoType/SalesDocumentTypeName/@sap:label}"
                            sortProperty="SalesDocumentTypeName"
                            filterProperty="SalesDocumentTypeName"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"SalesDocumentTypeName","leadingProperty":"SalesDocumentTypeName","sortProperty":"SalesDocumentTypeName","filterProperty":"SalesDocumentTypeName"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text text="{SalesDocumentTypeName}" wrapping="false" tooltip="{SalesDocumentTypeName}" />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="14rem"
                            label="{/#InvoiceInfoType/BillToPartyName/@sap:label}"
                            sortProperty="BillToPartyName"
                            filterProperty="BillToPartyName"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"BillToPartyName","leadingProperty":"BillToPartyName","sortProperty":"BillToPartyName","filterProperty":"BillToPartyName"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text text="{BillToPartyName}" wrapping="false" tooltip="{BillToPartyName}" />
                            </t:template>
                        </t:Column>
                    </t:columns>
                </t:Table>
            </smartTable:SmartTable>
        </f:content>
    </f:DynamicPage>
</mvc:View>
