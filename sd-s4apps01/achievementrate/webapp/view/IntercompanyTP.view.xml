<mvc:View
    controllerName="sd.achievementrate.controller.IntercompanyTP"
    displayBlock="true"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:t="sap.ui.table"
    xmlns:rm="sap.ui.table.rowmodes"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:sv="sap.ui.comp.smartvariants"
    height="100%"
    busyIndicatorDelay="0"
>
    <f:DynamicPage
        id="idDPTab2"
        showFooter="true"
    >
        <f:title>
            <f:DynamicPageTitle id="idDPTTab2">
                <f:heading>
                    <sv:SmartVariantManagement
                        id="idSVMTab2"
                        showShare="true"
                        persistencyKey="intercompanyTPVariant"
                        showExecuteOnSelection="true"
                        entitySet="IntercompanyTP"
                    />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader id="idDPHTab2">
                <f:content>
                    <smartFilterBar:SmartFilterBar
                        id="idSFBTab2"
                        smartVariant="idSVMTab2"
                        persistencyKey="intercompanyTPFilter"
                        entitySet="IntercompanyTP"
                        useToolbar="false"
                        class="sapUiResponsiveMargin"
                    >
                        <smartFilterBar:controlConfiguration>
                            <smartFilterBar:ControlConfiguration
                                key="Plant"
                                visibleInAdvancedArea="true"
                                label="{/#IntercompanyTPType/Plant/@sap:label}"
                                mandatory="notMandatory"
                                index="1"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="Product"
                                visibleInAdvancedArea="true"
                                label="{/#IntercompanyTPType/Product/@sap:label}"
                                mandatory="notMandatory"
                                index="3"
                            />
                        </smartFilterBar:controlConfiguration>
                    </smartFilterBar:SmartFilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <smartTable:SmartTable
                id="idSmartTableTab2"
                entitySet="IntercompanyTP"
                smartFilterId="idSFBTab2"
                smartVariant="idSVMTab2"
                persistencyKey="intercompanyTPSmartTable"
                placeToolbarInTable="true"
                beforeRebindTable="onBeforeRebindTable"
                header="{i18n>tableHeaderTitle2}"
                requestAtLeastFields="OutboundDelivery,OutboundDeliveryItem"
            >
                <t:Table
                    id="reportTable2"
                    selectionMode="Multi"
                    class="sapUiSizeCompact"
                >
                    <t:rowMode>
                        <rm:Auto id="idAuto2" />
                    </t:rowMode>
                    <t:columns>
                        <t:Column
                            width="6rem"
                            label="{/#IntercompanyTPType/Plant/@sap:label}"
                            sortProperty="Plant"
                            filterProperty="Plant"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"Plant","leadingProperty":"Plant","sortProperty":"Plant","filterProperty":"Plant"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{Plant}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="10rem"
                            label="{/#IntercompanyTPType/Product/@sap:label}"
                            sortProperty="Product"
                            filterProperty="Product"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"Product","leadingProperty":"Product","sortProperty":"Product","filterProperty":"Product"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{Product}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="8rem"
                            label="{/#IntercompanyTPType/SoldToParty/@sap:label}"
                            sortProperty="SoldToParty"
                            filterProperty="SoldToParty"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"SoldToParty","leadingProperty":"SoldToParty","sortProperty":"SoldToParty","filterProperty":"SoldToParty"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{SoldToParty}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="12rem"
                            label="{/#IntercompanyTPType/CustomerName/@sap:label}"
                            sortProperty="CustomerName"
                            filterProperty="CustomerName"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"CustomerName","leadingProperty":"CustomerName","sortProperty":"CustomerName","filterProperty":"CustomerName"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{CustomerName}"
                                    wrapping="false"
                                    tooltip="{CustomerName}"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="10rem"
                            label="{/#IntercompanyTPType/OutboundDelivery/@sap:label}"
                            sortProperty="OutboundDelivery"
                            filterProperty="OutboundDelivery"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"OutboundDelivery","leadingProperty":"OutboundDelivery","sortProperty":"OutboundDelivery","filterProperty":"OutboundDelivery"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{OutboundDelivery}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="6rem"
                            label="{/#IntercompanyTPType/OutboundDeliveryItem/@sap:label}"
                            sortProperty="OutboundDeliveryItem"
                            filterProperty="OutboundDeliveryItem"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"OutboundDeliveryItem","leadingProperty":"OutboundDeliveryItem","sortProperty":"OutboundDeliveryItem","filterProperty":"OutboundDeliveryItem"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{OutboundDeliveryItem}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="10rem"
                            label="{/#IntercompanyTPType/PurchaseOrderNo/@sap:label}"
                            sortProperty="PurchaseOrderNo"
                            filterProperty="PurchaseOrderNo"
                            visible="false"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"PurchaseOrderNo","leadingProperty":"PurchaseOrderNo","sortProperty":"PurchaseOrderNo","filterProperty":"PurchaseOrderNo"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{PurchaseOrderNo}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="6rem"
                            label="{/#IntercompanyTPType/PurchaseOrderItem/@sap:label}"
                            sortProperty="PurchaseOrderItem"
                            filterProperty="PurchaseOrderItem"
                            visible="false"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"PurchaseOrderItem","leadingProperty":"PurchaseOrderItem","sortProperty":"PurchaseOrderItem","filterProperty":"PurchaseOrderItem"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{PurchaseOrderItem}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="10rem"
                            hAlign="Right"
                            label="{/#IntercompanyTPType/DeliveryQty/@sap:label}"
                            sortProperty="DeliveryQty"
                            filterProperty="DeliveryQty"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"DeliveryQty","leadingProperty":"DeliveryQty","sortProperty":"DeliveryQty","filterProperty":"DeliveryQty"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{path:'DeliveryQty', type:'sap.ui.model.odata.type.Decimal'}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="9rem"
                            label="{/#IntercompanyTPType/DeliveryDate/@sap:label}"
                            sortProperty="DeliveryDate"
                            filterProperty="DeliveryDate"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"DeliveryDate","leadingProperty":"DeliveryDate","sortProperty":"DeliveryDate","filterProperty":"DeliveryDate","type":"date"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{path:'DeliveryDate', type:'sap.ui.model.type.Date'}"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="10rem"
                            hAlign="Right"
                            label="{/#IntercompanyTPType/UnitPrice/@sap:label}"
                            sortProperty="UnitPrice"
                            filterProperty="UnitPrice"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"UnitPrice","leadingProperty":"UnitPrice","sortProperty":"UnitPrice","filterProperty":"UnitPrice"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{path:'UnitPrice', type:'sap.ui.model.odata.type.Decimal'}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="10rem"
                            hAlign="Right"
                            label="{/#IntercompanyTPType/TransferPrice/@sap:label}"
                            sortProperty="TransferPrice"
                            filterProperty="TransferPrice"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"TransferPrice","leadingProperty":"TransferPrice","sortProperty":"TransferPrice","filterProperty":"TransferPrice"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{path:'TransferPrice', type:'sap.ui.model.odata.type.Decimal'}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="12rem"
                            hAlign="Right"
                            label="{/#IntercompanyTPType/TotalSalesAmount/@sap:label}"
                            sortProperty="TotalSalesAmount"
                            filterProperty="TotalSalesAmount"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"TotalSalesAmount","leadingProperty":"TotalSalesAmount","sortProperty":"TotalSalesAmount","filterProperty":"TotalSalesAmount"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{path:'TotalSalesAmount', type:'sap.ui.model.odata.type.Decimal'}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="12rem"
                            hAlign="Right"
                            label="{/#IntercompanyTPType/TotalTransferPrice/@sap:label}"
                            sortProperty="TotalTransferPrice"
                            filterProperty="TotalTransferPrice"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"TotalTransferPrice","leadingProperty":"TotalTransferPrice","sortProperty":"TotalTransferPrice","filterProperty":"TotalTransferPrice"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{path:'TotalTransferPrice', type:'sap.ui.model.odata.type.Decimal'}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="5rem"
                            label="{/#IntercompanyTPType/Currency/@sap:label}"
                            sortProperty="Currency"
                            filterProperty="Currency"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"Currency","leadingProperty":"Currency","sortProperty":"Currency","filterProperty":"Currency"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{Currency}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                    </t:columns>
                </t:Table>
            </smartTable:SmartTable>
        </f:content>
    </f:DynamicPage>
</mvc:View>
