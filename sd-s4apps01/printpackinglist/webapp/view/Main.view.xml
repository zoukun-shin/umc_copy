<mvc:View
    controllerName="sd.printpackinglist.controller.Main"
    displayBlock="true"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:unified="sap.ui.unified"
    xmlns:t="sap.ui.table"
    xmlns:rm="sap.ui.table.rowmodes"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:sv="sap.ui.comp.smartvariants"
    height="100%"
    busyIndicatorDelay="0"
>
    <f:DynamicPage id="idDynamicPage">
        <f:title>
            <f:DynamicPageTitle id="idDynamicPageTitle">
                <f:heading>
                    <sv:SmartVariantManagement
                        id="idSmartVariantManagement"
                        showShare="true"
                        persistencyKey="PackingListSVM"
                        showExecuteOnSelection="true"
                        entitySet="PackingList"
                    />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader id="idDynamicPageHeader">
                <f:content>
                    <smartFilterBar:SmartFilterBar
                        id="idSmartFilterBar"
                        smartVariant="idSmartVariantManagement"
                        persistencyKey="PackingListSVM"
                        entitySet="PackingList"
                        useToolbar="false"
                        class="sapUiResponsiveMargin"
                        search="onSearch"
                    >
                        <smartFilterBar:controlConfiguration>
                            <smartFilterBar:ControlConfiguration
                                key="ShippingPoint"
                                visibleInAdvancedArea="true"
                                label="{i18n>ShippingPoint}"
                                mandatory="notMandatory"
                                index="1"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="BillingDocument"
                                visibleInAdvancedArea="true"
                                label="{i18n>BillingDocument}"
                                mandatory="mandatory"
                                filterType="single"
                                index="3"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="SoldToParty"
                                visibleInAdvancedArea="true"
                                label="{i18n>SoldToParty}"
                                mandatory="notMandatory"
                                index="5"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="CreationDate"
                                visibleInAdvancedArea="true"
                                label="{i18n>CreationDate}"
                                mandatory="notMandatory"
                                index="6"
                                visible="true"
                            >
                                <smartFilterBar:customControl>
                                    <DateRangeSelection
                                        id="idDateRangeSelection"
                                        valueFormat="yyyy/MM/dd"
                                        displayFormat="yyyy/MM/dd"
                                        change="onDateRangeChange"
                                    />
                                </smartFilterBar:customControl>
                            </smartFilterBar:ControlConfiguration>
                        </smartFilterBar:controlConfiguration>
                    </smartFilterBar:SmartFilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <t:Table
                id="reportTable1"
                rows="{local>/PackingList}"
                selectionMode="Multi"
                class="sapUiSizeCompact"
                rowsUpdated="onRowsUpdated"
                enableSelectAll="false"
            >
                <t:rowMode>
                    <rm:Auto id="idAuto" />
                </t:rowMode>
                <t:extension>
                    <OverflowToolbar id="idOverflowToolbar">
                        <Title
                            text="Line Items ({= ${local>/PackingList}.length})"
                            visible="{= ${local>/PackingList}.length > 0}"
                        />
                        <ToolbarSpacer id="idToolbarSpacer" />
                        <Button
                            id="idCreatePIR"
                            icon="sap-icon://create"
                            type="Transparent"
                            text="{i18n>btnPrint}"
                            press="onPrint"
                            enabled="{= ${local>/PackingList}.length > 0 &amp;&amp; ${local>/authorityCheck/button/Edit}}"
                        />
                        <Button
                            id="idSave"
                            icon="sap-icon://save"
                            type="Transparent"
                            text="{i18n>btnSave}"
                            press="onSave"
                            enabled="{= ${local>/PackingList}.length > 0 &amp;&amp; ${local>/authorityCheck/button/Edit}}"
                        />
                        <!-- <Button
                            icon="sap-icon://excel-attachment"
                            type="Transparent"
                            press="onExport"
                            enabled="{= ${local>/PackingList}.length > 0 &amp;&amp; ${local>/authorityCheck/button/Export}}"
                        /> -->
                    </OverflowToolbar>
                </t:extension>
                <t:columns>
                    <t:Column
                        width="10rem"
                        sortProperty="ShippingPoint"
                        label="{i18n>ShippingPoint}"
                    >
                        <t:template>
                            <Text
                                text="{local>ShippingPoint}"
                                tooltip="{local>ShippingPoint}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="BillingDocument"
                        label="{i18n>BillingDocument}"
                    >
                        <t:template>
                            <Text
                                text="{local>BillingDocument}"
                                tooltip="{local>BillingDocument}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="BillingDocumentItem"
                        label="{i18n>BillingDocumentItem}"
                    >
                        <t:template>
                            <Text
                                text="{local>BillingDocumentItem}"
                                tooltip="{local>BillingDocumentItem}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="CreationDate"
                        label="{i18n>CreationDate}"
                    >
                        <t:template>
                            <Text
                                text="{path:'local>CreationDate', type:'sap.ui.model.type.Date'}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="SoldToParty"
                        label="{i18n>SoldToParty}"
                    >
                        <t:template>
                            <Text
                                text="{local>SoldToParty}"
                                tooltip="{local>SoldToParty}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="SoldToPartyName"
                        label="{i18n>SoldToPartyName}"
                    >
                        <t:template>
                            <Text
                                text="{local>SoldToPartyName}"
                                tooltip="{local>SoldToPartyName}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="ShipToParty"
                        label="{i18n>ShipToParty}"
                    >
                        <t:template>
                            <Text
                                text="{local>ShipToParty}"
                                tooltip="{local>ShipToParty}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="ShipToPartyName"
                        label="{i18n>ShipToPartyName}"
                    >
                        <t:template>
                            <Text
                                text="{local>ShipToPartyName}"
                                tooltip="{local>ShipToPartyName}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="PayerParty"
                        label="{i18n>PayerParty}"
                    >
                        <t:template>
                            <Text
                                text="{local>PayerParty}"
                                tooltip="{local>PayerParty}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="PayerPartyName"
                        label="{i18n>PayerPartyName}"
                    >
                        <t:template>
                            <Text
                                text="{local>PayerPartyName}"
                                tooltip="{local>PayerPartyName}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="SalesDocument"
                        label="{i18n>SalesDocument}"
                    >
                        <t:template>
                            <Text
                                text="{local>SalesDocument}"
                                tooltip="{local>SalesDocument}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="SalesDocumentItem"
                        label="{i18n>SalesDocumentItem}"
                    >
                        <t:template>
                            <Text
                                text="{local>SalesDocumentItem}"
                                tooltip="{local>SalesDocumentItem}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="Material"
                        label="{i18n>Material}"
                    >
                        <t:template>
                            <Text
                                text="{local>Material}"
                                tooltip="{local>Material}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="MaterialDescription"
                        label="{i18n>MaterialDescription}"
                    >
                        <t:template>
                            <Text
                                text="{local>MaterialDescription}"
                                tooltip="{local>MaterialDescription}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="OrderQuantityUnit"
                        label="{i18n>OrderQuantityUnit}"
                    >
                        <t:template>
                            <Text
                                text="{local>OrderQuantityUnit}"
                                tooltip="{local>OrderQuantityUnit}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="RequestedDeliveryDate"
                        label="{i18n>RequestedDeliveryDate}"
                    >
                        <t:template>
                            <Text
                                text="{path:'local>RequestedDeliveryDate', type:'sap.ui.model.type.Date'}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="DeliveryMethod"
                        label="{i18n>DeliveryMethod}"
                    >
                        <t:template>
                            <Text
                                text="{local>DeliveryMethod}"
                                tooltip="{local>DeliveryMethod}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="QtyPerBox"
                        label="{i18n>QtyPerBox}"
                        hAlign="End"
                    >
                        <t:template>
                            <Text
                                text="{local>QtyPerBox}"
                                tooltip="{local>QtyPerBox}"
                                wrapping="true"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="ShippingQuantity"
                        label="{i18n>ShippingQuantity}"
                        hAlign="End"
                    >
                        <t:template>
                            <Input
                                value="{local>ShippingQuantity}"
                                textAlign="End"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="QtyOfBox"
                        label="{i18n>QtyOfBox}"
                        hAlign="End"
                    >
                        <t:template>
                            <Input
                                value="{local>QtyOfBox}"
                                textAlign="End"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="BoxNo"
                        label="{i18n>BoxNo}"
                    >
                        <t:template>
                            <Input
                                value="{local>BoxNo}"
                                change="onNoChange"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="NetWeight"
                        label="{i18n>NetWeight}"
                        hAlign="End"
                    >
                        <t:template>
                            <Text
                                text="{local>NetWeight}"
                                tooltip="{local>NetWeight}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="GrossWeight"
                        label="{i18n>GrossWeight}"
                        hAlign="End"
                    >
                        <t:template>
                            <Text
                                text="{local>GrossWeight}"
                                tooltip="{local>GrossWeight}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="ModifyNetWeight"
                        label="{i18n>ModifyNetWeight}"
                        hAlign="End"
                    >
                        <t:template>
                            <Input
                                value="{local>ModifyNetWeight}"
                                textAlign="End"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="ModifyGrossWeight"
                        label="{i18n>ModifyGrossWeight}"
                        hAlign="End"
                    >
                        <t:template>
                            <Input
                                value="{local>ModifyGrossWeight}"
                                textAlign="End"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="BoxSize"
                        label="{i18n>BoxSize}"
                    >
                        <t:template>
                            <Text
                                text="{local>BoxSize}"
                                tooltip="{local>BoxSize}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="PalletNo"
                        label="{i18n>PalletNo}"
                    >
                        <t:template>
                            <Input
                                value="{local>PalletNo}"
                                change="onNoChange"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="PalletSize"
                        label="{i18n>PalletSize}"
                    >
                        <t:template>
                            <Text
                                text="{local>PalletSize}"
                                tooltip="{local>PalletSize}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="Remark"
                        label="{i18n>Remark}"
                    >
                        <t:template>
                            <Text
                                text="{local>Remark}"
                                tooltip="{local>Remark}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="Cbm"
                        label="{i18n>Cbm}"
                    >
                        <t:template>
                            <Text
                                text="{local>Cbm}"
                                tooltip="{local>Cbm}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                </t:columns>
            </t:Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>
