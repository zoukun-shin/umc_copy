{
  "_version": "1.60.0",
  "sap.app": {
    "id": "sd.printpackinglist",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.20.0",
      "toolsId": "027db040-4b66-4065-925b-a15bd081cfdf"
    },
    "dataSources": {
      "ZUI_PACKINGLIST_O2_VAN": {
        "uri": "/sap/opu/odata/IWFND/CATALOGSERVICE;v=2/Annotations(TechnicalName='ZUI_PACKINGLIST_O2_VAN',Version='0001')/$value/",
        "type": "ODataAnnotation",
        "settings": {
          "localUri": "localService/mainService/ZUI_PACKINGLIST_O2_VAN.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata/sap/ZUI_PACKINGLIST_O2/",
        "type": "OData",
        "settings": {
          "annotations": [
            "ZUI_PACKINGLIST_O2_VAN"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      },
      "PrintService": {
          "uri": "/sap/opu/odata4/sap/zui_prt_record_o4/srvd/sap/zui_prt_record_o4/0001/",
          "type": "OData",
          "settings": {
              "annotations": [],
              "localUri": "localService/ZUI_PRT_RECORD_O4/metadata.xml",
              "odataVersion": "4.0"
          }
      },
      "AuthorityService": {
          "uri": "/sap/opu/odata4/sap/zui_permission_access_o4/srvd/sap/zui_permission_access_o4/0001/",
          "type": "OData",
          "settings": {
              "annotations": [],
              "localUri": "localService/ZUI_PERMISSION_ACCESS_O4/metadata.xml",
              "odataVersion": "4.0"
          }
      }
    },
    "crossNavigation": {
        "inbounds": {
            "zbomupload-display": {
                "semanticObject": "printpackinglist",
                "action": "display",
                "icon": "sap-icon://print",
                "title": "{{appTitle}}",
                "signature": {
                    "parameters": {},
                    "additionalParameters": "allowed"
                }
            }
        }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.120.38",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "sd.printpackinglist.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {}
      },
      "Print": {
          "dataSource": "PrintService",
          "preload": true,
          "settings": {
              "synchronizationMode": "None",
              "operationMode": "Server",
              "autoExpandSelect": true,
              "earlyRequests": true
          }
      },
      "Authority": {
          "dataSource": "AuthorityService",
          "preload": true,
          "settings": {
              "synchronizationMode": "None",
              "operationMode": "Server",
              "autoExpandSelect": true,
              "earlyRequests": true
          }
      }
      
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "sd.printpackinglist.view",
        "async": true,
        "viewPath": "sd.printpackinglist.view"
      },
      "routes": [
        {
          "name": "RouteMain",
          "pattern": ":?query:",
          "target": [
            "TargetMain"
          ]
        }
      ],
      "targets": {
        "TargetMain": {
          "id": "Main",
          "name": "Main"
        }
      }
    },
    "rootView": {
      "viewName": "sd.printpackinglist.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "sd-s4apps01"
  },
  "sap.platform.cf": {
    "uisVersionNumber": "1.120.38"
  }
}
