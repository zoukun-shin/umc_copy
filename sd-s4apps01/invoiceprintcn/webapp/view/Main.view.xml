<mvc:View xmlns:vbm="sap.ui.vbm"
    controllerName="sd.invoiceprintcn.controller.Main"
    displayBlock="true"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:unified="sap.ui.unified"
    xmlns:t="sap.ui.table"
    xmlns:rm="sap.ui.table.rowmodes"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:sv="sap.ui.comp.smartvariants"
    xmlns:smartField="sap.ui.comp.smartfield"
    height="100%"
    busyIndicatorDelay="0"
>
    <f:DynamicPage
        id="idDynamicPage"
        showFooter="true"
    >
        <f:title>
            <f:DynamicPageTitle id="idDynamicPageTitle">
                <f:heading>
                    <sv:SmartVariantManagement
                        id="idSmartVariantManagement"
                        showShare="true"
                        persistencyKey="invoicePrintCnFilter"
                        showExecuteOnSelection="true"
                        entitySet="InvoiceList"
                    />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader id="idDynamicPageHeader">
                <f:content>
                    <smartFilterBar:SmartFilterBar
                        id="idSmartFilterBar"
                        smartVariant="idSmartVariantManagement"
                        persistencyKey="invoicePrintCnSmartFilter"
                        entitySet="InvoiceList"
                        useToolbar="false"
                        class="sapUiResponsiveMargin"
                        search="onSearch"
                    >
                        <smartFilterBar:controlConfiguration>
                            <smartFilterBar:ControlConfiguration
                                key="BillingDocumentType"
                                visibleInAdvancedArea="true"
                                label="{/#InvoiceListType/BillingDocumentType/@sap:label}"
                                mandatory="notMandatory"
                                index="3"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="SalesOrganization"
                                visibleInAdvancedArea="true"
                                label="{/#InvoiceListType/SalesOrganization/@sap:label}"
                                mandatory="notMandatory"
                                index="4"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="DistributionChannel"
                                visibleInAdvancedArea="true"
                                label="{/#InvoiceListType/DistributionChannel/@sap:label}"
                                mandatory="notMandatory"
                                index="5"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="Division"
                                visibleInAdvancedArea="true"
                                label="{/#InvoiceListType/Division/@sap:label}"
                                mandatory="notMandatory"
                                index="6"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="SoldToParty"
                                visibleInAdvancedArea="true"
                                label="{/#InvoiceListType/SoldToParty/@sap:label}"
                                mandatory="notMandatory"
                                index="7"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="BillToParty"
                                visibleInAdvancedArea="true"
                                label="{/#InvoiceListType/BillToParty/@sap:label}"
                                mandatory="notMandatory"
                                index="8"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="TO_Reference"
                                visibleInAdvancedArea="true"
                                label="{/#InvoiceListType/TO_Reference/@sap:label}"
                                mandatory="notMandatory"
                                index="9"
                            />
                            <smartFilterBar:ControlConfiguration
                                key="TO_ApprovalCode"
                                visibleInAdvancedArea="true"
                                label="{/#InvoiceListType/TO_ApprovalCode/@sap:label}"
                                mandatory="notMandatory"
                                index="10"
                            />
                        </smartFilterBar:controlConfiguration>
                    </smartFilterBar:SmartFilterBar>
                    <HBox class="sapUiResponsiveMargin">
                        <CheckBox id="idSortCheckBox" text="{i18n>cbSortText}" />
                        <CheckBox id="idOneLineCheckBox" text="{i18n>cbPrintOneLine}" />
                        <HBox  >
                            <Label vAlign="Middle" text="{i18n>Version}:"/>
                            <Input id="idVersionInput" class="sapUiSmallMarginBegin" />
                        </HBox>
                    </HBox>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <smartTable:SmartTable
                id="idSmartTable"
                entitySet="InvoiceList"
                smartFilterId="idSmartFilterBar"
                smartVariant="idSmartVariantManagement"
                persistencyKey="invoicePrintCnSmartTable"
                header="{i18n>tableHeaderTitle}"
                placeToolbarInTable="true"
                beforeRebindTable="onBeforeRebindTable"
                requestAtLeastFields="BillingDocument,SoldToParty"
                ignoredFields="TO_Reference"
            >
                <smartTable:customToolbar>
                    <OverflowToolbar id="idOverflowToolbar">
                        <ToolbarSpacer />
                        <Button
                            id="idBtnInvoicePrint"
                            text="{i18n>btnInvoicePrint}"
                            press="onInvoicePrint"
                            enabled="{= ${local>/authorityCheck/button/Print}}"
                        />
                        <Button
                            id="idBtnInvoicePrintToyota"
                            text="{i18n>btnInvoicePrintToyota}"
                            press="onInvoicePrintToyota"
                            enabled="{= ${local>/authorityCheck/button/PrintToyota}}"
                        />
                    </OverflowToolbar>
                </smartTable:customToolbar>
                <t:Table
                    id="reportTable1"
                    selectionMode="Multi"
                    class="sapUiSizeCompact"
                >
                    <t:rowMode>
                        <rm:Auto id="idAuto" />
                    </t:rowMode>
                    <t:columns>
                        <t:Column
                            width="10rem"
                            label="{/#InvoiceListType/BillingDocument/@sap:label}"
                            sortProperty="BillingDocument"
                            filterProperty="BillingDocument"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"BillingDocument", "leadingProperty":"BillingDocument", "sortProperty":"BillingDocument", "filterProperty": "BillingDocument"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{BillingDocument}"
                                    tooltip="{BillingDocument}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="8rem"
                            label="{/#InvoiceListType/BillingDocumentType/@sap:label}"
                            sortProperty="BillingDocumentType"
                            filterProperty="BillingDocumentType"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"BillingDocumentType", "leadingProperty":"BillingDocumentType", "sortProperty":"BillingDocumentType", "filterProperty": "BillingDocumentType"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{BillingDocumentType}"
                                    tooltip="{BillingDocumentType}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="8rem"
                            label="{/#InvoiceListType/SalesOrganization/@sap:label}"
                            sortProperty="SalesOrganization"
                            filterProperty="SalesOrganization"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"SalesOrganization", "leadingProperty":"SalesOrganization", "sortProperty":"SalesOrganization", "filterProperty": "SalesOrganization"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{SalesOrganization}"
                                    tooltip="{SalesOrganization}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="8rem"
                            label="{/#InvoiceListType/DistributionChannel/@sap:label}"
                            sortProperty="DistributionChannel"
                            filterProperty="DistributionChannel"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"DistributionChannel", "leadingProperty":"DistributionChannel", "sortProperty":"DistributionChannel", "filterProperty": "DistributionChannel"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{DistributionChannel}"
                                    tooltip="{DistributionChannel}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="8rem"
                            label="{/#InvoiceListType/Division/@sap:label}"
                            sortProperty="Division"
                            filterProperty="Division"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"Division", "leadingProperty":"Division", "sortProperty":"Division", "filterProperty": "Division"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{Division}"
                                    tooltip="{Division}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="9rem"
                            label="{/#InvoiceListType/SoldToParty/@sap:label}"
                            sortProperty="SoldToParty"
                            filterProperty="SoldToParty"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"SoldToParty", "leadingProperty":"SoldToParty", "sortProperty":"SoldToParty", "filterProperty": "SoldToParty"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{SoldToParty}"
                                    tooltip="{SoldToParty}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="9rem"
                            label="{/#InvoiceListType/BillToParty/@sap:label}"
                            sortProperty="BillToParty"
                            filterProperty="BillToParty"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"BillToParty", "leadingProperty":"BillToParty", "sortProperty":"BillToParty", "filterProperty": "BillToParty"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{BillToParty}"
                                    tooltip="{BillToParty}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="10rem"
                            label="{/#InvoiceListType/TO_Number/@sap:label}"
                            sortProperty="TO_Number"
                            filterProperty="TO_Number"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"TO_Number", "leadingProperty":"TO_Number", "sortProperty":"TO_Number", "filterProperty": "TO_Number"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{TO_Number}"
                                    tooltip="{TO_Number}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="10rem"
                            label="{/#InvoiceListType/TO_ApprovalCode/@sap:label}"
                            sortProperty="TO_ApprovalCode"
                            filterProperty="TO_ApprovalCode"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"TO_ApprovalCode", "leadingProperty":"TO_ApprovalCode", "sortProperty":"TO_ApprovalCode", "filterProperty": "TO_ApprovalCode"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{TO_ApprovalCode}"
                                    tooltip="{TO_ApprovalCode}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="9rem"
                            label="{/#InvoiceListType/InvoiceDate/@sap:label}"
                            sortProperty="InvoiceDate"
                            filterProperty="InvoiceDate"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"InvoiceDate", "leadingProperty":"InvoiceDate", "sortProperty":"InvoiceDate", "filterProperty": "InvoiceDate", "type":"date"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{path:'InvoiceDate', type:'sap.ui.model.type.Date'}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="9rem"
                            label="{/#InvoiceListType/CreationDate/@sap:label}"
                            sortProperty="CreationDate"
                            filterProperty="CreationDate"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"CreationDate", "leadingProperty":"CreationDate", "sortProperty":"CreationDate", "filterProperty": "CreationDate", "type":"date"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{path:'CreationDate', type:'sap.ui.model.type.Date'}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="12rem"
                            label="{/#InvoiceListType/CustomerDescription/@sap:label}"
                            sortProperty="CustomerDescription"
                            filterProperty="CustomerDescription"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"CustomerDescription", "leadingProperty":"CustomerDescription", "sortProperty":"CustomerDescription", "filterProperty": "CustomerDescription"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{CustomerDescription}"
                                    tooltip="{CustomerDescription}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                        <t:Column
                            width="12rem"
                            label="{/#InvoiceListType/BillToPartyDescription/@sap:label}"
                            sortProperty="BillToPartyDescription"
                            filterProperty="BillToPartyDescription"
                        >
                            <t:customData>
                                <core:CustomData
                                    key="p13nData"
                                    value='\{"columnKey":"BillToPartyDescription", "leadingProperty":"BillToPartyDescription", "sortProperty":"BillToPartyDescription", "filterProperty": "BillToPartyDescription"}'
                                />
                            </t:customData>
                            <t:template>
                                <Text
                                    text="{BillToPartyDescription}"
                                    tooltip="{BillToPartyDescription}"
                                    wrapping="false"
                                />
                            </t:template>
                        </t:Column>
                    </t:columns>
                </t:Table>
            </smartTable:SmartTable>
        </f:content>
    </f:DynamicPage>
</mvc:View>
