<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:t="sap.ui.table"
>
    <Dialog
        id="idCreditMergeDialog"
        title="{i18n>DialogCreditNoteMergeTitle}"
        contentWidth="70rem"
        draggable="true"
    >
        <VBox class="sapUiContentPadding">
            <t:Table
                id="idCreditMergeTable"
                rows="{local>/CredMergeItems}"
                selectionMode="None"
                class="sapUiSizeCompact"
            >
                <t:columns>
                    <t:Column
                        width="8rem"
                        label="{i18n>BillingDocument}"
                        sortProperty="BillingDocument"
                        filterProperty="BillingDocument"
                    >
                        <t:template>
                            <Text
                                text="{local>BillingDocument}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        label="{i18n>BillingDocumentItem}"
                        sortProperty="BillingDocumentItem"
                        filterProperty="BillingDocumentItem"
                    >
                        <t:template>
                            <Text
                                text="{local>BillingDocumentItem}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        label="{i18n>SoNo}"
                        sortProperty="SoNo"
                        filterProperty="SoNo"
                    >
                        <t:template>
                            <Text
                                text="{local>SoNo}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="6rem"
                        label="{i18n>SoItem}"
                        sortProperty="SoItem"
                        filterProperty="SoItem"
                    >
                        <t:template>
                            <Text
                                text="{local>SoItem}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        label="{i18n>ItemNo}"
                        sortProperty="ItemNo"
                        filterProperty="ItemNo"
                    >
                        <t:template>
                            <Text
                                text="{local>ItemNo}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        label="{i18n>ManagementNo_BDI}"
                        sortProperty="ManagementNo_BDI"
                        filterProperty="ManagementNo_BDI"
                    >
                        <t:template>
                            <Text
                                text="{local>ManagementNo_BDI}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        label="{i18n>MergeNo}"
                        sortProperty="MergeNo"
                        filterProperty="MergeNo"
                    >
                        <t:template>
                            <Input value="{local>MergeNo}" />
                        </t:template>
                    </t:Column>
                </t:columns>
            </t:Table>
        </VBox>
        <beginButton>
            <Button
                text="{i18n>bConfirm}"
                press="onCreditMergeConfirm"
            />
        </beginButton>
        <endButton>
            <Button
                text="{i18n>bCancel}"
                press="onCreditMergeClose"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
