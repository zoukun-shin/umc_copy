<core:FragmentDefinition xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<Dialog id="PrintTHDialog" draggable="true">
		<FlexBox id="_IDGenFlexBox1" direction="Column" alignItems="Center" justifyContent="Center" alignContent="Center">
			<HBox id="_IDGenHBox2" justifyContent="Center">
				<VBox id="_IDGenVBox1">
					<Label id="_IDGenLabel1" text="{i18n>selectTitle}:"/>
					<RadioButtonGroup id="idTitleGroup">
						<RadioButton id="idRB1" text="{i18n>taxTitle}" selected="true" />
						<RadioButton id="idRB2" text="{i18n>commercialTitle}" />
					</RadioButtonGroup>
				</VBox>
			</HBox>
		</FlexBox>
	</Dialog>
</core:FragmentDefinition>
