<mvc:View controllerName="pp.zipqcpinaimsheet.controller.Main" displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:sv="sap.ui.comp.smartvariants"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:table="sap.ui.table">
    <f:DynamicPage headerExpanded="true" toggleHeaderOnTitleClick="false">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <sv:SmartVariantManagement id="__SVM01" persistencyKey="IPQCPInAIMSheetSVM" showShare="true" showExecuteOnSelection="true" entitySet="IPQCPInAIMSheet"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader pinnable="false">
                <f:content>
                    <FlexBox fitContainer="true">
                        <smartFilterBar:SmartFilterBar id="idSmartFilterBar" entitySet="IPQCPInAIMSheet" useToolbar="false" smartVariant="__SVM01" persistencyKey="StandardListSFB" initialized="onsMrilterBarInitialized" showGoOnFB="false">
                            <smartFilterBar:controlConfiguration>
                                <smartFilterBar:ControlConfiguration index='10' key="Plant" mandatory="mandatory" filterType="single" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>Plant}"/>
                                <smartFilterBar:ControlConfiguration index='20' key="Material" mandatory="mandatory" filterType="single" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>Material}"/>
                                <smartFilterBar:ControlConfiguration index='30' key="BillOfMaterialVariant" mandatory="mandatory" filterType="single" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>BillOfMaterialVariant}"/>
                                <smartFilterBar:ControlConfiguration index='40' key="ValidityStartDate" mandatory="mandatory" filterType="single" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>ValidityStartDate}" id="idValidityStartDate">
                                    <smartFilterBar:customControl>
                                        <DatePicker 
                                            id ="idDP1" 
                                            value="{
                                                'path':'local>/ValidityStartDate',
                                                'type':'sap.ui.model.type.Date',
                                                'formatOptions': {
                                                    'pattern': 'yyyy-MM-dd',
                                                    'UTC': true
                                                }
                                            }"
                                        />
                                    </smartFilterBar:customControl>
                                </smartFilterBar:ControlConfiguration>

                                <!-- visible -->
                                <smartFilterBar:ControlConfiguration index='999' key="BOMSubItemInstallationPoint" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="BillOfMaterialComponent" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="Customer" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="HeaderBoard" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="BOMHeaderText" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="RevisionLevel" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="HeaderDate" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="ItemNo" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="Detspecification" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="ItemBoard" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="ProductManufacturerNumber" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="Code" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="Title" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="TotalPointQty" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="ChangeNumber" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="ProjectCode" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="ItemPointQty" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="DisplayPMN" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="DisplayMPN" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="ToBOMHistory" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="PriorityOrPercent" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="DiscOrFollowUp" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="TemplateType" visible="false"/>
                            </smartFilterBar:controlConfiguration>

                            <VBox>
                                <VBox id ="idVB1">
                                    <Label text="{i18n>BOMExplode}"/>
                                    <CheckBox id ="idCB1" text="{i18n>DisplayPMN}"/> 
                                    <CheckBox id ="idCB2" text="{i18n>DisplayMPN}"/> 
                                    <CheckBox id ="idCB3" text="{i18n>ToBOMHistory}"/> 
                                    <HBox>
                                        <VBox>
                                            <RadioButtonGroup id="idRBG1" selectedIndex="0" class="sapUiLargeMarginEnd">
                                                <RadioButton id="idRBG1-0" text="{i18n>Discontinuation}"/>
                                                <RadioButton id="idRBG1-1" text="{i18n>FollowUp}"/>
                                            </RadioButtonGroup>
                                        </VBox>
                                        <VBox>
                                            <RadioButtonGroup id="idRBG2" selectedIndex="0">
                                                <RadioButton id="idRBG2-0" text="{i18n>Priority}" selected="true"/>
                                                <RadioButton id="idRBG2-1" text="{i18n>Percent}"/>
                                            </RadioButtonGroup>
                                        </VBox>
                                    </HBox>
                                </VBox>
                                <Label text="{i18n>TemplateType}"/>
                                <RadioButtonGroup id="idRBG3" selectedIndex="7" select="onSelect">
                                    <RadioButton id="idRBG3-0" text="{i18n>SMT}"/>
                                    <RadioButton id="idRBG3-1" text="{i18n>SMTA}"/>
                                    <RadioButton id="idRBG3-2" text="{i18n>SMTB}"/>
                                    <RadioButton id="idRBG3-3" text="{i18n>SMTC}"/>
                                    <RadioButton id="idRBG3-4" text="{i18n>JVK}"/>
                                    <RadioButton id="idRBG3-5" text="{i18n>RHS}"/>
                                    <RadioButton id="idRBG3-6" text="{i18n>AVK}"/>
                                    <RadioButton id="idRBG3-7" text="{i18n>FAT}"/>
                                    <RadioButton id="idRBG3-8" text="{i18n>OQC}"/>
                                    <RadioButton id="idRBG3-9" text="{i18n>AIM}" class="highlightRadio"/>
                                </RadioButtonGroup>
                            </VBox>
                        </smartFilterBar:SmartFilterBar>
                    </FlexBox>
                    <Toolbar>
                        <ToolbarSpacer/>
                        <Button icon="sap-icon://excel-attachment" text="{i18n>Export}" press="onExport"/>
                    </Toolbar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
    </f:DynamicPage>
</mvc:View>
