<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="CreateSingle"
        title="Create">

        <VBox class="sapUiSmallMargin">

            <Label text="{i18n>Plant}"/>
            <Input
                value="{dialog>/Plant}"
                />

            <Label text="{i18n>DeliveryMaterial}"/>
            <Input
                value="{dialog>/DeliveryMaterial}"
                />

            <Label text="{i18n>ReceiptMaterial}"/>
            <Input
                value="{dialog>/ReceiptMaterial}"
                />

            <Label text="{i18n>PurchaseOrder}"/>
            <Input
                value="{dialog>/PurchaseOrder}"
                />

            <Label text="{i18n>PurchaseOrderItem}"/>
            <Input value="{dialog>/PurchaseOrderItem}"/>

        </VBox>

        <beginButton>
            <Button
                text="OK"
                press="onCreateDialogOK"/>
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press="onCreateDialogCancel"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>