<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="CreateSingle"
        title="Create">

        <VBox class="sapUiSmallMargin">

            <Label text="{i18n>Plant}" required="true"/>
            <Input
                value="{dialog>/Plant}"
                required="true"
                />

            <Label text="{i18n>DeliveryMaterial}" required="true"/>
            <Input
                value="{dialog>/DeliveryMaterial}"
                required="true"
                />

            <Label text="{i18n>ReceiptMaterial}" required="true"/>
            <Input
                value="{dialog>/ReceiptMaterial}"
                required="true"
                />

            <Label text="{i18n>PurchaseOrder}" required="true"/>
            <Input
                value="{dialog>/PurchaseOrder}"
                required="true"
                />

            <Label text="{i18n>PurchaseOrderItem}" required="true"/>
            <Input value="{dialog>/PurchaseOrderItem}" required="true"/>

        </VBox>

        <beginButton>
            <Button
                text="OK"
                press="onCreateDialogOK"/>
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press="onCreateDialogCancel"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>