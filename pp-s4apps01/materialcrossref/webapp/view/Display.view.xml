<mvc:View controllerName="pp.materialcrossref.controller.Display" displayBlock="true"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:unified="sap.ui.unified"
    xmlns:t="sap.ui.table"
    xmlns:rm="sap.ui.table.rowmodes"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:sv="sap.ui.comp.smartvariants" height="100%" busyIndicatorDelay="0">
    <f:DynamicPage id="idDynamicPage">
        <f:title>
            <f:DynamicPageTitle id="idDynamicPageTitle">
                <f:heading>
                    <sv:SmartVariantManagement id="idSmartVariantManagement" showShare="true" persistencyKey="materialcrossrefFilter" showExecuteOnSelection="true" entitySet="PurchaseReq" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader id="idDynamicPageHeader">
                <f:content>
                    <!--数据查询-->
                    <smartFilterBar:SmartFilterBar id="idSmartFilterBar" smartVariant="idSmartVariantManagement" persistencyKey="materialcrossref" entitySet="MaterialCrossRef" useToolbar="false" class="sapUiResponsiveMargin">
                        <smartFilterBar:controlConfiguration>   
                            <smartFilterBar:ControlConfiguration id="id3ControlConfiguration" key="Plant" visibleInAdvancedArea="true" label="{i18n>Plant}" mandatory="notMandatory" index="20" />
                            <smartFilterBar:ControlConfiguration id="id4ControlConfiguration" key="DeliveryMaterial" visibleInAdvancedArea="true" label="{i18n>DeliveryMaterial}" mandatory="notMandatory" index="30" />
                            <smartFilterBar:ControlConfiguration id="id5ControlConfiguration" key="ReceiptMaterial" visibleInAdvancedArea="true" label="{i18n>ReceiptMaterial}" mandatory="notMandatory" index="40" />
                            <smartFilterBar:ControlConfiguration id="id6ControlConfiguration" key="PurchaseOrder" visibleInAdvancedArea="true" label="{i18n>PurchaseOrder}" mandatory="notMandatory" index="50" />
                            <smartFilterBar:ControlConfiguration id="id7ControlConfiguration" key="DelFlag" visibleInAdvancedArea="true" label="{i18n>DelFlag}" mandatory="notMandatory" index="60" />
                            <!-- visable = false -->
                            <smartFilterBar:ControlConfiguration id="id8ControlConfiguration" key="PurchaseOrderItem" visible="false" />
                            <smartFilterBar:ControlConfiguration id="id9ControlConfiguration" key="StorageLocation" visible="false" />
                            <smartFilterBar:ControlConfiguration id="id10ControlConfiguration" key="OrderQuantity" visible="false" />
                            <smartFilterBar:ControlConfiguration id="id11ControlConfiguration" key="BaseUnit" visible="false" />
                            <smartFilterBar:ControlConfiguration id="id12ControlConfiguration" key="CreateBy" visible="false" />
                            <smartFilterBar:ControlConfiguration id="id13ControlConfiguration" key="CreateAt" visible="false" />
                            <smartFilterBar:ControlConfiguration id="id14ControlConfiguration" key="ChangeBy" visible="false" />
                            <smartFilterBar:ControlConfiguration id="id15ControlConfiguration" key="ChnageAt" visible="false" />
                            
                        </smartFilterBar:controlConfiguration>
                    </smartFilterBar:SmartFilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <smartTable:SmartTable id="idSmartTable" entitySet="MaterialCrossRef" smartFilterId="idSmartFilterBar" smartVariant="idSmartVariantManagement" persistencyKey="materialcrossrefTable" header="{i18n>tableHeaderTitle}" placeToolbarInTable="true" requestAtLeastFields="" beforeRebindTable="onBeforeRebindTable" beforeExport="onBeforeExport" showRowCount="true">
                <smartTable:customToolbar>
                    <OverflowToolbar>
                        <ToolbarSpacer />
                        <Button icon="sap-icon://create"       type="Transparent" text="{i18n>DisplayView.CreateSingle}" press="createSingle" enabled="{= ${local>/authorityCheck/button/Single}}" />
                        <Button icon="sap-icon://delete"       type="Transparent" text="{i18n>DisplayView.Delete}"       press="onDeleteFlag"       enabled="{= ${local>/authorityCheck/button/Delete}}" />
                        <Button icon="sap-icon://cancel"       type="Transparent" text="{i18n>DisplayView.DeleteCancel}" press="onDeleteCancel" enabled="{= ${local>/authorityCheck/button/DeleteCancel}}" />
                    </OverflowToolbar>
                </smartTable:customToolbar>
                <t:Table id="idMaterialCrossRefTable" rowActionCount="1">
                    <t:rowMode>
                        <rm:Auto id="idAuto" />
                    </t:rowMode>
                    <t:columns>
                        <t:Column id="id6Column" width="10rem" label="{i18n>Plant}" sortProperty="Plant" filterProperty="Plant">
                            <t:customData>
                                <core:CustomData id="id6CustomData" key="p13nData" value='\{"columnKey":"Plant", "leadingProperty":"Plant", "sortProperty":"Plant", "filterProperty": "Plant"}'/>
                            </t:customData>
                            <t:template>
                                <Text id="idPlantText" text="{Plant}" wrapping="false"/>
                            </t:template>
                        </t:Column>
                        <t:Column id="id7Column" width="10rem" label="{i18n>DeliveryMaterial}" sortProperty="DeliveryMaterial" filterProperty="DeliveryMaterial">
                            <t:customData>
                                <core:CustomData id="id7CustomData" key="p13nData" value='\{"columnKey":"DeliveryMaterial", "leadingProperty":"DeliveryMaterial", "sortProperty":"DeliveryMaterial", "filterProperty": "DeliveryMaterial"}'/>
                            </t:customData>
                            <t:template>
                                <Text id="idDeliveryMaterialText" text="{DeliveryMaterial}" wrapping="false"/>
                            </t:template>
                        </t:Column>
                        <t:Column id="id8Column" width="10rem" label="{i18n>ReceiptMaterial}" sortProperty="ReceiptMaterial" filterProperty="ReceiptMaterial">
                            <t:customData>
                                <core:CustomData id="id8CustomData" key="p13nData" value='\{"columnKey":"ReceiptMaterial", "leadingProperty":"ReceiptMaterial", "sortProperty":"ReceiptMaterial", "filterProperty": "ReceiptMaterial"}'/>
                            </t:customData>
                            <t:template>
                                <Text id="idReceiptMaterialText" text="{ReceiptMaterial}" wrapping="false"/>
                            </t:template>
                        </t:Column>
                        <t:Column id="id9Column" width="10rem" label="{i18n>PurchaseOrder}" sortProperty="PurchaseOrder" filterProperty="PurchaseOrder">
                            <t:customData>
                                <core:CustomData id="id9CustomData" key="p13nData" value='\{"columnKey":"PurchaseOrder", "leadingProperty":"PurchaseOrder", "sortProperty":"PurchaseOrder", "filterProperty": "PurchaseOrder"}'/>
                            </t:customData>
                            <t:template>
                                <Text id="idPurchaseOrderText" text="{PurchaseOrder}" wrapping="false"/>
                            </t:template>
                        </t:Column>
                        <t:Column id="id10Column" width="10rem" label="{i18n>PurchaseOrderItem}" sortProperty="PurchaseOrderItem" filterProperty="PurchaseOrderItem">
                            <t:customData>
                                <core:CustomData id="id10CustomData" key="p13nData" value='\{"columnKey":"PurchaseOrderItem", "leadingProperty":"PurchaseOrderItem", "sortProperty":"PurchaseOrderItem", "filterProperty": "PurchaseOrderItem"}'/>
                            </t:customData>
                            <t:template>
                                <Text id="idPurchaseOrderItemText" text="{PurchaseOrderItem}" wrapping="false"/>
                            </t:template>
                        </t:Column>
                        <t:Column id="id11Column" width="10rem" label="{i18n>StorageLocation}" sortProperty="StorageLocation" filterProperty="StorageLocation">
                            <t:customData>
                                <core:CustomData id="id11CustomData" key="p13nData" value='\{"columnKey":"StorageLocation", "leadingProperty":"StorageLocation", "sortProperty":"StorageLocation", "filterProperty": "StorageLocation"}'/>
                            </t:customData>
                            <t:template>
                                <Text id="idStorageLocationText" text="{StorageLocation}" wrapping="false"/>
                            </t:template>
                        </t:Column>
                        <t:Column id="id12Column" width="10rem" label="{i18n>OrderQuantity}" sortProperty="OrderQuantity" filterProperty="OrderQuantity" hAlign="End">
                            <t:customData>
                                <core:CustomData id="id12CustomData" key="p13nData" value='\{"columnKey":"OrderQuantity", "leadingProperty":"OrderQuantity", "sortProperty":"OrderQuantity", "filterProperty": "OrderQuantity"}'/>
                            </t:customData>
                            <t:template>
                                <Text text="{ path:'OrderQuantity', formatter:'.formatter.formatQuantity' }" wrapping="false" />
                            </t:template>
                        </t:Column>
                        <t:Column id="id13Column" width="10rem" label="{i18n>DelFlag}" sortProperty="DelFlag" filterProperty="DelFlag">
                            <t:customData>
                                <core:CustomData id="id13CustomData" key="p13nData" value='\{"columnKey":"DelFlag", "leadingProperty":"DelFlag", "sortProperty":"DelFlag", "filterProperty": "DelFlag"}'/>
                            </t:customData>
                            <t:template>
                                <Text id="idDelFlagText" text="{DelFlag}" wrapping="false"/>
                            </t:template>
                        </t:Column>
                        <t:Column id="id14Column" width="10rem" label="{i18n>BaseUnit}" sortProperty="BaseUnit" filterProperty="BaseUnit">
                            <t:customData>
                                <core:CustomData id="id14CustomData" key="p13nData" value='\{"columnKey":"BaseUnit", "leadingProperty":"BaseUnit", "sortProperty":"BaseUnit", "filterProperty": "BaseUnit"}'/>
                            </t:customData>
                            <t:template>
                                <Text id="idBaseUnitText" text="{BaseUnit}" wrapping="false"/>
                            </t:template>
                        </t:Column>
                        <t:Column id="id15Column" width="10rem" label="{i18n>CreateBy}" sortProperty="CreateBy" filterProperty="CreateBy">
                            <t:customData>
                                <core:CustomData id="id15CustomData" key="p13nData" value='\{"columnKey":"CreateBy", "leadingProperty":"CreateBy", "sortProperty":"CreateBy", "filterProperty": "CreateBy"}'/>
                            </t:customData>
                            <t:template>
                                <Text id="idCreateByText" text="{CreateBy}" wrapping="false"/>
                            </t:template>
                        </t:Column>
                        <t:Column id="id16Column" width="10rem" label="{i18n>CreateAt}" sortProperty="CreateAt" filterProperty="CreateAt">
                            <t:customData>
                                <core:CustomData id="id16CustomData" key="p13nData" value='\{"columnKey":"CreateAt", "leadingProperty":"CreateAt", "sortProperty":"CreateAt", "filterProperty": "CreateAt"}'/>
                            </t:customData>
                            <t:template>
                                <Text id="idCreateAtText" text="{ path: 'CreateAt', type: 'sap.ui.model.type.DateTime' }" wrapping="false"/>
                            </t:template>
                        </t:Column>
                        <t:Column id="id17Column" width="10rem" label="{i18n>ChangeBy}" sortProperty="ChangeBy" filterProperty="ChangeBy">
                            <t:customData>
                                <core:CustomData id="id17CustomData" key="p13nData" value='\{"columnKey":"ChangeBy", "leadingProperty":"ChangeBy", "sortProperty":"ChangeBy", "filterProperty": "ChangeBy"}'/>
                            </t:customData>
                            <t:template>
                                <Text id="idChangeByText" text="{ChangeBy}" wrapping="false"/>
                            </t:template>
                        </t:Column>
                        <t:Column id="id18Column" width="10rem" label="{i18n>ChnageAt}" sortProperty="ChnageAt" filterProperty="ChnageAt">
                            <t:customData>
                                <core:CustomData id="id18CustomData" key="p13nData" value='\{"columnKey":"ChnageAt", "leadingProperty":"ChnageAt", "sortProperty":"ChnageAt", "filterProperty": "ChnageAt"}'/>
                            </t:customData>
                            <t:template>
                                <Text id="idChnageAtText" text="{ path: 'ChnageAt', type: 'sap.ui.model.type.DateTime' }" wrapping="false"/>
                            </t:template>
                        </t:Column>
                    </t:columns>
                </t:Table>
            </smartTable:SmartTable>
        </f:content>
    </f:DynamicPage>
</mvc:View>