<core:FragmentDefinition xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:unified="sap.ui.unified"
    xmlns:layout="sap.ui.layout"
    xmlns:table="sap.ui.table"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:smartTable="sap.ui.comp.smarttable">
    <smartTable:SmartTable entitySet="BomFollowupList" smartFilterId="idSmartFilterBar" tableType="Table" width="100%" 
        showRowCount="true" useVariantManagement="false" useTablePersonalisation="true" 
        persistencyKey="StandardListST" header="{i18n>Results}" enableAutoBinding="false" 
        placeToolbarInTable="true" beforeRebindTable="onBeforeRebindTable" 
        beforeExport="onBeforeExport" showFullScreenButton="true" ignoredFields="DisplayStockQty">
        <smartTable:customToolbar>
            <OverflowToolbar design="Transparent">
                <ToolbarSpacer/>
            </OverflowToolbar>
        </smartTable:customToolbar>
       <table:Table id="idTable" selectionMode="None" rowMode="Auto">
            <table:columns>
                <table:Column width="6rem" label="{i18n>Plant}" sortProperty="Plant" filterProperty="Plant">
                    <table:customData>
                        <core:CustomData key="p13nData" value='\{"columnKey":"Plant", "leadingProperty":"Plant"}'/>
                    </table:customData>
                    <table:template>
                        <Text text="{Plant}" />
                    </table:template>
                </table:Column>

                <table:Column width="12rem" label="{i18n>Material}" sortProperty="Material" filterProperty="Material">
                    <table:customData>
                        <core:CustomData key="p13nData" value='\{"columnKey":"Material", "leadingProperty":"Material"}'/>
                    </table:customData>
                    <table:template>
                        <Text text="{Material}" wrapping="false" />
                    </table:template>
                </table:Column>

                <table:Column width="12rem" label="{i18n>Component}" sortProperty="Component" filterProperty="Component">
                    <table:customData>
                        <core:CustomData key="p13nData" value='\{"columnKey":"Component", "leadingProperty":"Component"}'/>
