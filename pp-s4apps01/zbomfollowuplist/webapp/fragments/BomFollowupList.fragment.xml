                        <core:CustomData key="p13nData" value='\{"columnKey":"EffectiveOutDate", "leadingProperty":"EffectiveOutDate"}'/>
                    </table:customData>
                    <table:template>
                        <Text text="{path:'EffectiveOutDate', type:'sap.ui.model.type.Date', formatOptions:{pattern:'yyyy/MM/dd'}}"  wrapping="false" />
                    </table:template>
                </table:Column>
                 <table:Column width="12rem" label="{i18n>MatlWrhsStkQtyInMatlBaseUnit}" sortProperty="MatlWrhsStkQtyInMatlBaseUnit" filterProperty="MatlWrhsStkQtyInMatlBaseUnit">
