                            <smartFilterBar:ControlConfiguration index='20' key="Barcode" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>Barcode}"/>
                            <smartFilterBar:ControlConfiguration index='30' key="WO_Order" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>WO_Order}"/>
                            <smartFilterBar:ControlConfiguration index='40' key="Product" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>Product}"/>
