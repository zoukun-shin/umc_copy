                            <smartFilterBar:ControlConfiguration index='80' key="Print_Count" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>Print_Count}">
                                <smartFilterBar:customControl>
                                    <ComboBox id="cbCount" selectedKey="{/Count}">
                                        <items>
                                            <core:Item key="1" text="" />
                                            <core:Item key="2" text="{i18n>No}" />
                                            <core:Item key="3" text="{i18n>Yes}" />
                                        </items>
                                    </ComboBox>
                                </smartFilterBar:customControl>
                            </smartFilterBar:ControlConfiguration>
                            <smartFilterBar:ControlConfiguration index='80' key="Father_Barcode" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>Father_Barcode}"/>
                            <smartFilterBar:ControlConfiguration index='90' key="Delete_Flag" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>Delete_Flag}">
                                <smartFilterBar:customControl>
                                    <ComboBox id="cbDelete" selectedKey="{/Delete}">
                                        <items>
                                            <core:Item key="1" text="" />
                                            <core:Item key="2" text="{i18n>No}" />
                                            <core:Item key="3" text="{i18n>Yes}" />
                                        </items>
                                    </ComboBox>
                                </smartFilterBar:customControl>
                            </smartFilterBar:ControlConfiguration>
                            <!-- visible -->
                            <smartFilterBar:ControlConfiguration index='999' key="Delete_mc" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="Update_mc" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="Barcode_Text" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="ProductName" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="WO_Qty" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="Gen_Qty" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="Packing_Qty" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="Box_Qty" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="Box_Qty_Sum" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="Barcode_Qty" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="Father_Barcode" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="Customer" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="CustomerName" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="SalesDocument" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="PurchaseOrderByCustomer" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="WO_Unit" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="Base_Unit" visible="false"/>
