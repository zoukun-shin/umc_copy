<mvc:View
    controllerName="pp.internalpogr.controller.InternalPost"
    displayBlock="true"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:unified="sap.ui.unified"
    xmlns:t="sap.ui.table"
    xmlns:rm="sap.ui.table.rowmodes"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:sv="sap.ui.comp.smartvariants"
    height="100%"
    busyIndicatorDelay="0"
>
    <f:DynamicPage id="idDynamicPage">
            <f:title>
            <f:DynamicPageTitle id="idDynamicPageTitle">
                <f:heading>
                    <sv:SmartVariantManagement
                        id="idSmartVariantManagement"
                        showShare="true"
                        persistencyKey="InternalPostSVM"
                        showExecuteOnSelection="true"
                        entitySet="InternalPOGR"
                    />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader id="idDynamicPageHeader">
                <f:content>
                    <smartFilterBar:SmartFilterBar
                        id="idSmartFilterBar"
                        smartVariant="idSmartVariantManagement"
                        persistencyKey="InternalPostSVM"
                        entitySet="InternalPOGR"
                        useToolbar="false"
                        class="sapUiResponsiveMargin"
                        search="onSearch"
                    >
                        <smartFilterBar:controlConfiguration>
                            <smartFilterBar:ControlConfiguration index='10' key="DeliveryNoteNo" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>DeliveryNoteNo_Header}"/> 
                            <smartFilterBar:ControlConfiguration index='999' key="Plant" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="DeliveryMaterial" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="ReceiptMaterial" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="ProcessResult" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="PurchaseOrder" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="PurchaseOrderItem" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="DeliveryNoteItemNo" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="MaterialDocumentNo" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="MaterialDocumentItemNo" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="POQuantity" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="DeliveryQuantityUnit" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="DNStorageLocation" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="POStorageLocation" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="TotalQuantity" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="DNLongtext" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="ProcessStatus" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="UUID" visible="false"/>
                        </smartFilterBar:controlConfiguration>
                    </smartFilterBar:SmartFilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <t:Table
                id="reportTable1"
                rows="{local>/InternalPOGR}"
                selectionMode="Multi"
                class="sapUiSizeCompact"
                rowsUpdated="onRowsUpdated"
                enableSelectAll="false"
            >
                <t:rowMode>
                    <rm:Auto id="idAuto" />
                </t:rowMode>
                <t:extension>
                    <OverflowToolbar id="idOverflowToolbar">
                        <Title
                            text="{i18n>Results} ({= ${local>/InternalPOGR}.length})"
                            visible="{= ${local>/InternalPOGR}.length > 0}"
                        />
                        <ToolbarSpacer id="idToolbarSpacer" />
                        <Button
                            id="idCheck"
                            icon="sap-icon://check-availability"
                            type="Transparent"
                            text="{i18n>InternalPost.Check}"
                            press="onCheck"
                            enabled="{= ${local>/InternalPOGR}.length > 0 &amp;&amp; ${local>/authorityCheck/button/Check}}"
                        />
                        <Button 
                            id="idPost"
                            icon="sap-icon://create"
                            type="Transparent"
                            text="{i18n>InternalPost.Post}"
                            press="onPost"
                            enabled="{= ${local>/InternalPOGR}.length > 0 &amp;&amp; ${local>/authorityCheck/button/Post}}"
                        />
                    </OverflowToolbar>
                </t:extension>
                <t:columns>

                    <t:Column id="idstatusColumn" width="6rem" sortProperty="Type" label="{i18n>1ProcessStatus}">
                        <t:template>
                            <ObjectStatus id="idObjectStatus" state="{
                                    path: 'local>ProcessStatus',
                                    formatter: '.formatter.setState'
                                }" icon="{
                                    path: 'local>ProcessStatus',
                                    formatter: '.formatter.setStateIcon'
                                }" />
                        </t:template>
                    </t:Column>

                    <t:Column
                        width="10rem"
                        sortProperty="ProcessResult"
                        label="{i18n>1ProcessResult}"
                    >
                        <t:template>
                            <Text
                                text="{local>ProcessResult}"
                                tooltip="{local>ProcessResult}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>

                    <t:Column
                        width="10rem"
                        sortProperty="Plant"
                        label="{i18n>1Plant}"
                    >
                        <t:template>
                            <Text
                                text="{local>Plant}"
                                tooltip="{local>Plant}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="DeliveryNoteNo"
                        label="{i18n>1DeliveryNoteNo}"
                    >
                        <t:template>
                            <Text
                                text="{local>DeliveryNoteNo}"
                                tooltip="{local>DeliveryNoteNo}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        sortProperty="DeliveryNoteItemNo"
                        label="{i18n>1DeliveryNoteItemNo}"
                    >
                        <t:template>
                            <Text
                                text="{local>DeliveryNoteItemNo}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="DeliveryMaterial"
                        label="{i18n>1DeliveryMaterial}"
                    >
                        <t:template>
                            <Text
                                text="{local>DeliveryMaterial}"
                                tooltip="{local>DeliveryMaterial}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="DeliveryQty"
                        label="{i18n>1DeliveryQty}"
                    >
                        <t:template>
                            <Text text="{ path: 'local>DeliveryQty', formatter: '.formatter.formatQuantity' }" wrapping="false" />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="DNStorageLocation"
                        label="{i18n>1DNStorageLocation}"
                    >
                        <t:template>
                            <Text
                                text="{local>DNStorageLocation}"
                                tooltip="{local>DNStorageLocation}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="DNLongtext"
                        label="{i18n>1DNLongtext}"
                    >
                        <t:template>
                            <Text
                                text="{local>DNLongtext}"
                                tooltip="{local>DNLongtext}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="PurchaseOrder"
                        label="{i18n>1PurchaseOrder}"
                    >
                        <t:template>
                            <Text
                                text="{local>PurchaseOrder}"
                                tooltip="{local>PurchaseOrder}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        sortProperty="PurchaseOrderItem"
                        label="{i18n>1PurchaseOrderItem}"
                    >
                        <t:template>
                            <Text
                                text="{local>PurchaseOrderItem}"
                            
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>    
                    <t:Column
                        width="10rem"
                        sortProperty="ReceiptMaterial"
                        label="{i18n>1ReceiptMaterial}"
                    >
                        <t:template>
                            <Text
                                text="{local>ReceiptMaterial}"
                                tooltip="{local>ReceiptMaterial}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="POStorageLocation"
                        label="{i18n>1POStorageLocation}"
                    >
                        <t:template>
                            <Text
                                text="{local>POStorageLocation}"
                                tooltip="{local>POStorageLocation}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="POQuantity"
                        label="{i18n>1POQuantity}"
                    >
                        <t:template>
                            <Text text="{ path: 'local>POQuantity', formatter: '.formatter.formatQuantity' }" wrapping="false" />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="TotalQuantity"
                        label="{i18n>1TotalQuantity}">
                        <t:template>
                            <Text text="{ path: 'local>TotalQuantity', formatter: '.formatter.formatQuantity' }" wrapping="false" />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="MaterialDocumentNo"
                        label="{i18n>1MaterialDocumentNo}"
                    >
                        <t:template>
                            <Text
                                text="{local>MaterialDocumentNo}"
                                tooltip="{local>MaterialDocumentNo}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="MaterialDocumentItemNo"
                        label="{i18n>1MaterialDocumentItemNo}"
                    >
                        <t:template>
                            <Text
                                text="{local>MaterialDocumentItemNo}"
                                tooltip="{local>MaterialDocumentItemNo}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    
                </t:columns>
            </t:Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>