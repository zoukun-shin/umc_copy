<mvc:View
    controllerName="pp.internalpogr.controller.InternalPost"
    displayBlock="true"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:unified="sap.ui.unified"
    xmlns:t="sap.ui.table"
    xmlns:rm="sap.ui.table.rowmodes"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:sv="sap.ui.comp.smartvariants"
    height="100%"
    busyIndicatorDelay="0"
>
    <f:DynamicPage id="idDynamicPage">
            <f:title>
            <f:DynamicPageTitle id="idDynamicPageTitle">
                <f:heading>
                    <sv:SmartVariantManagement
                        id="idSmartVariantManagement"
                        showShare="true"
                        persistencyKey="InternalPostSVM"
                        showExecuteOnSelection="true"
                        entitySet="InternalPOGR"
                    />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader id="idDynamicPageHeader">
                <f:content>
                    <smartFilterBar:SmartFilterBar
                        id="idSmartFilterBar"
                        smartVariant="idSmartVariantManagement"
                        persistencyKey="InternalPostSVM"
                        entitySet="InternalPOGR"
                        useToolbar="false"
                        class="sapUiResponsiveMargin"
                        search="onSearch"
                    >
                        <smartFilterBar:controlConfiguration>
                            <smartFilterBar:ControlConfiguration index='10' key="DeliveryNoteNo" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>DeliveryNoteNo_Header}"/> 
                            <smartFilterBar:ControlConfiguration index='999' key="Plant" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="DeliveryMaterial" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="ReceiptMaterial" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="ProcessResult" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="PoNo" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="PoItemNo" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="DeliveryNoteItemNo" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="MaterialDocumentNo" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="MaterialDocumentItemNo" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="PostQty" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="DeliveryQuantityUnit" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="MaterialDocumentYear" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="DDStorageLocation" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="POStorageLocation" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="ReversedInd" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="ReversedMatDocument" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="PostingDate" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="ReversedPostingDate" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="OrderQuantity" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="PurchaseOrderQuantityUnit" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="TotalQuantity" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="DisplayCancel" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="DisplayDNLongText" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="OriginalDeliveryQuantity" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="DNLongtext" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="ProcessStatus" visible="false"/>
                            <smartFilterBar:ControlConfiguration index='999' key="UUID" visible="false"/>
                        </smartFilterBar:controlConfiguration>
                    </smartFilterBar:SmartFilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <t:Table
                id="reportTable1"
                rows="{local>/InternalPOGR}"
                selectionMode="Multi"
                class="sapUiSizeCompact"
                rowsUpdated="onRowsUpdated"
                enableSelectAll="false"
            >
                <t:rowMode>
                    <rm:Auto id="idAuto" />
                </t:rowMode>
                <t:extension>
                    <OverflowToolbar id="idOverflowToolbar">
                        <Title
                            text="Line Items ({= ${local>/InternalPOGR}.length})"
                            visible="{= ${local>/InternalPOGR}.length > 0}"
                        />
                        <ToolbarSpacer id="idToolbarSpacer" />
                        <Button
                            id="idCheck"
                            icon="sap-icon://check-availability"
                            type="Transparent"
                            text="{i18n>InternalPost.Check}"
                            press="onCheck"
                            enabled="{= ${local>/InternalPOGR}.length > 0 &amp;&amp; ${local>/authorityCheck/button/Check}}"
                        />
                        <Button 
                            id="idPost"
                            icon="sap-icon://create"
                            type="Transparent"
                            text="{i18n>InternalPost.Post}"
                            press="onPost"
                            enabled="{= ${local>/InternalPOGR}.length > 0 &amp;&amp; ${local>/authorityCheck/button/Post}}"
                        />
                    </OverflowToolbar>
                </t:extension>
                <t:columns>

                    <t:Column id="idstatusColumn" width="6rem" sortProperty="Type" label="{i18n>Status}">
                        <t:template>
                            <ObjectStatus id="idObjectStatus" state="{
                                    path: 'local>ProcessStatus',
                                    formatter: '.formatter.setState'
                                }" icon="{
                                    path: 'local>ProcessStatus',
                                    formatter: '.formatter.setStateIcon'
                                }" />
                        </t:template>
                    </t:Column>

                    <t:Column
                        width="10rem"
                        sortProperty="ProcessResult"
                        label="{i18n>ProcessResult}"
                    >
                        <t:template>
                            <Text
                                text="{local>ProcessResult}"
                                tooltip="{local>ProcessResult}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>

                    <t:Column
                        width="10rem"
                        sortProperty="Plant"
                        label="{i18n>Plant}"
                    >
                        <t:template>
                            <Text
                                text="{local>Plant}"
                                tooltip="{local>Plant}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="DeliveryMaterial"
                        label="{i18n>DeliveryMaterial}"
                    >
                        <t:template>
                            <Text
                                text="{local>DeliveryMaterial}"
                                tooltip="{local>DeliveryMaterial}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="ReceiptMaterial"
                        label="{i18n>ReceiptMaterial}"
                    >
                        <t:template>
                            <Text
                                text="{local>ReceiptMaterial}"
                                tooltip="{local>ReceiptMaterial}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="PoNo"
                        label="{i18n>PoNo}"
                    >
                        <t:template>
                            <Text
                                text="{local>PoNo}"
                                tooltip="{local>PoNo}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        sortProperty="PoItemNo"
                        label="{i18n>PoItemNo}"
                    >
                        <t:template>
                            <Text
                                text="{local>PoItemNo}"
                                tooltip="{local>PoItemNo}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="DeliveryNoteNo"
                        label="{i18n>DeliveryNoteNo}"
                    >
                        <t:template>
                            <Text
                                text="{local>DeliveryNoteNo}"
                                tooltip="{local>DeliveryNoteNo}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="8rem"
                        sortProperty="DeliveryNoteItemNo"
                        label="{i18n>DeliveryNoteItemNo}"
                    >
                        <t:template>
                            <Text
                                text="{local>DeliveryNoteItemNo}"
                                tooltip="{local>DeliveryNoteItemNo}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="MaterialDocumentNo"
                        label="{i18n>MaterialDocumentNo}"
                    >
                        <t:template>
                            <Text
                                text="{local>MaterialDocumentNo}"
                                tooltip="{local>MaterialDocumentNo}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="MaterialDocumentItemNo"
                        label="{i18n>MaterialDocumentItemNo}"
                    >
                        <t:template>
                            <Text
                                text="{local>MaterialDocumentItemNo}"
                                tooltip="{local>MaterialDocumentItemNo}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="PostQty"
                        label="{i18n>PostQty}"
                    >
                        <t:template>
                            <Text
                                text="{local>PostQty}"
                                tooltip="{local>PostQty}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="DeliveryQuantityUnit"
                        label="{i18n>DeliveryQuantityUnit}"
                    >
                        <t:template>
                            <Text
                                text="{local>DeliveryQuantityUnit}"
                                tooltip="{local>DeliveryQuantityUnit}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="MaterialDocumentYear"
                        label="{i18n>MaterialDocumentYear}"
                    >
                        <t:template>
                            <Text
                                text="{local>MaterialDocumentYear}"
                                tooltip="{local>MaterialDocumentYear}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="DDStorageLocation"
                        label="{i18n>DDStorageLocation}"
                    >
                        <t:template>
                            <Text
                                text="{local>DDStorageLocation}"
                                tooltip="{local>DDStorageLocation}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="POStorageLocation"
                        label="{i18n>POStorageLocation}"
                    >
                        <t:template>
                            <Text
                                text="{local>POStorageLocation}"
                                tooltip="{local>POStorageLocation}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="ReversedInd"
                        label="{i18n>ReversedInd}"
                    >
                        <t:template>
                            <Text
                                text="{local>ReversedInd}"
                                tooltip="{local>ReversedInd}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="ReversedMatDocument"
                        label="{i18n>ReversedMatDocument}"
                    >
                        <t:template>
                            <Text
                                text="{local>ReversedMatDocument}"
                                tooltip="{local>ReversedMatDocument}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="PostingDate"
                        label="{i18n>PostingDate}"
                    >
                        <t:template>
                            <Text
                                text="{local>PostingDate}"
                                tooltip="{local>PostingDate}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="ReversedPostingDate"
                        label="{i18n>ReversedPostingDate}"
                    >
                        <t:template>
                            <Text
                                text="{local>ReversedPostingDate}"
                                tooltip="{local>ReversedPostingDate}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="OrderQuantity"
                        label="{i18n>OrderQuantity}"
                    >
                        <t:template>
                            <Text
                                text="{local>OrderQuantity}"
                                tooltip="{local>OrderQuantity}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="PurchaseOrderQuantityUnit"
                        label="{i18n>PurchaseOrderQuantityUnit}"
                    >
                        <t:template>
                            <Text
                                text="{local>PurchaseOrderQuantityUnit}"
                                tooltip="{local>PurchaseOrderQuantityUnit}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                    <t:Column
                        width="10rem"
                        sortProperty="TotalQuantity"
                        label="{i18n>TotalQuantity}"
                    >
                        <t:template>
                            <Text
                                text="{local>TotalQuantity}"
                                tooltip="{local>TotalQuantity}"
                                wrapping="false"
                            />
                        </t:template>
                    </t:Column>
                </t:columns>
            </t:Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>