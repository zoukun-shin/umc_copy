                                <smartFilterBar:ControlConfiguration index='280' key="IQC_PostMaterialDocument" visibleInAdvancedArea="true" label="{i18n>IQC_PostMaterialDocument}"/>
                                <smartFilterBar:ControlConfiguration index='290' key="ItemDeleteFlag" visibleInAdvancedArea="true" label="{i18n>DeleteFlag}"/>
                                <!-- visible -->
                                <smartFilterBar:ControlConfiguration index='999' key="NG_ItemNo" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="HeaderDeleteFlag" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="HeaderCreatedBy" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="HeaderCreatedAt" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="HeaderLastChangedBy" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="HeaderLastChangedAt" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="HeaderLocalLastChangedAt" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="Quantity" visible="false"/>
