                                <smartFilterBar:ControlConfiguration index='999' key="Assembly" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="NG_Position" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="Symptom" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="CounterMeasure" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="RootCause" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="ItemLastChangedAt" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="ItemLocalLastChangedAt" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="IQC_NG_Quantity" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="IQC_OK_Quantity" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="IQC_Remark" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="IQC_LastChangedBy" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="IQC_LastChangedAt" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="Status" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="Message" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="PlantName" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="MoveTypeText" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="MaterialTypeText" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="LocationFromName" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="LocationTo1Name" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="LocationTo2Name" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="MaterialName" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="AssemblyName" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="CustomerName" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="WorkCenterText" visible="false"/>
