<mvc:View controllerName="pp.zngmanangement.controller.Main" displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:sv="sap.ui.comp.smartvariants">
    <f:DynamicPage headerExpanded="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <sv:SmartVariantManagement id="__SVM01" persistencyKey="NG_ReportSVM" showShare="true" showExecuteOnSelection="true" entitySet="NG_Report"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <f:content>
                    <FlexBox fitContainer="true">
                        <smartFilterBar:SmartFilterBar id="idSmartFilterBar" entitySet="NG_Report" useToolbar="false" smartVariant="__SVM01" persistencyKey="NG_ReportSFB" search="onSearch">
                            <smartFilterBar:controlConfiguration>
                                <!-- mandatory="mandatory" -->
                                <smartFilterBar:ControlConfiguration index='10' key="Plant" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>Plant}" mandatory="mandatory"/>
                                <smartFilterBar:ControlConfiguration index='20' key="NG_No" visibleInAdvancedArea="true" label="{i18n>NG_No}"/>
                                <smartFilterBar:ControlConfiguration index='30' key="MoveType" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>MoveType}"/>
                                <smartFilterBar:ControlConfiguration index='40' key="MaterialType" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>MaterialType}"/>
                                <smartFilterBar:ControlConfiguration index='50' key="LocationFrom" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>LocationFrom}"/>
                                <smartFilterBar:ControlConfiguration index='60' key="LocationTo1" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>LocationTo1}"/>
                                <smartFilterBar:ControlConfiguration index='70' key="LocationTo2" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>LocationTo2}"/>
                                <smartFilterBar:ControlConfiguration index='80' key="Material" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>NG_Material}"/>
                                <smartFilterBar:ControlConfiguration index='90' key="ProductionOrder" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>ProductionOrder}"/>
                                <smartFilterBar:ControlConfiguration index='100' key="Customer" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>Customer}"/>
                                <smartFilterBar:ControlConfiguration index='110' key="FoundDate" visibleInAdvancedArea="true" label="{i18n>FoundDate}" mandatory="mandatory"/>
                                <smartFilterBar:ControlConfiguration index='120' key="WorkCenter" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>NG_WorkCenter}"/>
                                <smartFilterBar:ControlConfiguration index='130' key="Shift" visibleInAdvancedArea="true" label="{i18n>Shift}"/>
                                <smartFilterBar:ControlConfiguration index='140' key="Factor" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>Factor}"/>
                                <smartFilterBar:ControlConfiguration index='150' key="ItemCreatedBy" visibleInAdvancedArea="true" label="{i18n>ItemCreatedBy}"/>
                                <smartFilterBar:ControlConfiguration index='160' key="ItemCreatedAt" visibleInAdvancedArea="true" label="{i18n>ItemCreatedAt}"/>
                                <smartFilterBar:ControlConfiguration index='170' key="ItemLastChangedBy" visibleInAdvancedArea="true" label="{i18n>ItemLastChangedBy}"/>
                                <smartFilterBar:ControlConfiguration index='180' key="Move1PostStatus" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>Move1PostStatus}"/>
                                <smartFilterBar:ControlConfiguration index='190' key="Move1PostBy" visibleInAdvancedArea="true" label="{i18n>Move1PostBy}"/>
                                <smartFilterBar:ControlConfiguration index='200' key="Move1PostAt" visibleInAdvancedArea="true" label="{i18n>Move1PostAt}"/>
                                <smartFilterBar:ControlConfiguration index='210' key="Move1PostMaterialDocument" visibleInAdvancedArea="true" label="{i18n>Move1PostMaterialDocument}"/>
                                <smartFilterBar:ControlConfiguration index='220' key="IQC_ApprovedBy" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>IQC_ApprovedBy}"/>
                                <smartFilterBar:ControlConfiguration index='230' key="IQC_CreatedBy" visibleInAdvancedArea="true" label="{i18n>IQC_CreatedBy}"/>
                                <smartFilterBar:ControlConfiguration index='240' key="IQC_CreatedAt" visibleInAdvancedArea="true" label="{i18n>IQC_CreatedAt}"/>
