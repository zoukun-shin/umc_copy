<mvc:View xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.uxap"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:m="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:smartForm="sap.ui.comp.smartform"
    xmlns:smartField="sap.ui.comp.smartfield" controllerName="pp.zngmanangement.controller.Detail" height="100%" core:require="{ handler: 'pp/zngmanangement/controller/ValueHelpDialog' }">
    <ObjectPageLayout id="ObjectPageLayout" enableLazyLoading="true" showFooter="true" showTitleInHeaderContent="true" upperCaseAnchorBar="false">
        <headerTitle>
            <ObjectPageDynamicHeaderTitle>
                <expandedHeading>
                    <m:Title text="{local>/NG_No}" wrapping="true"/>
                </expandedHeading>
                <snappedHeading>
                    <m:FlexBox fitContainer="true" alignItems="Center">
                        <m:Title text="{local>/NG_No}" wrapping="true" />
                    </m:FlexBox>
                </snappedHeading>
                <actions>
                    <m:Button id="idButtonEdit" type="Emphasized" text="{i18n>Edit}" press="onEdit" enabled="{= ${local>/authorityCheck/button/Edit}}" visible="{= ${local>/NG_Header/DeleteFlag} === false}"/>
                    <m:Button id="idButtonDelete" type="Transparent" text="{i18n>Delete}" press="onPressFunction('DeleteNG')" enabled="{= ${local>/authorityCheck/button/DeleteNG}}" visible="{= ${local>/NG_Header/DeleteFlag} === false}"/>
                </actions>
            </ObjectPageDynamicHeaderTitle>
        </headerTitle>
        <sections>
            <ObjectPageSection id="idNG_Header" titleUppercase="false" title="{i18n>NG_Header}">
                <heading>
                    <m:MessageStrip id="idMessageStrip" text="{i18n>DeletedStatus}" type="Error" visible="false"/>
                </heading>
                <ObjectPageSubSection id="idNG_Header_SS" title="{i18n>NG_Header}" titleUppercase="false">
                    <blocks>
                        <f:SimpleForm id="idNG_Header_SF" editable="true" layout="ColumnLayout" columnsM="2" columnsL="3" columnsXL="4">
                            <f:content>
                                <core:Title text="{i18n>General}" />
                                <m:Label text="{i18n>Plant}" required="true"/>
                                <m:Text text="{ parts:[ 'local>/NG_Header/Plant','local>/NG_Header/PlantName'], formatter:'.formatter.formatCodeName' }"/>

                                <m:Label text="{i18n>MoveType}" required="true"/>
                                <m:Select id="idMoveType" items="{ path: 'local>/MoveTypeVH', sorter: { path: 'MoveType' } }" selectedKey="{local>/NG_Header/MoveType}" showSecondaryValues="true" change="onMoveTypeChange">
                                    <m:items>
                                        <core:Item key="{local>MoveType}" text="{local>MoveType} ({local>MoveTypeText})" />
                                    </m:items>
                                </m:Select>

                                <m:Label text="{i18n>MaterialType}" required="true"/>
                                <m:Select id="idMaterialType" items="{ path: 'local>/MaterialTypeVH', sorter: { path: 'MaterialType' } }" selectedKey="{local>/NG_Header/MaterialType}" showSecondaryValues="true">
                                    <m:items>
                                        <core:Item key="{local>MaterialType}" text="{local>MaterialType} ({local>MaterialTypeText})" />
                                    </m:items>
                                </m:Select>

                                <m:Label text="{i18n>LocationFrom}" required="true"/>
                                <m:Text id="idLocationFromText" text="{ parts:[ 'local>/NG_Header/LocationFrom','local>/NG_Header/LocationFromName'], formatter:'.formatter.formatCodeName' }"/>
                                <m:Input id="idLocationFromInput" value="{local>/NG_Header/LocationFrom}" required="true" maxLength="4" change="onInputChange" showValueHelp="true" valueHelpRequest="handler.onValueHelpRequested(
                                $event, $controller, '/I_StorageLocationStdVH', ['StorageLocation', 'StorageLocationName'], ['StorageLocation', 'StorageLocationName'])" showSuggestion="true" suggest="handleSuggest" suggestionRows="{ path: '/I_StorageLocationStdVH', length: 4 }">
                                    <m:suggestionColumns>
                                        <m:Column>
                                            <m:Label text="{i18n>StorageLocation}"/>
                                        </m:Column>
                                        <m:Column>
                                            <m:Label text="{i18n>StorageLocationName}"/>
                                        </m:Column>
                                    </m:suggestionColumns>
                                    <m:suggestionRows>
                                        <m:ColumnListItem>
                                            <m:Label text="{StorageLocation}" />
                                            <m:Label text="{StorageLocationName}" />
                                        </m:ColumnListItem>
                                    </m:suggestionRows>
                                </m:Input>

                                <m:Label text="{i18n>LocationTo1}" required="true" />
                                <m:Text id="idLocationTo1Text" text="{ parts:[ 'local>/NG_Header/LocationTo1','local>/NG_Header/LocationTo1Name'], formatter:'.formatter.formatCodeName' }" />
                                <m:Input id="idLocationTo1Input" value="{local>/NG_Header/LocationTo1}" required="true" maxLength="4" change="onInputChange" showValueHelp="true" valueHelpRequest="handler.onValueHelpRequested(
                                $event, $controller, '/I_StorageLocationStdVH', ['StorageLocation', 'StorageLocationName'], ['StorageLocation', 'StorageLocationName'])" showSuggestion="true" suggest="handleSuggest" suggestionRows="{ path: '/I_StorageLocationStdVH', length: 4 }">
                                    <m:suggestionColumns>
                                        <m:Column>
                                            <m:Label text="{i18n>StorageLocation}"/>
                                        </m:Column>
                                        <m:Column>
                                            <m:Label text="{i18n>StorageLocationName}"/>
                                        </m:Column>
                                    </m:suggestionColumns>
                                    <m:suggestionRows>
                                        <m:ColumnListItem>
                                            <m:Label text="{StorageLocation}" />
                                            <m:Label text="{StorageLocationName}" />
                                        </m:ColumnListItem>
                                    </m:suggestionRows>
                                </m:Input>

                                <m:Label id="idLocationTo2Label" text="{i18n>LocationTo2}" />
                                <m:Text id="idLocationTo2Text" text="{ parts:[ 'local>/NG_Header/LocationTo2','local>/NG_Header/LocationTo2Name'], formatter:'.formatter.formatCodeName' }" />
                                <m:Input id="idLocationTo2Input" value="{local>/NG_Header/LocationTo2}" maxLength="4" change="onInputChange" showValueHelp="true" valueHelpRequest="handler.onValueHelpRequested(
                                $event, $controller, '/I_StorageLocationStdVH', ['StorageLocation', 'StorageLocationName'], ['StorageLocation', 'StorageLocationName'])" showSuggestion="true" suggest="handleSuggest" suggestionRows="{ path: '/I_StorageLocationStdVH', length: 4 }">
                                    <m:suggestionColumns>
                                        <m:Column>
                                            <m:Label text="{i18n>StorageLocation}"/>
                                        </m:Column>
                                        <m:Column>
                                            <m:Label text="{i18n>StorageLocationName}"/>
                                        </m:Column>
                                    </m:suggestionColumns>
                                    <m:suggestionRows>
                                        <m:ColumnListItem>
                                            <m:Label text="{StorageLocation}" />
                                            <m:Label text="{StorageLocationName}" />
                                        </m:ColumnListItem>
                                    </m:suggestionRows>
                                </m:Input>

                                <core:Title text="{i18n>Administrative}" />
                                <m:Label text="{i18n>CreatedBy}" />
                                <m:Text text="{ parts:[ 'local>/NG_Header/CreatedBy','local>/NG_Header/CreatedByName'], formatter:'.formatter.formatCodeName' }"/>

                                <m:Label text="{i18n>CreatedAt}" />
                                <m:Text text="{ path: 'local>/NG_Header/CreatedAt', 'type':'sap.ui.model.type.Date' }"/>

                                <m:Label text="{i18n>LastChangedBy}" />
                                <m:Text text="{ parts:[ 'local>/NG_Header/LastChangedBy','local>/NG_Header/LastChangedByName'], formatter:'.formatter.formatCodeName' }"/>

                                <m:Label text="{i18n>LastChangedAt}" />
                                <m:Text text="{ path: 'local>/NG_Header/LastChangedAt', 'type':'sap.ui.model.type.Date' }"/>
                            </f:content>
                        </f:SimpleForm>
                    </blocks>
                </ObjectPageSubSection>
            </ObjectPageSection>
            <ObjectPageSection id="idNG_Item" titleUppercase="false" title="{i18n>NG_Item}">
                <ObjectPageSubSection id="idNG_Item_SS" title="{i18n>NG_Item}" titleUppercase="false">
                    <blocks>
                        <core:Fragment fragmentName="pp.zngmanangement.fragments.NG_Item" type="XML"/>
                    </blocks>
                </ObjectPageSubSection>
            </ObjectPageSection>
            <ObjectPageSection id="idNG_ItemIQC" titleUppercase="false" title="{i18n>NG_ItemIQC}" visible="{= ${local>/NG_Header/MoveType} === '2'}">
                <subSections>
                    <ObjectPageSubSection id="idNG_ItemIQC_SS" titleUppercase="false" title="{i18n>NG_ItemIQC}">
                        <blocks>
                            <core:Fragment fragmentName="pp.zngmanangement.fragments.NG_ItemIQC" type="XML"/>
                        </blocks>
                    </ObjectPageSubSection>
                </subSections>
            </ObjectPageSection>
        </sections>
        <footer>
            <m:OverflowToolbar>
                <m:Button type="Emphasized" icon="sap-icon://alert" text="{= ${message>/}.length }" visible="{= ${message>/}.length > 0}" press="onMessagePopoverPress" />
                <m:ToolbarSpacer/>
                <m:Button type="Emphasized" text="{i18n>Save}" press="onPressFunction('Save')" enabled="{= ${local>/authorityCheck/button/Save}}" visible="{local>/Control/showFooter}"/>
                <m:Button type="Transparent" text="{i18n>Cancel}" press="onCancel" visible="{local>/Control/showFooter}"/>
            </m:OverflowToolbar>
        </footer>
    </ObjectPageLayout>
</mvc:View>

