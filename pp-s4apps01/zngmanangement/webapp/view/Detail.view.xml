<mvc:View xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.uxap"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:m="sap.m"
    xmlns:smartForm="sap.ui.comp.smartform"
    xmlns:smartField="sap.ui.comp.smartfield" controllerName="pp.zngmanangement.controller.Detail" height="100%">
    <ObjectPageLayout id="ObjectPageLayout" enableLazyLoading="true" showFooter="{local>/Control/showFooter}" showTitleInHeaderContent="true" upperCaseAnchorBar="false">
        <headerTitle>
            <ObjectPageDynamicHeaderTitle>
                <expandedHeading>
                    <m:Title text="{local>/NG_No}" wrapping="true"/>
                </expandedHeading>
                <snappedHeading>
                    <m:FlexBox fitContainer="true" alignItems="Center">
                        <m:Title text="{local>/NG_No}" wrapping="true" />
                    </m:FlexBox>
                </snappedHeading>
                <actions>
                    <m:Button id="idButtonEdit" type="Emphasized" text="{i18n>Edit}" press="onEdit"/>
                    <m:Button id="idButtonDelete" type="Transparent" text="{i18n>Delete}" press="onPressFunction('DELETE')"/>
                </actions>
            </ObjectPageDynamicHeaderTitle>
        </headerTitle>
        <sections>
            <ObjectPageSection id="idNG_Header" titleUppercase="false" title="{i18n>NG_Header}">
                <ObjectPageSubSection id="idNG_Header_SS" title="{i18n>NG_Header}" titleUppercase="false">
                    <blocks>
                        <smartForm:SmartForm id="idNG_Header_SF" editable="true" validationMode="Async">
                            <smartForm:layout>
                                <smartForm:ColumnLayout columnsM="2" columnsL="3" columnsXL="4"/>
                            </smartForm:layout>
                            <smartForm:Group title="SmartFields with High importance">
                                <smartForm:GroupElement>
                                    <smartField:SmartField id="idPlant" textLabel="{i18n>Plant}" value="{Plant}" importance="High" mandatory="true" editable="true" change="onSmartFieldInputChange" maxLength="4">
                                        <smartField:configuration>
                                            <smartField:Configuration displayBehaviour="idAndDescription" />
                                        </smartField:configuration>
                                    </smartField:SmartField>
                                </smartForm:GroupElement>
                                <smartForm:GroupElement>
                                    <smartField:SmartField textLabel="{i18n>MoveType}" value="{MoveType}" importance="High" mandatory="true" editable="{local>/Control/editable}" change="onSmartFieldInputChange" maxLength="2">
                                        <smartField:configuration>
                                            <smartField:Configuration displayBehaviour="idAndDescription" />
                                        </smartField:configuration>
                                    </smartField:SmartField>
                                </smartForm:GroupElement>
                                <smartForm:GroupElement>
                                    <smartField:SmartField textLabel="{i18n>MaterialType}" value="{MaterialType}" importance="High" mandatory="true" editable="{local>/Control/editable}" change="onSmartFieldInputChange" maxLength="2">
                                        <smartField:configuration>
                                            <smartField:Configuration displayBehaviour="idAndDescription" />
                                        </smartField:configuration>
                                    </smartField:SmartField>
                                </smartForm:GroupElement>
                            </smartForm:Group>
                            <smartForm:Group title="SmartFields with Medium importance">
                                <smartForm:GroupElement>
                                    <smartField:SmartField textLabel="{i18n>LocationFrom}" value="{LocationFrom}" importance="Medium" mandatory="true" editable="{local>/Control/editable}" change="onSmartFieldInputChange" maxLength="4">
                                        <smartField:configuration>
                                            <smartField:Configuration displayBehaviour="idAndDescription" />
                                        </smartField:configuration>
                                    </smartField:SmartField>
                                    <smartField:SmartField textLabel="{i18n>LocationFromName}" value="{LocationFromName}" importance="High" />
                                </smartForm:GroupElement>
                                <smartForm:GroupElement>
                                    <smartField:SmartField textLabel="{i18n>LocationTo1}" value="{LocationTo1}" importance="Medium" mandatory="true" editable="{local>/Control/editable}" change="onSmartFieldInputChange" maxLength="4">
                                        <smartField:configuration>
                                            <smartField:Configuration displayBehaviour="idAndDescription" />
                                        </smartField:configuration>
                                    </smartField:SmartField>
                                    <smartField:SmartField textLabel="{i18n>LocationTo1Name}" value="{LocationTo1Name}" importance="High" />
                                </smartForm:GroupElement>
                                <smartForm:GroupElement>
                                    <smartField:SmartField textLabel="{i18n>LocationTo2}" value="{LocationTo2}" importance="Medium" mandatory="true" editable="{local>/Control/editable}" change="onSmartFieldInputChange" maxLength="4">
                                        <smartField:configuration>
                                            <smartField:Configuration displayBehaviour="idAndDescription" />
                                        </smartField:configuration>
                                    </smartField:SmartField>
                                    <smartField:SmartField textLabel="{i18n>LocationTo2Name}" value="{LocationTo2Name}" importance="High" />
                                </smartForm:GroupElement>
                            </smartForm:Group>
                            <smartForm:Group title="SmartFields with Low importance">
                                <smartForm:GroupElement>
                                    <smartField:SmartField textLabel="{i18n>CreatedBy}" value="{CreatedBy}" importance="Medium"/>
                                </smartForm:GroupElement>
                                <smartForm:GroupElement>
                                    <smartField:SmartField textLabel="{i18n>CreatedAt}" value="{CreatedAt}" importance="Medium"/>
                                </smartForm:GroupElement>
                                <smartForm:GroupElement>
                                    <smartField:SmartField textLabel="{i18n>LastChangedBy}" value="{LastChangedBy}" importance="Medium"/>
                                </smartForm:GroupElement>
                                <smartForm:GroupElement>
                                    <smartField:SmartField textLabel="{i18n>LastChangedAt}" value="{LastChangedAt}" importance="Medium"/>
                                </smartForm:GroupElement>
                            </smartForm:Group>
                        </smartForm:SmartForm>
                    </blocks>
                </ObjectPageSubSection>
            </ObjectPageSection>
            <ObjectPageSection id="idNG_Item" titleUppercase="false" title="{i18n>NG_Item}">
                <ObjectPageSubSection id="idNG_Item_SS" title="{i18n>NG_Item}" titleUppercase="false">
                    <blocks>
                        <core:Fragment fragmentName="pp.zngmanangement.fragments.NG_Item" type="XML"/>
                    </blocks>
                </ObjectPageSubSection>
            </ObjectPageSection>
            <ObjectPageSection id="idNG_ItemIQC" titleUppercase="false" title="{i18n>NG_ItemIQC}">
                <subSections>
                    <ObjectPageSubSection id="idNG_ItemIQC_SS" titleUppercase="false" title="{i18n>NG_ItemIQC}">
                        <blocks>
                            <core:Fragment fragmentName="pp.zngmanangement.fragments.NG_ItemIQC" type="XML"/>
                        </blocks>
                    </ObjectPageSubSection>
                </subSections>
            </ObjectPageSection>
        </sections>
        <footer>
            <m:OverflowToolbar>
                <m:Button type="Emphasized" icon="sap-icon://alert" text="{= ${message>/}.length }" visible="{= ${message>/}.length > 0}" press="onMessagePopoverPress" />
                <m:ToolbarSpacer/>
                <m:Button type="Emphasized" text="{i18n>Save}" press="onPressFunction('SAVE')"/>
                <m:Button type="Transparent" text="{i18n>Cancel}" press="onCancel"/>
            </m:OverflowToolbar>
        </footer>
    </ObjectPageLayout>
</mvc:View>

