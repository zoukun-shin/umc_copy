<core:FragmentDefinition xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:unified="sap.ui.unified"
    xmlns:layout="sap.ui.layout"
    xmlns:table="sap.ui.table"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:smartTable="sap.ui.comp.smarttable">
    <table:Table id="idNG_Item_IQCTable" rows="{local>/NG_Header/to_NG_Item/results}" rowSelectionChange="rowSelectionChange" selectionBehavior="Row" fixedColumnCount="2" selectionMode="Multi" rowMode="Interactive" class="sapUiSizeCompact">
        <table:extension>
            <OverflowToolbar>
                <ToolbarSpacer/>
                <Button id="idNGItemIQCClearBtn" icon="sap-icon://clear-all" type="Ghost" text="{i18n>ClearLine}" press="onNG_ItemIQC($event,'CLEAR')" enabled="{= ${local>/Control/editable} &amp;&amp; ${local>/Control/enabled}}" visible="{= ${local>/NG_Header/DeleteFlag} === 'X' ? false : true}"/>
            </OverflowToolbar>
        </table:extension>
        <table:columns>
            <table:Column width="3.5rem" label="{i18n>DeleteFlag}">
                <table:template>
                    <Button icon="{ path: 'local>DeleteFlag', formatter:'.formatter.formatDeleteFlagButton'}" />
                </table:template>
            </table:Column>
            <table:Column width="7rem" label="{i18n>NG_ItemNo}">
                <table:template>
                    <Text text="{local>NG_ItemNo}" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="20rem" label="{i18n>NG_Material}">
                <table:template>
                    <Text text="{ parts:[ 'local>Material','local>MaterialName'], formatter:'.formatter.formatCodeName' }" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>Quantity}" hAlign="End">
                <table:template>
                    <Text text="{local>Quantity} {local>BaseUnit}" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="15rem" hAlign="End">
                <Label text="{i18n>IQC_NG_Quantity}" required="true"/>
                <table:template>
                    <Input value="{ path: 'local>IQC_NG_Quantity',
                                    type: 'sap.ui.model.type.Float',
                                    formatOptions: {
                                        groupingEnabled: true,
                                        groupingSeparator: ',',
                                        decimalSeparator: '.'
                                    } 
                                  }" description="{local>BaseUnit}" fieldWidth="80%" required="true" editable="{= ${local>/Control/editable} &amp;&amp; ${local>Move1PostStatus} === 'P' &amp;&amp; ${local>IQC_PostStatus} === ''}"/>
                </table:template>
            </table:Column>
            <table:Column width="15rem" hAlign="End">
                <Label text="{i18n>IQC_OK_Quantity}" required="true"/>
                <table:template>
                    <Input value="{ path: 'local>IQC_OK_Quantity',
                                    type: 'sap.ui.model.type.Float',
                                    formatOptions: {
                                        groupingEnabled: true,
                                        groupingSeparator: ',',
                                        decimalSeparator: '.'
                                    } 
                                  }" description="{local>BaseUnit}" fieldWidth="80%" required="true" editable="{= ${local>/Control/editable} &amp;&amp; ${local>Move1PostStatus} === 'P' &amp;&amp; ${local>IQC_PostStatus} === ''}"/>
                </table:template>
            </table:Column>
            <table:Column width="15rem">
                <Label text="{i18n>IQC_ApprovedBy}" required="true"/>
                <table:template>
                    <Input value="{local>IQC_ApprovedBy}" required="true" editable="{= ${local>/Control/editable} &amp;&amp; ${local>Move1PostStatus} === 'P' &amp;&amp; ${local>IQC_PostStatus} === ''}"/>
                </table:template>
            </table:Column>
            <table:Column width="20rem" label="{i18n>IQC_Remark}">
                <table:template>
                    <Input value="{local>IQC_Remark}" editable="{= ${local>/Control/editable} &amp;&amp; ${local>Move1PostStatus} === 'P' &amp;&amp; ${local>IQC_PostStatus} === ''}"/>
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>IQC_PostStatus}">
                <table:template>
                    <Text text="{local>IQC_PostStatus}" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="15rem" label="{i18n>IQC_CreatedBy}" visible="{= ${local>/Operation} !== 'Create'}">
                <table:template>
                    <!-- <Text text="{ parts:[ 'local>IQC_CreatedBy','local>IQC_CreatedByName'], formatter:'.formatter.formatCodeName' }" wrapping="false"/> -->
                    <Text text="{local>IQC_CreatedByName}" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="15rem" label="{i18n>IQC_CreatedAt}" visible="{= ${local>/Operation} !== 'Create'}">
                <table:template>
                    <Text text="{ path: 'local>IQC_CreatedAt', 'type':'sap.ui.model.type.Date' }" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="15rem" label="{i18n>IQC_LastChangedBy}" visible="{= ${local>/Operation} !== 'Create'}">
                <table:template>
                    <!-- <Text text="{ parts:[ 'local>IQC_LastChangedBy','local>IQC_LastChangedByName'], formatter:'.formatter.formatCodeName' }" wrapping="false"/> -->
                    <Text text="{local>IQC_LastChangedByName}" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="15rem" label="{i18n>IQC_LastChangedAt}" visible="{= ${local>/Operation} !== 'Create'}">
                <table:template>
                    <Text text="{ path: 'local>IQC_LastChangedAt', 'type':'sap.ui.model.type.Date' }" wrapping="false"/>
                </table:template>
            </table:Column>
        </table:columns>
    </table:Table>
</core:FragmentDefinition>