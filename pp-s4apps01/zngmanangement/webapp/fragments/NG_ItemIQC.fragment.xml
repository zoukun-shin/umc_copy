<core:FragmentDefinition xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:unified="sap.ui.unified"
    xmlns:layout="sap.ui.layout"
    xmlns:table="sap.ui.table"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:smartTable="sap.ui.comp.smarttable">
    <table:Table id="idNG_Item_IQCTable" rows="{local>/NG_Item}" selectionMode="Multi" rowMode="Interactive" class="sapUiSizeCompact">
        <table:extension>
            <OverflowToolbar>
                <ToolbarSpacer/>
                <Button icon="sap-icon://clear-all" type="Ghost" text="{i18n>ClearLine}" press="onNG_ItemIQC($event,'CLEAR')" />
            </OverflowToolbar>
        </table:extension>
        <table:columns>
            <table:Column width="8rem" label="{i18n>NG_ItemNo}">
                <table:template>
                    <Text text="{local>NG_ItemNo}" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>NG_Material}">
                <table:template>
                    <Text text="{local>Material}" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>NG_MaterialName}">
                <table:template>
                    <Text text="{local>MaterialName}" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>Quantity}" hAlign="End">
                <table:template>
                    <Text text="{local>Quantity} {local>BaseUnit}" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="15rem" label="{i18n>IQC_NG_Quantity}" hAlign="End">
                <table:template>
                    <Input value="{ path: 'local>IQC_NG_Quantity',
                                    type: 'sap.ui.model.type.Float',
                                    formatOptions: {
                                        groupingEnabled: true,
                                        groupingSeparator: ',',
                                        decimalSeparator: '.'
                                    } 
                                  }" description="{local>BaseUnit}" fieldWidth="80%" editable="{local>/Control/editable}"/>
                </table:template>
            </table:Column>
            <table:Column width="15rem" label="{i18n>IQC_OK_Quantity}" hAlign="End">
                <table:template>
                    <Input value="{ path: 'local>IQC_OK_Quantity',
                                    type: 'sap.ui.model.type.Float',
                                    formatOptions: {
                                        groupingEnabled: true,
                                        groupingSeparator: ',',
                                        decimalSeparator: '.'
                                    } 
                                  }" description="{local>BaseUnit}" fieldWidth="80%" editable="{local>/Control/editable}"/>
                </table:template>
            </table:Column>
            <table:Column width="15rem" label="{i18n>IQC_ApprovedBy}">
                <table:template>
                    <Input value="{local>IQC_ApprovedBy}" editable="{local>/Control/editable}"/>
                </table:template>
            </table:Column>
            <table:Column width="20rem" label="{i18n>IQC_Remark}">
                <table:template>
                    <Input value="{local>IQC_Remark}" editable="{local>/Control/editable}"/>
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>IQC_CreatedBy}" visible="{= ${local>/Operation} !== 'Create'}">
                <table:template>
                    <Text text="{local>IQC_CreatedBy}" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>IQC_CreatedAt}" visible="{= ${local>/Operation} !== 'Create'}">
                <table:template>
                    <Text text="{local>IQC_CreatedAt}" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>IQC_LastChangedBy}" visible="{= ${local>/Operation} !== 'Create'}">
                <table:template>
                    <Text text="{local>IQC_LastChangedBy}" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>IQC_LastChangedAt}" visible="{= ${local>/Operation} !== 'Create'}">
                <table:template>
                    <Text text="{local>IQC_LastChangedAt}" wrapping="false"/>
                </table:template>
            </table:Column>
        </table:columns>
    </table:Table>
</core:FragmentDefinition>