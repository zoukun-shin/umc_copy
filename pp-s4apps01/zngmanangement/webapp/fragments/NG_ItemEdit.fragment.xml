<core:FragmentDefinition xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
    xmlns:table="sap.ui.table" core:require="{ handler: 'pp/zngmanangement/controller/ValueHelpDialog' }">
    <Dialog title="{i18n>EditDialog} {i18n>NG_ItemNo} {local>/ItemEdit/NG_ItemNo}" draggable="true">
        <VBox class="sapUiSmallMargin">
            <HBox>
                <VBox class="sapUiTinyMargin" width="33%">
                    <Label text="{i18n>ProductionOrder}" class="sapUiSmallMarginEnd"/>
                    <Input value="{local>/ItemEdit/ProductionOrder}" editable="{= ${local>/ItemEdit/Move1PostStatus} === ''}" suggestionItemSelected="true" change="handler.handleChange" showValueHelp="true" valueHelpRequest="handler.onValueHelpRequested(
                                $event, $controller, '/ZC_ManufacturingOrderProductVH', 
                                ['ManufacturingOrder','Material','MaterialDescription','Assembly','ProductionPlant'],['ManufacturingOrder','Material','MaterialDescription','Assembly'],'ProductionOrder')" showSuggestion="true" suggest="handleSuggest" suggestionRows="{ path: '/ZC_ManufacturingOrderProductVH', length: 12 }" width="15rem">
                        <suggestionColumns>
                            <Column>
                                <Label text="{i18n>ManufacturingOrder}"/>
                            </Column>
                            <Column>
                                <Label text="{i18n>ItemNo}"/>
                            </Column>
                            <Column>
                                <Label text="{i18n>Material}"/>
                            </Column>
                            <Column>
                                <Label text="{i18n>Assembly}"/>
                            </Column>
                        </suggestionColumns>
                        <suggestionRows>
                            <ColumnListItem>
                                <Label text="{ManufacturingOrder}/{Item}" />
                                <Label text="{Item}"/>
                                <Label text="{Material}" />
                                <Label text="{Assembly}" />
                            </ColumnListItem>
                        </suggestionRows>
                    </Input>
                </VBox>
                <VBox class="sapUiTinyMargin" width="33%">
                    <Label text="{i18n>NG_Material}" class="sapUiSmallMarginEnd" required="true"/>
                    <Input value="{local>/ItemEdit/Material}" editable="{= ${local>/ItemEdit/Move1PostStatus} === ''}" change="handler.handleChange" showValueHelp="true" valueHelpRequest="handler.onValueHelpRequested(
                                $event, $controller, '/ZC_ProductVH',
                                ['Material','MaterialDescription'],['Material','MaterialDescription'],'NG_Material')" showSuggestion="true" suggest="handleSuggest" suggestionRows="{ path: '/ZC_ProductVH', length: 40 }" required="true" width="15rem">
                        <suggestionColumns>
                            <Column>
                                <Label text="{i18n>Material1}"/>
                            </Column>
                            <Column>
                                <Label text="{i18n>MaterialDescription1}"/>
                            </Column>
                        </suggestionColumns>
                        <suggestionRows>
                            <ColumnListItem>
                                <Label text="{Material}" />
                                <Label text="{MaterialDescription}" />
                            </ColumnListItem>
                        </suggestionRows>
                    </Input>
                </VBox>
                <VBox class="sapUiTinyMargin" width="33%">
                    <Label text="{i18n>NG_MaterialName}" class="sapUiSmallMarginEnd"/>
                    <Input value="{local>/ItemEdit/MaterialName}" editable="false" width="15rem"/>
                </VBox>
                <VBox class="sapUiTinyMargin" width="33%">
                    <Label text="{i18n>Assembly}" class="sapUiSmallMarginEnd"/>
                    <Input value="{local>/ItemEdit/Assembly}" editable="false" width="15rem"/>
                </VBox>
            </HBox>
            <HBox>
                <VBox class="sapUiTinyMargin" width="33%">
                    <Label text="{i18n>NG_WorkCenter}" class="sapUiSmallMarginEnd"/>
                    <Input value="{local>/ItemEdit/WorkCenter}" editable="{= ${local>/ItemEdit/Move1PostStatus} === ''}" change="handler.handleChange" showValueHelp="true" valueHelpRequest="handler.onValueHelpRequested(
                        $event, $controller, '/ZC_WorkCenterVH',
                        ['WorkCenter','WorkCenterText'],['WorkCenter','WorkCenterText'],'NG_WorkCenter')" showSuggestion="true" suggest="handleSuggest" suggestionRows="{ path: '/ZC_WorkCenterVH', length: 10 }" required="true" width="15rem">
                        <suggestionColumns>
                            <Column>
                                <Label text="{i18n>WorkCenter}"/>
                            </Column>
                            <Column>
                                <Label text="{i18n>WorkCenterText}"/>
                            </Column>
                        </suggestionColumns>
                        <suggestionRows>
                            <ColumnListItem>
                                <Label text="{WorkCenter}" />
                                <Label text="{WorkCenterText}" />
                            </ColumnListItem>
                        </suggestionRows>
                    </Input>
                </VBox>
                <VBox class="sapUiTinyMargin" width="33%">
                    <Label text="{i18n>NG_WorkCenterName}" class="sapUiSmallMarginEnd"/>
                    <Input value="{local>/ItemEdit/WorkCenterText}" editable="false" width="15rem"/>
                </VBox>
                <VBox class="sapUiTinyMargin" width="33%">
                    <Label text="{i18n>Factor}" class="sapUiSmallMarginEnd" required="true"/>
                    <Input value="{local>/ItemEdit/Factor}" editable="{= ${local>/ItemEdit/Move1PostStatus} === ''}" change="handler.handleChange" showValueHelp="true" valueHelpRequest="handler.onValueHelpRequested(
                        $event, $controller, '/ZC_NG_FACTORVH',
                        ['Factor','FactorText'],['Factor','FactorText'],'Factor')" showSuggestion="true" suggestionRows="{ path: '/ZC_NG_FACTORVH', length: 1 }" required="true" width="15rem">
                        <suggestionColumns>
                            <Column>
                                <Label text="{i18n>Factor}"/>
                            </Column>
                            <Column>
                                <Label text="{i18n>FactorText}"/>
                            </Column>
                        </suggestionColumns>
                        <suggestionRows>
                            <ColumnListItem>
                                <Label text="{Factor}" />
                                <Label text="{FactorText}" />
                            </ColumnListItem>
                        </suggestionRows>
                    </Input>
                </VBox>
                <VBox class="sapUiTinyMargin" width="33%">
                    <Label text="{i18n>FactorText}" class="sapUiSmallMarginEnd"/>
                    <Input value="{local>/ItemEdit/FactorText}" editable="false" width="15rem"/>
                </VBox>
            </HBox>
            <HBox>
                <VBox class="sapUiTinyMargin" width="33%">
                    <Label text="{i18n>Customer}" class="sapUiSmallMarginEnd"/>
                    <Input value="{local>/ItemEdit/Customer}" editable="{= ${local>/ItemEdit/Move1PostStatus} === ''}" change="handler.handleChange" showValueHelp="true" valueHelpRequest="handler.onValueHelpRequested(
                        $event, $controller, '/ZC_CustomerCompanyByPlant', ['Customer','CustomerName'], ['Customer','CustomerName'], 'Customer')" showSuggestion="true" suggest="handleSuggest" suggestionRows="{ path: '/ZC_CustomerCompanyByPlant', length: 10 }" width="15rem">
                        <suggestionColumns>
                            <Column>
                                <Label text="{i18n>Customer}"/>
                            </Column>
                            <Column>
                                <Label text="{i18n>CustomerName}"/>
                            </Column>
                        </suggestionColumns>
                        <suggestionRows>
                            <ColumnListItem>
                                <Label text="{Customer}" />
                                <Label text="{CustomerName}" />
                            </ColumnListItem>
                        </suggestionRows>
                    </Input>
                </VBox>
                <VBox class="sapUiTinyMargin" width="33%">
                    <Label text="{i18n>CustomerName}" class="sapUiSmallMarginEnd"/>
                    <Input value="{local>/ItemEdit/CustomerName}" editable="false" width="15rem"/>
                </VBox>
                <VBox class="sapUiTinyMargin" width="33%">
                    <Label text="{i18n>NG_Position}" class="sapUiSmallMarginEnd"/>
                    <Input value="{local>/ItemEdit/NG_Position}" editable="{= ${local>/ItemEdit/Move1PostStatus} === ''}" width="15rem"/>
                </VBox>
                <VBox class="sapUiTinyMargin" width="33%">
                    <Label text="{i18n>Shift}" class="sapUiSmallMarginEnd"/>
                    <Input value="{local>/ItemEdit/Shift}" editable="{= ${local>/ItemEdit/Move1PostStatus} === ''}" width="15rem"/>
                </VBox>
            </HBox>
            <HBox>
                <VBox class="sapUiTinyMargin" width="33%">
                    <Label text="{i18n>FoundDate}" class="sapUiSmallMarginEnd" required="true"/>
                    <DatePicker value="{
						path:'local>/ItemEdit/FoundDate',
						type:'sap.ui.model.type.Date'
					}" editable="{= ${local>/ItemEdit/Move1PostStatus} === ''}" required="true" width="15rem" change="onDatePickerChange"/>
                </VBox>
                <VBox class="sapUiTinyMargin" width="33%">
                    <Label text="{i18n>Quantity}" class="sapUiSmallMarginEnd" required="true"/>
                    <Input value="{ path: 'local>/ItemEdit/Quantity',
                                    type: 'sap.ui.model.type.Float',
                                    formatOptions: {
                                        groupingEnabled: true,
                                        groupingSeparator: ',',
                                        decimalSeparator: '.'
                                    } }" editable="{= ${local>/ItemEdit/Move1PostStatus} === ''}" required="true" width="150%" description="{local>/ItemEdit/BaseUnit}"/>
                </VBox>
                <!-- ADD BEGIN BY XINLEI XU 2026/07/22 CN 需求 No.392 & No.394 -->
                <VBox class="sapUiTinyMargin" width="33%">
                    <Label text="{i18n>RefMaterial}" class="sapUiSmallMarginEnd"/>
                    <Input value="{local>/ItemEdit/RefMaterial}" editable="{= ${local>/ItemEdit/Move1PostStatus} === ''}" change="handler.handleChange" showValueHelp="true" valueHelpRequest="handler.onValueHelpRequested(
                                $event, $controller, '/ZC_ProductVH',
                                ['Material','MaterialDescription','ProductType'],['Material','MaterialDescription','ProductType'],'RefMaterial')" showSuggestion="true" suggest="handleSuggest" suggestionRows="{ path: '/ZC_ProductVH', length: 40 }" width="15rem" maxLength="40">
                        <suggestionColumns>
                            <Column>
                                <Label text="{i18n>Material1}"/>
                            </Column>
                            <Column>
                                <Label text="{i18n>MaterialDescription1}"/>
                            </Column>
                            <Column>
                                <Label text="{i18n>ProductType}"/>
                            </Column>
                        </suggestionColumns>
                        <suggestionRows>
                            <ColumnListItem>
                                <Label text="{Material}" />
                                <Label text="{MaterialDescription}" />
                            </ColumnListItem>
                        </suggestionRows>
                    </Input>
                </VBox>
                <VBox class="sapUiTinyMargin" width="33%">
                    <Label text="{i18n>Batch}" class="sapUiSmallMarginEnd"/>
                    <Input value="{local>/ItemEdit/Batch}" editable="{= ${local>/ItemEdit/Move1PostStatus} === ''}" change="handler.handleChange" showValueHelp="true" valueHelpRequest="handler.onValueHelpRequested(
                                $event, $controller, '/I_BatchStdVH',
                                ['Batch','Plant','Material'],['Batch','Plant','Material'],'Batch')" showSuggestion="true" suggest="handleSuggest" suggestionRows="{ path: '/I_BatchStdVH', length: 10 }" width="15rem" maxLength="10">
                        <suggestionColumns>
                            <Column>
                                <Label text="{i18n>Plant}"/>
                            </Column>
                            <Column>
                                <Label text="{i18n>Material1}"/>
                            </Column>
                            <Column>
                                <Label text="{i18n>Batch}"/>
                            </Column>
                        </suggestionColumns>
                        <suggestionRows>
                            <ColumnListItem>
                                <Label text="{Plant}" />
                                <Label text="{Material}" />
                                <Label text="{Batch}" />
                            </ColumnListItem>
                        </suggestionRows>
                    </Input>
                </VBox>
            </HBox>
            <HBox>
                <VBox class="sapUiTinyMargin">
                    <Label text="{i18n>FGMaterial}" class="sapUiSmallMarginEnd"/>
                    <Input value="{local>/ItemEdit/FGMaterial}" editable="{= ${local>/ItemEdit/Move1PostStatus} === ''}" change="handler.handleChange" showValueHelp="true" valueHelpRequest="handler.onValueHelpRequested(
                                $event, $controller, '/ZC_ProductVH',
                                ['Material','MaterialDescription','ProductType'],['Material','MaterialDescription','ProductType'],'FGMaterial')" showSuggestion="true" suggest="handleSuggest" suggestionRows="{ path: '/ZC_ProductVH', length: 40 }" width="15rem" maxLength="40">
                        <suggestionColumns>
                            <Column>
                                <Label text="{i18n>Material1}"/>
                            </Column>
                            <Column>
                                <Label text="{i18n>MaterialDescription1}"/>
                            </Column>
                            <Column>
                                <Label text="{i18n>ProductType}"/>
                            </Column>
                        </suggestionColumns>
                        <suggestionRows>
                            <ColumnListItem>
                                <Label text="{Material}" />
                                <Label text="{MaterialDescription}" />
                            </ColumnListItem>
                        </suggestionRows>
                    </Input>
                </VBox>
            </HBox>
            <!-- ADD END BY XINLEI XU 2026/07/22 CN 需求 No.392 & No.394 -->
            <HBox renderType="Bare">
                <VBox class="sapUiTinyMarginBegin sapUiTinyMarginEnd" width="100%">
                    <Label text="{i18n>Symptom}" class="sapUiSmallMarginEnd"/>
                    <TextArea value="{local>/ItemEdit/Symptom}" editable="{= ${local>/ItemEdit/Move1PostStatus} === ''}" showExceededText="true" maxLength="100" width="100%" valueState="{= ${local>/ItemEdit/Symptom}.length > 100 ? 'Warning' : 'None' }"/>
                </VBox>
            </HBox>
            <HBox renderType="Bare">
                <VBox class="sapUiTinyMarginBegin sapUiTinyMarginEnd" width="100%">
                    <Label text="{i18n>RootCause}" class="sapUiSmallMarginEnd"/>
                    <TextArea value="{local>/ItemEdit/RootCause}" editable="{= ${local>/ItemEdit/Move1PostStatus} === ''}" showExceededText="true" maxLength="100" width="100%" valueState="{= ${local>/ItemEdit/RootCause}.length > 100 ? 'Warning' : 'None' }"/>
                </VBox>
            </HBox>
            <HBox renderType="Bare">
                <VBox class="sapUiTinyMarginBegin sapUiTinyMarginEnd" width="100%">
                    <Label text="{i18n>CounterMeasure}" class="sapUiSmallMarginEnd"/>
                    <TextArea value="{local>/ItemEdit/CounterMeasure}" editable="{= ${local>/ItemEdit/Move1PostStatus} === ''}" showExceededText="true" maxLength="100" width="100%" valueState="{= ${local>/ItemEdit/CounterMeasure}.length > 100 ? 'Warning' : 'None' }"/>
                </VBox>
            </HBox>
        </VBox>
    </Dialog>
</core:FragmentDefinition>