<core:FragmentDefinition xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:unified="sap.ui.unified"
    xmlns:layout="sap.ui.layout"
    xmlns:table="sap.ui.table"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:smartTable="sap.ui.comp.smarttable">
    <table:Table id="idNG_ItemTable" rows="{local>/NG_Item}" selectionMode="Single" rowMode="Interactive" class="sapUiSizeCompact">
        <table:extension>
            <OverflowToolbar>
                <ToolbarSpacer/>
                <Button icon="sap-icon://copy" type="Ghost" text="{i18n>CopyLine}" press="onNG_Item($event,'COPY')" enabled="{local>/Control/editable}"/>
                <Button icon="sap-icon://add" type="Ghost" text="{i18n>AddLine}" press="onNG_Item($event,'ADD')" enabled="{local>/Control/editable}"/>
                <Button icon="sap-icon://edit" type="Ghost" text="{i18n>EditLine}" press="onNG_Item($event,'EDIT')" enabled="{local>/Control/editable}"/>
                <Button icon="sap-icon://delete" type="Ghost" text="{i18n>DeleteLine}" press="onNG_Item($event,'DELETE')" enabled="{local>/Control/editable}"/>
            </OverflowToolbar>
        </table:extension>
        <table:columns>
            <table:Column width="8rem" label="{i18n>NG_ItemNo}">
                <table:template>
                    <Text text="{local>NG_ItemNo}" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>ProductionOrder}">
                <table:template>
                    <Text text="{local>ProductionOrder}" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>NG_Material}">
                <table:template>
                    <Text text="{local>Material}" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>NG_MaterialName}">
                <table:template>
                    <Text text="{local>MaterialName}" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>NG_WorkCenter}">
                <table:template>
                    <Text text="{local>WorkCenter} {local>WorkCenterText}" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>NG_Position}">
                <table:template>
                    <Text text="{local>NG_Position}" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>Factor}">
                <table:template>
                    <Text text="{local>Factor} {local>FactorText}" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>Quantity}" hAlign="End">
                <table:template>
                    <Text text="{local>Quantity} {local>BaseUnit}" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>Shift}">
                <table:template>
                    <Text text="{local>Shift}" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>FoundDate}">
                <table:template>
                    <Text text="{ 'path':'local>FoundDate', 'type':'sap.ui.model.type.Date' }" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>Customer}">
                <table:template>
                    <Text text="{local>Customer}" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>CustomerName}">
                <table:template>
                    <Text text="{local>CustomerName}" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>Symptom}">
                <table:template>
                    <Text text="{local>Symptom}" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>RootCause}">
                <table:template>
                    <Text text="{local>RootCause}" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>CounterMeasure}">
                <table:template>
                    <Text text="{local>CounterMeasure}" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>ItemCreatedBy}" visible="{= ${local>/Operation} !== 'Create'}">
                <table:template>
                    <Text text="{local>ItemCreatedBy}" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>ItemCreatedAt}" visible="{= ${local>/Operation} !== 'Create'}">
                <table:template>
                    <Text text="{local>ItemCreatedAt}" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>ItemLastChangedBy}" visible="{= ${local>/Operation} !== 'Create'}">
                <table:template>
                    <Text text="{local>ItemLastChangedBy}" wrapping="false"/>
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>ItemLastChangedAt}" visible="{= ${local>/Operation} !== 'Create'}">
                <table:template>
                    <Text text="{local>ItemLastChangedAt}" wrapping="false"/>
                </table:template>
            </table:Column>
        </table:columns>
    </table:Table>
</core:FragmentDefinition>