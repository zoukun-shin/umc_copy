            <OverflowToolbar design="Transparent">
                <ToolbarSpacer/>
            </OverflowToolbar>
        </smartTable:customToolbar>
        <table:Table id="idTable" selectionMode="None" rowMode="Auto" threshold="999999999">
            <table:Column width="8rem" label="{i18n>Plant}" sortProperty="Plant" filterProperty="Plant">
                <table:customData>
                    <core:CustomData key="p13nData" value='\{"columnKey":"Plant", "leadingProperty":"Plant"}'/>
                </table:customData>
                <table:template>
                    <Text text="{Plant}" wrapping="false" />
                </table:template>
            </table:Column>
            <table:Column width="8rem" label="{i18n>MRPResponsible}" sortProperty="MRPResponsible" filterProperty="MRPResponsible">
                <table:customData>
                    <core:CustomData key="p13nData" value='\{"columnKey":"MRPResponsible", "leadingProperty":"MRPResponsible"}'/>
                </table:customData>
                <table:template>
                    <Text text="{MRPResponsible}" wrapping="false" />
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>Customer}" sortProperty="Customer" filterProperty="Customer">
                <table:customData>
                    <core:CustomData key="p13nData" value='\{"columnKey":"Customer", "leadingProperty":"Customer"}'/>
                </table:customData>
                <table:template>
                    <Text text="{Customer}" wrapping="false" />
                </table:template>
            </table:Column>
            <table:Column width="20rem" label="{i18n>CustomerName}" sortProperty="CustomerName" filterProperty="CustomerName">
                <table:customData>
                    <core:CustomData key="p13nData" value='\{"columnKey":"CustomerName", "leadingProperty":"CustomerName"}'/>
                </table:customData>
                <table:template>
                    <Text text="{CustomerName}" wrapping="false" />
                </table:template>
            </table:Column>
            <table:Column width="15rem" label="{i18n>Material}" sortProperty="Material" filterProperty="Material">
                <table:customData>
                    <core:CustomData key="p13nData" value='\{"columnKey":"Material", "leadingProperty":"Material"}'/>
                </table:customData>
                <table:template>
                    <Text text="{Material}" wrapping="false" />
                </table:template>
            </table:Column>
            <table:Column width="18rem" label="{i18n>ProductType}" sortProperty="ProductType" filterProperty="ProductType">
                <table:customData>
                    <core:CustomData key="p13nData" value='\{"columnKey":"ProductType", "leadingProperty":"ProductType"}'/>
                </table:customData>
                <table:template>
                    <Text text="{ProductType}" wrapping="false" />
