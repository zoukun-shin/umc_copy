                </table:customData>
                <table:template>
                    <Text text="{OrderType}" wrapping="false" />
                </table:template>
            </table:Column>
            <table:Column width="13rem" label="{i18n>MRPElementOpenQuantity}" sortProperty="MRPElementOpenQuantity" filterProperty="MRPElementOpenQuantity" hAlign="End">
                <table:customData>
                    <core:CustomData key="p13nData" value='\{"columnKey":"MRPElementOpenQuantity", "leadingProperty":"MRPElementOpenQuantity"}'/>
                </table:customData>
                <table:template>
                        <Text text="{path:'MRPElementOpenQuantity', formatter:'.formatter.formatNumber'}" wrapping="false" />
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>StartDate}" sortProperty="StartDate" filterProperty="StartDate">
                <table:customData>
                    <core:CustomData key="p13nData" value='\{"columnKey":"StartDate", "leadingProperty":"StartDate"}'/>
                </table:customData>
                <table:template>
                    <Text text="{path:'StartDate', type:'sap.ui.model.type.Date', formatOptions:{pattern:'yyyy/MM/dd'}}" wrapping="false" />
                </table:template>
            </table:Column>
            <table:Column width="10rem" label="{i18n>EndDate}" sortProperty="EndDate" filterProperty="EndDate">
                <table:customData>
                    <core:CustomData key="p13nData" value='\{"columnKey":"EndDate", "leadingProperty":"EndDate"}'/>
