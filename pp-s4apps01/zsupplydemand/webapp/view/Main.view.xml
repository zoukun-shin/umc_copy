<mvc:View controllerName="pp.zsupplydemand.controller.Main" displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:sv="sap.ui.comp.smartvariants"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:table="sap.ui.table">
    <f:DynamicPage headerExpanded="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <sv:SmartVariantManagement id="__SVM01" persistencyKey="SupplyDemandSVM" showShare="true" showExecuteOnSelection="true" entitySet="SupplyDemand"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <f:content>
                    <FlexBox fitContainer="true">
                        <smartFilterBar:SmartFilterBar id="idSmartFilterBar" entitySet="SupplyDemand" useToolbar="false" smartVariant="__SVM01" persistencyKey="StandardListSFB" initialized="onSmartFilterBarInitialized">
                            <smartFilterBar:controlConfiguration>
                                <smartFilterBar:ControlConfiguration index='10' key="Plant" mandatory="mandatory" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>Plant}"/>
                                <smartFilterBar:ControlConfiguration index='20' key="MRPResponsible" mandatory="mandatory" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>MRPResponsible}"/>
                                <smartFilterBar:ControlConfiguration index='30' key="Customer" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>Customer}"/>
                                <smartFilterBar:ControlConfiguration index='40' key="Material" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>Material}"/>
                                <smartFilterBar:ControlConfiguration index='50' key="ProductType" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>ProductType}"/>
                                <smartFilterBar:ControlConfiguration index='60' key="OrderNumber" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>OrderNumber}"/>
                                <smartFilterBar:ControlConfiguration index='70' key="ExceptionMessageNumber" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>ExceptionMessageNumber}"/>
                                <smartFilterBar:ControlConfiguration index='80' key="ProcessingType" mandatory="mandatory" filterType="single" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>ProcessingType}"/>
                                <!-- visible -->
                                <smartFilterBar:ControlConfiguration index='999' key="StartDate" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="EndDate" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="CustomerName" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="OrderType" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="MRPElementOpenQuantity" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="CurrentAvailableQuantity" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="FinalAvailableQuantity" visible="false"/>
                            </smartFilterBar:controlConfiguration>
                        </smartFilterBar:SmartFilterBar>
                    </FlexBox>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <FlexBox fitContainer="true">
                <core:Fragment fragmentName="pp.zsupplydemand.fragments.SupplyDemand" type="XML"/>
            </FlexBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
