                                <smartFilterBar:customControl>
                                    <DatePicker
                                        id="idDatePickerValidFromDate"
                                        valueFormat="yyyy/MM/dd"
                                        displayFormat="yyyy/MM/dd"
                                        change="onDatePickerChange"
                                    />
                                </smartFilterBar:customControl>
                            </smartFilterBar:ControlConfiguration>
                            <smartFilterBar:ControlConfiguration key="ChangeNumberStatusT" visibleInAdvancedArea="true" label="{i18n>ChangeNumberStatusT}" mandatory="notMandatory" index="9" />
