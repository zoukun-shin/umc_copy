<mvc:View controllerName="pp.zmodelpoint.controller.Main" displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:sv="sap.ui.comp.smartvariants"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:table="sap.ui.table">
    <f:DynamicPage headerExpanded="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <sv:SmartVariantManagement id="__SVM01" persistencyKey="ModelPointSVM" showShare="true" showExecuteOnSelection="true" entitySet=""/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <f:content>
                    <FlexBox fitContainer="true">
                        <smartFilterBar:SmartFilterBar id="idSmartFilterBar" entitySet="ModelPoint" useToolbar="false" smartVariant="__SVM01" persistencyKey="StandardListSFB" initialized="onsMrilterBarInitialized">
                            <smartFilterBar:controlConfiguration>
                                <smartFilterBar:ControlConfiguration index='10' key="Plant" mandatory="mandatory" filterType="single" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>Plant}"/>
                                <smartFilterBar:ControlConfiguration index='20' key="Material" mandatory="mandatory" displayBehaviour="idAndDescription"  visibleInAdvancedArea="true" label="{i18n>Material}"/>
                                <smartFilterBar:ControlConfiguration index='30' key="MRPController" filterType="single" displayBehaviour="idAndDescription" visibleInAdvancedArea="true" label="{i18n>MRPController}"/>
                                <!-- visible -->
                                <smartFilterBar:ControlConfiguration index='999' key="ItemNo" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="FinishedGoods" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="SemiFinishedGoods" visible="false"/>
                                <smartFilterBar:ControlConfiguration index='999' key="Point" visible="false"/>
                            </smartFilterBar:controlConfiguration>
                        </smartFilterBar:SmartFilterBar>
                    </FlexBox>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <FlexBox fitContainer="true">
                <core:Fragment fragmentName="pp.zmodelpoint.fragments.ModelPoint" type="XML"/>
            </FlexBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
