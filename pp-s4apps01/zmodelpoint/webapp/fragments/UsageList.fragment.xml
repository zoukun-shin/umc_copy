<core:FragmentDefinition xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:unified="sap.ui.unified"
    xmlns:layout="sap.ui.layout"
    xmlns:table="sap.ui.table"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:smartTable="sap.ui.comp.smarttable">
    <smartTable:SmartTable entitySet="ModelPoint" smartFilterId="idSmartFilterBar" tableType="Table" width="100%" 
        showRowCount="true" useVariantManagement="false" useTablePersonalisation="true" 
        persistencyKey="StandardListST" header="{i18n>Results}" enableAutoBinding="false" 
        placeToolbarInTable="true" beforeRebindTable="onBeforeRebindTable" 
        beforeExport="onBeforeExport" showFullScreenButton="true" ignoredFields="Material,MRPController">
        <smartTable:customToolbar>
            <OverflowToolbar design="Transparent">
                <ToolbarSpacer/>
            </OverflowToolbar>
        </smartTable:customToolbar>
       <table:Table id="idTable" selectionMode="None" rowMode="Auto">
            <table:columns>
                <table:Column width="6rem" label="{i18n>ItemNo}" sortProperty="ItemNo" filterProperty="ItemNo" hAlign="End">
                    <table:customData>
                        <core:CustomData key="p13nData" value='\{"columnKey":"ItemNo", "leadingProperty":"ItemNo"}'/>
                    </table:customData>
                    <table:template>
                        <Text text="{ItemNo}" />
                    </table:template>
                </table:Column>
                <table:Column width="6rem" label="{i18n>Plant}" sortProperty="Plant" filterProperty="Plant">
                    <table:customData>
                        <core:CustomData key="p13nData" value='\{"columnKey":"Plant", "leadingProperty":"Plant"}'/>
                    </table:customData>
                    <table:template>
                        <Text text="{Plant}" />
                    </table:template>
                </table:Column>
                <table:Column width="15rem" label="{i18n>FinishedGoods}" sortProperty="FinishedGoods" filterProperty="FinishedGoods">
                    <table:customData>
                        <core:CustomData key="p13nData" value='\{"columnKey":"FinishedGoods", "leadingProperty":"FinishedGoods"}'/>
                    </table:customData>
                    <table:template>
                        <Text text="{FinishedGoods}" wrapping="false" />
                    </table:template>
                </table:Column>
                <table:Column width="15rem" label="{i18n>SemiFinishedGoods}" sortProperty="SemiFinishedGoods" filterProperty="SemiFinishedGoods">
                    <table:customData>
                        <core:CustomData key="p13nData" value='\{"columnKey":"SemiFinishedGoods", "leadingProperty":"SemiFinishedGoods"}'/>
                    </table:customData>
                    <table:template>
                        <Text text="{SemiFinishedGoods}" wrapping="false" />
                    </table:template>
                </table:Column>
                <table:Column width="6rem" label="{i18n>Point}" sortProperty="Point" filterProperty="Point" hAlign="End">
                    <table:customData>
                        <core:CustomData key="p13nData" value='\{"columnKey":"Point", "leadingProperty":"Point"}'/>
                    </table:customData>
                    <table:template>
                        <Text text="{Point}" wrapping="false" />
                    </table:template>
                </table:Column>
            </table:columns>
        </table:Table>
    </smartTable:SmartTable>
</core:FragmentDefinition>